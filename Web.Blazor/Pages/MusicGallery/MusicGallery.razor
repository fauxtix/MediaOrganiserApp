    .carousel:before, .carousel:after {
        content: "";
        position: absolute;
    }

    .carousel:before {
        bottom: 12px;
        box-shadow: 0 16px 3px rgba(0, 0, 0, 0.05);
        height: 20%;
        left: 4px;
        transform: rotate(-2deg) skew(-2deg);
        width: 47%;
        z-index: -1;
    }

    .carousel:before, .carousel:after {
        content: "";
        position: absolute;
    }

    .carousel:after {
        bottom: 12px;
        box-shadow: 0 16px 3px rgba(0, 0, 0, 0.05);
        height: 20%;
        right: 4px;
        transform: rotate(2deg) skew(2deg);
        width: 47%;
        z-index: -1;
    }

    .carousel:before, .carousel:after {
        content: "";
        position: absolute;
    }

    .carousel:before, .carousel:after {
        content: "";
        position: absolute;
    }

    .carousel {
        background-color: var(--app-surface-alt);
        border: 10px solid var(--app-surface);
        border-radius: 0px;
        box-shadow: 0 0 4px rgba(0, 0, 0, 0.4);
        height: 300px;
        margin: 30px auto;
        position: relative;
        width: 450px;
    }

        .carousel a img {
            display: block;
            width: 450px;
            height: 300px;
            transform: rotate(-3deg);
            box-shadow: 0px 0 4px rgba(0, 0, 0, 0.4);
            background-color: var(--app-surface-alt);
            border: 10px solid var(--app-surface);
            position: relative;
            top: -15px;
            left: -10px;
        }

            .carousel a img:hover {
                opacity: 1;
                cursor: pointer;
            }

    /*-- Images Hover Effects CSS --*/
    .img-box {
        position: relative;
        transition: .5s;
        max-height: 230px;
        overflow: hidden;
        margin-bottom: 30px;
        border-radius: 0px 100px;
    }

        .img-box img {
            max-width: 100%;
            border: 3px solid var(--app-accent-yellow);
            position: relative;
            width: 100%;
        }

        .img-box::before {
            content: '';
            border-left: 3px solid var(--app-surface);
            border-top: 3px solid var(--app-surface);
            position: absolute;
            left: 20px;
            top: 20px;
            width: 50px;
            height: 50px;
            z-index: 1;
            transition: .5s;
        }

        .img-box::after {
            content: '';
            border-right: 3px solid var(--app-surface);
            border-bottom: 3px solid var(--app-surface);
            position: absolute;
            right: 20px;
            bottom: 20px;
            width: 50px;
            height: 50px;
            z-index: 2;
            transition: .5s;
        }

        .img-box:hover {
            transform: scale(1.04);
        }

            .img-box:hover::before {
                left: 10px;
                top: 10px;
            }

            .img-box:hover::after {
                right: 10px;
                bottom: 10px;
            }

    .small-text {
        font-size: 0.8rem;
    }
</style>
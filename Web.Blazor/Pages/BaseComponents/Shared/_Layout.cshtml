@using Microsoft.AspNetCore.Hosting
@using Microsoft.AspNetCore.Mvc.ViewEngines
@inject IWebHostEnvironment Environment
@inject ICompositeViewEngine Engine
<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Publications</title>
    <link rel="stylesheet" href="~/Identity/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/Identity/css/site.css" />
    <link rel="stylesheet" href="~/css/theme-tokens.css" />
    <style>
        body {
            background-color: var(--app-bg) !important;
            color: var(--app-text-primary);
        }

        .card {
            background-color: var(--app-surface);
            border-color: var(--app-border);
            color: var(--app-text-primary);
            box-shadow: var(--app-shadow);
        }

        .card-header,
        .card-footer {
            background-color: var(--app-surface-alt);
            border-color: var(--app-border);
            color: var(--app-text-primary);
        }

        .form-control {
            background-color: var(--app-surface);
            border-color: var(--app-border);
            color: var(--app-text-primary);
        }

        .form-control:focus {
            border-color: var(--app-primary);
            color: var(--app-text-primary);
            background-color: var(--app-surface);
        }

        .footer {
            background-color: var(--app-surface) !important;
            border-top-color: var(--app-border) !important;
            color: var(--app-text-secondary) !important;
        }

        .footer a {
            color: var(--app-primary);
        }
    </style>
    <script>
        (function () {
            function getTheme() { var t = null; try { t = localStorage.getItem('theme'); } catch (e) { } return t === 'dark' ? 'dark' : 'light'; }
            var initial = getTheme();
            document.documentElement.setAttribute('data-theme', initial);
            window.toggleLoginTheme = function () {
                var next = initial === 'dark' ? 'light' : 'dark';
                initial = next;
                try { localStorage.setItem('theme', next); } catch (e) { }
                document.documentElement.setAttribute('data-theme', next);
                document.body.classList.toggle('dark-theme', next === 'dark');
            };
        })();
    </script>
</head>
<body>
    <script>
        (function () {
            try { document.body.classList.toggle('dark-theme', document.documentElement.getAttribute('data-theme') === 'dark'); } catch (e) { }
        })();
    </script>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="footer border-top text-muted">
        <div class="container">
            Copyright © 2026 - Fausto Luís - <a asp-area="" asp-page="Privacy">Privacidade</a>
            <span class="float-right"><button type="button" class="btn btn-link btn-sm p-0" onclick="toggleLoginTheme()">Alternar tema</button></span>
        </div>
    </footer>
    <script src="~/Identity/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/Identity/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Identity/js/site.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>

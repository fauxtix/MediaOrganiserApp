@using MediaOrganizerApp.Application.DTOs.AI
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<App> L 

<SfDialog Visible="Visible" Width="900px" IsModal="true" ShowCloseIcon="false">
    <DialogTemplates>
        <Header>
            <div class="d-flex justify-content-between align-items-center w-100">
                <h5 class="m-0">@Title</h5>
            </div>
        </Header>
        <Content>
            <div class="translate-panel card p-3">
                <div class="row">
                    <div class="col-md-6 mb-2">
                        <label class="form-label">@L["TituloIdiomaOrigem"]</label>
                        <SfDropDownList TValue="string" TItem="LanguageItem" @bind-Value="SourceLanguage"
                                        DataSource="languages" Placeholder="@L["TituloIdiomaOrigem"]"
                                        CssClass="mb-2" PopupHeight="220px">
                            <DropDownListFieldSettings Text="Text" Value="Value"></DropDownListFieldSettings>
                        </SfDropDownList>

                        <label class="form-label">@L["TituloTextoATraduzir"]</label>
                        <SfTextBox CssClass="w-100 translate-input" Multiline="true" Rows="8" @bind-Value="SourceTextNoHtml"></SfTextBox>

                        @* <label class="form-label mt-2">Source (no HTML)</label>
                        <SfTextBox CssClass="w-100 translate-input" Multiline="true" Rows="4" Value="@SourceTextNoHtml" Enabled="false"></SfTextBox> *@
                    </div>

                    <div class="col-md-6 mb-2">
                        <label class="form-label">@L["TituloIdiomaDestino"]</label>
                        <SfDropDownList TValue="string" TItem="LanguageItem" @bind-Value="TargetLanguage"
                                        DataSource="targetLanguages" Placeholder="@L["TituloIdiomaDestino"]"
                                        CssClass="mb-2" PopupHeight="220px">
                            <DropDownListFieldSettings Text="Text" Value="Value"></DropDownListFieldSettings>
                        </SfDropDownList>

                        <label class="form-label">@L["lblTranslatedText"]</label>
                        <SfTextBox CssClass="w-100 translate-output" Multiline="true" Rows="8" Value="@TranslatedText" Enabled="false"></SfTextBox>

                        <div class="mt-2 d-flex justify-content-between align-items-center">
                            <div>
                                @if (IsTranslating)
                                {
                                    <div class="d-flex align-items-center" style="gap:10px;">
                                        <div class="bouncing-dots">
                                            @L["TituloTraducao"]
                                            <span></span><span></span><span></span>
                                        </div>
                                        <SfButton CssClass="e-danger e-outline e-round-corner"
                                                  IconCss="fa fa-times"
                                                  Content="@L["btnCancelar"]"
                                                  @onclick="CancelTranslate"></SfButton>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(ProgressMessage))
                                    {
                                        <div class="translate-progress-message">@ProgressMessage</div>
                                    }
                                }
                                else
                                {
                                    @* Always available, including right after a cancel: the user may
                                       simply insist, and pressing it clears the cancelled note. *@
                                    <SfButton CssClass="e-success e-round-corner"
                                        IconCss="fa fa-language" IconPosition="IconPosition.Right"
                                              Disabled="!CanTranslate"
                                              @onclick="Translate">@L["TituloTraduzir"]</SfButton>
                                }
                                @* Provider/model lives under the button, never in the right slot:
                                   that slot is taken by the cancelled note or the confidence,
                                   and the model ids are long enough to overlap. While the
                                   translation runs the progress message already names the
                                   model, so the chip is hidden to avoid saying it twice. *@
                                @if (ShowModelChip)
                                {
                                    <div class="translate-model-chip"
                                         title="@ModelTooltip(ShownProvider, ShownModel, attempted: !HasResultModel)">
                                        <i class="@ProviderIcon(ShownProvider)" aria-hidden="true"></i>
                                        <span class="translate-model-label">@ProviderLabel(ShownProvider)</span>
                                        <span class="translate-model-name">@ModelLabel(ShownModel)</span>
                                    </div>
                                }
                            </div>
                            <div class="text-muted translate-side-meta">
                                @if (IsCancelled)
                                {
                                    <span class="translate-cancelled">
                                        <i class="fa fa-ban" aria-hidden="true"></i>
                                        <span>@L["TituloTraducaoCancelada"]</span>
                                    </span>
                                }
                                else if (Confidence.HasValue)
                                {
                                    @L["Confidence", Confidence.Value]
                                }
                            </div>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <div class="mt-2 d-flex align-items-start" role="alert" aria-live="assertive">
                        <div class="flex-grow-1 me-2" tabindex="-1">
                            <SfMessage Severity="MessageSeverity.Warning" ShowIcon="true" Variant="MessageVariant.Outlined" ShowCloseIcon="true">
                                @ErrorMessage
                            </SfMessage>
                        </div>
                        <div>
                            <SfButton CssClass="e-outline e-round-corner" IconCss="fa fa-times" Content="@L["btnFechar"]" @onclick="ClearError"></SfButton>
                        </div>
                    </div>
                }
            </div>
        </Content>

        <FooterTemplate>
            <div class="d-flex justify-content-end" style="gap:8px">
                <SfButton CssClass="e-primary e-round-corner" Disabled="string.IsNullOrWhiteSpace(TranslatedText) || IsTranslating" @onclick="ApplyTranslated">@L["TituloConfirmar"]</SfButton>
                <SfButton CssClass="e-outline e-round-corner" IconCss="fa fa-times" Content="@L["BtnSalir"]" @onclick="OnExit"></SfButton>
            </div>
        </FooterTemplate>
    </DialogTemplates>
    <DialogAnimationSettings Effect="DialogEffect.FadeZoom" Duration="700" />
    <DialogPositionData X="center" Y="bottom"></DialogPositionData>

</SfDialog>



<style>
    .translate-panel .translate-input,
    .translate-panel .translate-output {
        font-family: inherit;
        resize: vertical;
    }

    .translate-panel .translate-input {
        min-height: 160px;
    }

    .translate-panel .translate-output {
        min-height: 160px;
        background: var(--app-surface-alt);
    }

    .translate-panel .form-label {
        font-weight: 600;
    }

    /* Bouncing dots – thinking indicator */
    .bouncing-dots {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        height: 24px;
    }

        .bouncing-dots span {
            display: inline-block;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: var(--app-primary);
            animation: bounce-dot 1.2s ease-in-out infinite;
        }

            .bouncing-dots span:nth-child(2) {
                animation-delay: 0.2s;
            }

            .bouncing-dots span:nth-child(3) {
                animation-delay: 0.4s;
            }

    @@keyframes bounce-dot {
        0%, 80%, 100% {
            transform: translateY(0);
            opacity: 0.4;
        }

        40% {
            transform: translateY(-8px);
            opacity: 1;
        }
    }

    /* Shown on the right after the user cancels: static, no animation, and the "Translate"
       button stays available on the left so the user can insist (which clears the note).
       White-space: nowrap keeps the note on a single line next to the button. */
    .translate-cancelled {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.9rem;
        color: var(--app-text-secondary);
        white-space: nowrap;
    }

    /* Right slot of the button row: the confidence (and the cancelled note) used to be
       centred in the row, which dropped it right on top of the model chip underneath.
       Pinned to the top of the row and centred against the button's own line instead
       (SfButton normal = 32px: 22px line box + 2x4px padding + 2px border). */
    .translate-panel .translate-side-meta {
        align-self: flex-start;
        display: flex;
        align-items: center;
        min-height: 32px;
    }

    .translate-progress-message {
        font-size: 0.85rem;
        color: var(--app-text-secondary);
        margin-top: 0.25rem;
    }

    /* Provider + model that answered, under the Translate button. Model ids are long, so the
       name is truncated and the full id lives in the title tooltip. */
    .translate-panel .translate-model-chip,
    .translate-panel .translate-model-label {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        font-size: 0.85rem;
        color: var(--app-text-secondary);
        white-space: nowrap;
    }

    .translate-panel .translate-model-chip {
        display: flex;
        max-width: 100%;
        margin-top: 0.35rem;
        padding: 0.15rem 0.45rem;
        border: 1px solid var(--app-info-border);
        border-radius: 0.75rem;
        background: var(--app-info-bg);
        color: var(--app-info-text);
    }

    .translate-panel .translate-model-name {
        max-width: 16rem;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
    }

</style>

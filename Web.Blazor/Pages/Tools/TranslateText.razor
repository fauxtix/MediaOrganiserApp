@using MediaOrganizerApp.Application.DTOs.AI
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<App> L 

<SfDialog Visible="Visible" Width="900px" IsModal="true" ShowCloseIcon="false">
    <DialogTemplates>
        <Header>
            <div class="d-flex justify-content-between align-items-center w-100">
                <h5 class="m-0">@Title</h5>
            </div>
        </Header>
        <Content>
            <div class="translate-panel card p-3">
                <div class="row">
                    <div class="col-md-6 mb-2">
                        <label class="form-label">@L["TituloIdiomaOrigem"]</label>
                        <SfDropDownList TValue="string" TItem="LanguageItem" @bind-Value="SourceLanguage"
                                        DataSource="languages" Placeholder="@L["TituloIdiomaOrigem"]"
                                        CssClass="mb-2" PopupHeight="220px">
                            <DropDownListFieldSettings Text="Text" Value="Value"></DropDownListFieldSettings>
                        </SfDropDownList>

                        <label class="form-label">@L["TituloTextoATraduzir"]</label>
                        <SfTextBox CssClass="w-100 translate-input" Multiline="true" Rows="8" @bind-Value="SourceTextNoHtml"></SfTextBox>

                        @* <label class="form-label mt-2">Source (no HTML)</label>
                        <SfTextBox CssClass="w-100 translate-input" Multiline="true" Rows="4" Value="@SourceTextNoHtml" Enabled="false"></SfTextBox> *@
                    </div>

                    <div class="col-md-6 mb-2">
                        <label class="form-label">@L["TituloIdiomaDestino"]</label>
                        <SfDropDownList TValue="string" TItem="LanguageItem" @bind-Value="TargetLanguage"
                                        DataSource="targetLanguages" Placeholder="@L["TituloIdiomaDestino"]"
                                        CssClass="mb-2" PopupHeight="220px">
                            <DropDownListFieldSettings Text="Text" Value="Value"></DropDownListFieldSettings>
                        </SfDropDownList>

                        <label class="form-label">@L["lblTranslatedText"]</label>
                        <SfTextBox CssClass="w-100 translate-output" Multiline="true" Rows="8" Value="@TranslatedText" Enabled="false"></SfTextBox>

                        <div class="mt-2 d-flex justify-content-between align-items-center">
                            <div>
                                @if (IsTranslating)
                                {
                                    <div class="translate-progress-wrap">
                                        <div class="bouncing-dots">
                                            @L["TituloTraducao"]
                                            <span></span><span></span><span></span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(ProgressMessage))
                                        {
                                            <div class="translate-progress-message">@ProgressMessage</div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <SfButton CssClass="e-success e-round-corner"
                                        IconCss="fa fa-language" IconPosition="IconPosition.Right"
                                              Disabled="!CanTranslate"
                                              @onclick="Translate">@L["TituloTraduzir"]</SfButton>
                                }
                            </div>
                            <div class="text-muted">@((Confidence.HasValue) ? L["Confidence", Confidence.Value] : string.Empty)</div>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(ErrorMessage))
                {
                    <div class="mt-2 d-flex align-items-start" role="alert" aria-live="assertive">
                        <div class="flex-grow-1 me-2" tabindex="-1">
                            <SfMessage Severity="MessageSeverity.Warning" ShowIcon="true" Variant="MessageVariant.Outlined" ShowCloseIcon="true">
                                @ErrorMessage
                            </SfMessage>
                        </div>
                        <div>
                            <SfButton CssClass="e-outline e-round-corner" IconCss="fa fa-times" Content="@L["btnFechar"]" @onclick="ClearError"></SfButton>
                        </div>
                    </div>
                }
            </div>
        </Content>

        <FooterTemplate>
            <div class="d-flex justify-content-end" style="gap:8px">
                <SfButton CssClass="e-primary e-round-corner" Disabled="string.IsNullOrWhiteSpace(TranslatedText) || IsTranslating" @onclick="ApplyTranslated">@L["TituloConfirmar"]</SfButton>
                <SfButton CssClass="e-outline e-round-corner" IconCss="fa fa-times" Content="@L["BtnSalir"]" @onclick="OnExit"></SfButton>
            </div>
        </FooterTemplate>
    </DialogTemplates>
    <DialogAnimationSettings Effect="DialogEffect.FadeZoom" Duration="700" />
    <DialogPositionData X="center" Y="bottom"></DialogPositionData>

</SfDialog>



<style>
    .translate-panel .translate-input,
    .translate-panel .translate-output {
        font-family: inherit;
        resize: vertical;
    }

    .translate-panel .translate-input {
        min-height: 160px;
    }

    .translate-panel .translate-output {
        min-height: 160px;
        background: var(--app-surface-alt);
    }

    .translate-panel .form-label {
        font-weight: 600;
    }

    /* Bouncing dots – thinking indicator */
    .bouncing-dots {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        height: 24px;
    }

        .bouncing-dots span {
            display: inline-block;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: var(--app-primary);
            animation: bounce-dot 1.2s ease-in-out infinite;
        }

            .bouncing-dots span:nth-child(2) {
                animation-delay: 0.2s;
            }

            .bouncing-dots span:nth-child(3) {
                animation-delay: 0.4s;
            }

    @@keyframes bounce-dot {
        0%, 80%, 100% {
            transform: translateY(0);
            opacity: 0.4;
        }

        40% {
            transform: translateY(-8px);
            opacity: 1;
        }
    }

    .translate-progress-wrap {
        display: inline-flex;
        flex-direction: column;
        align-items: flex-start;
    }

    .translate-progress-message {
        font-size: 0.85rem;
        color: var(--app-text-secondary);
        margin-top: 0.25rem;
    }

</style>

@code {
    protected IEnumerable<ImageCategoryLocations> ImagePaths;

    [Inject]
    public IPublicacaoService publicacoesService { get; set; }
    [Inject]
    public ICategoriasService categoriasService { get; set; }
    [Inject]
    public IStringLocalizer<App> localizerApp { get; set; }
    [Inject]
    public IFileService fileService { get; set; }
    [Inject]
    IWebHostEnvironment hostingEnvironment { get; set; }

    [Parameter]
    public int Categoria { get; set; } = 12;

    protected SfSpinner SpinnerObj;

    public PubsWithDescriptions SelectedRecord { get; set; } = new();

    protected int CatId { get; set; }
    protected bool CategoryWithImages = true;

    private IEnumerable<CategoryVM> categoryList;

    protected bool ViewDialogVisibility { get; set; } = false;
    protected bool ErrorDialogVisibility { get; set; } = false;
    protected string ErrorMessage { get; set; } = "";

    public string PdfFilePath { get; set; }

    public DialogEffect Effects = DialogEffect.FadeZoom;

    public bool NoDataVisibility { get; set; } = false;
    protected bool allCategories;

    private List<IGrouping<string, ImageCategoryLocations>> imageCategoryGroups;

    protected int[] ExpandItems = new int[] { 0 };

    protected string PubsFilesCount { get; set; } = "";

    protected override async Task OnInitializedAsync()
    {
        allCategories = false;
        NoDataVisibility = false;

        await GetCategoriesAsync();

        if (categoryList is not null)
        {
            var mediaCategoryList = categoryList.ToList();
            //mediaCategoryList.Insert(0, new CategoryVM { Id = 0, Descricao = localizerApp["msgAll"] });
            categoryList = mediaCategoryList;
            CatId = categoryList.Select(p => p.Id).FirstOrDefault();
            await GetImagesAsync();
        }
        else
        {
            NoDataVisibility = true;
        }
    }

    private async Task ShowPubDetail(int id)
    {
        if (id > 0)
        {
            SelectedRecord = await publicacoesService.GetByIdAsync_Extended(id);
            ViewDialogVisibility = true;
        }
    }

    private async Task onChangeCategory(Syncfusion.Blazor.DropDowns.ChangeEventArgs<int, CategoryVM> args)
    {
        if (!allCategories)
        {
            CatId = args.Value;
            await GetImagesAsync();
            StateHasChanged();
        }
    }

    private async Task GetImagesAsync()
    {
        try
        {
            await Task.Delay(100);
            await SpinnerObj.ShowAsync();
            ImagePaths = await publicacoesService.GetImageLocations(CatId);
            await SpinnerObj.HideAsync();

            if (ImagePaths is null)
            {
                ErrorDialogVisibility = true;
                ErrorMessage = "Sem imagens para mostrar. Verifique, p.f.";
            }
            //CategoryWithImages = true;
            PubsFilesCount = $"{ImagePaths.Count()} {localizerApp["Files"]}";

        }
        catch
        {
            // No results
            ImagePaths = null;
            ErrorDialogVisibility = true;
            ErrorMessage = "Sem imagens para mostrar. Verifique, p.f.";

            //CategoryWithImages = false;
        }
    }

    private async void onAllCategories(Microsoft.AspNetCore.Components.ChangeEventArgs args)
    {
        allCategories = (bool)args.Value == true;
        if (allCategories)
        {
            CatId = 0;
            await GetImagesAsync();
            imageCategoryGroups = ImagePaths.GroupBy(img => img.Categoria).ToList();
            imageCategoryGroups = imageCategoryGroups.OrderBy(p => p.Key).ToList();
        }
        else
        {
            CatId = categoryList.Select(p => p.Id).FirstOrDefault();
            await GetImagesAsync();
        }
        StateHasChanged();
    }
    private async Task GetCategoriesAsync()
    {
        await Task.Delay(100);
        await SpinnerObj.ShowAsync();

        try
        {
            categoryList = await categoriasService.GetCategoriesWithPublications();

            if (categoryList is null)
            {
                NoDataVisibility = true;
                ErrorDialogVisibility = true;
                ErrorMessage = "Sem videos para mostrar. Verifique, p.f.";
            }
            else
            {
                if (CatId == 0)
                {
                    categoryList = categoryList.OrderBy(p => p.DescricaoTipoCategoria).ToList();
                }
            }

        }
        catch (Exception ex)
        {
            ErrorDialogVisibility = true;
            ErrorMessage = ex.Message;
        }
        finally
        {
            await SpinnerObj.HideAsync();
        }

    }

    private void CloseViewDialog()
    {
        ViewDialogVisibility = false;
    }
    private void CloseErrorDialog()
    {
        ErrorDialogVisibility = false;
    }
}


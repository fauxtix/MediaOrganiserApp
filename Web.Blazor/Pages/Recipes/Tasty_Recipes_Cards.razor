@page "/recipe_cards"

@using Web.Blazor.Services.Recipes

@inject ITastyApiRecipesService recipeService
@inject IJSRuntime JS

@inherits TastyBaseComponents.TastyBase

<div class="container">

    <div class="title">Tasty Recipes Gallery</div>
    <div class="underline"></div>
    <br />

    <div id="spinnerContainer"></div>
    <SfSpinner @ref="SpinnerObj"
               Label="@localizerApp["LoadingMsg"]"
               Type="@SpinnerType.Bootstrap4" Size="50"
               
               CssClass="e-spin-overlay">
    </SfSpinner>

    @if (cardList is null)
    {
        <div class="spinner-grow text-info"></div>
    }
    else
    {
        <div class="col-lg-12 control-section">
            <div class="content-wrapper">
                    @foreach (var card in cardList)
                    {
                        <div id="myCarousel" class="col-lg-3 col-md-4 col-6">
                            <a class="d-block mb-4 h-100">
                                <div class="img-box">
                                    <img class="img-fluid img-thumbnail"
                                         src="@card.UrlImagem"
                                         alt="">
                                </div>
                                <p class="small-text">@card.Titulo)</p>
                            </a>
                        </div>

                    }
            </div>
        </div>
    }
</div>

@code{
    Root recipes { get; set; }
    List<CardData> cardList { get; set; } = new();
    private string searchId;

    protected async override Task OnInitializedAsync()
    {
        tagsData = await GetTags_Data();
        tagsList = FillTagItems();

        foreach (var tag in tagsList)
        {
            searchId = tag.Id.ToString();
            recipes = await GetRecipes_Data(0);
            foreach (var recipe in recipes.results.ToList())
            {
                cardList.Add(new CardData()
                {
                    RecipeId = recipe.id,
                    Titulo = recipe.name,
                    TempoPreparacao = recipe.prep_time_minutes,
                    Doses = recipe.num_servings,
                    Calorias = recipe.nutrition.calories,
                    Carbonatos = recipe.nutrition.carbohydrates,
                    Acucares = recipe.nutrition.sugar,
                    UrlImagem = recipe.thumbnail_url
                });
            }
        }
    }

    public class CardData
    {
        public int RecipeId { get; set; }
        public string Titulo { get; set; }
        public int? TempoPreparacao { get; set; }
        public int? Doses { get; set; }
        public int? Calorias { get; set; }
        public int? Carbonatos { get; set; }
        public int? Acucares { get; set; }
        public string UrlImagem { get; set; }
    }
}

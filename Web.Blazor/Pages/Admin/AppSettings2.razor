@page "/admin/appsettings2"
@using Web.Blazor.Components
@using Syncfusion.Blazor.FileManager
@using Web.Blazor.Services.CloudChat

<PageTitle>@L["menu-admin-main"]</PageTitle>
<PageTitleComponent PageTitle="@L["menu-admin-main"]"></PageTitleComponent>
@if (settings is null || AiModels is null || !AiModels.Any())
{
    <LoadingData />
}
else
{
    <SfBreadcrumb>
        <BreadcrumbItems>
            <BreadcrumbItem Text="@L["Home"]" IconCss="e-icons e-home" Url="/" />
            <BreadcrumbItem Text="@L["TituloDefinicoes"]" Url="/admin/appsettings2" />
        </BreadcrumbItems>
    </SfBreadcrumb>
    <hr />

    <div class="container settings-shell">
        <EditForm Model="@settings">
            <div class="row">
                <div class="col-md-3 col-sm-12">
                    <aside class="settings-sidebar">
                        @foreach (var group in SettingsGroups)
                        {
                            var isExpanded = ExpandedGroups.Contains(group.Id);
                            <div class="settings-group">
                                <button type="button" class="settings-group-header @(isExpanded ? "expanded" : "")" @onclick="(() => ToggleGroup(group.Id))">
                                    <i class="fa @group.Icon settings-group-icon" aria-hidden="true"></i>
                                    <span class="settings-group-title">@L[group.ResxKey]</span>
                                    <i class="fa fa-chevron-down settings-group-chevron" aria-hidden="true"></i>
                                </button>
                                @if (isExpanded)
                                {
                                    <div class="settings-group-items">
                                        @foreach (var leaf in group.Leaves)
                                        {
                                            <button type="button"
                                                    class="settings-item @(SelectedNode == leaf.Id ? "active" : "")"
                                                    @onclick="(() => SelectNode(leaf.Id))">
                                                <i class="fa @leaf.Icon settings-item-icon" aria-hidden="true"></i>
                                                <span class="settings-item-label">@L[leaf.ResxKey]</span>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </aside>
                </div>
                <div class="col-md-9 col-sm-12">
                    <div class="settings-content">
                        @switch (SelectedNode)
                        {
                            case "downloads":
                                <div class="card-box settings-card">
                                    <h6 class="settings-card-title">@L["Downloads"]</h6>
                                    <div class="settings-field settings-field-folder">
                                        <SfTextBox CssClass="form-control" @bind-Value="settings.PastaDownloadsPdf" Placeholder="@L["PdfDownloads"]" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                                        <span class="settings-folder-btn" @onclick="(() => OpenFileManager(FileManagerOptions.PdfDownloads))"><i class="fa fa-folder-open"></i></span>
                                    </div>
                                    <div class="settings-field settings-field-folder">
                                        <SfTextBox CssClass="form-control" @bind-Value="settings.PastaDownloadsMedia" Placeholder="@L["TituloFormatoMedia"]" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                                        <span class="settings-folder-btn" @onclick="(() => OpenFileManager(FileManagerOptions.MediaDownloads))"><i class="fa fa-folder-open"></i></span>
                                    </div>
                                </div>
                                break;
                            case "backups":
                                <div class="card-box settings-card">
                                    <h6 class="settings-card-title">@L["TituloBackups"]</h6>
                                    <div class="settings-field settings-field-folder">
                                        <SfTextBox CssClass="form-control" @bind-Value="settings.PastaBackupBD" Placeholder="@L["btnManutBD"]" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                                        <span class="settings-folder-btn" @onclick="(() => OpenFileManager(FileManagerOptions.BackupBD))"><i class="fa fa-folder-open"></i></span>
                                    </div>
                                    <div class="settings-field settings-field-folder">
                                        <SfTextBox CssClass="form-control" @bind-Value="settings.PastaBackupUploads" Placeholder="@L["TituloUploadsPublicacoes"]" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                                        <span class="settings-folder-btn" @onclick="(() => OpenFileManager(FileManagerOptions.BackupUploads))"><i class="fa fa-folder-open"></i></span>
                                    </div>
                                </div>
                                break;
                            case "armazenamento":
                                <div class="card-box settings-card">
                                    <h6 class="settings-card-title">@L["TituloArmazenamento"]</h6>
                                    <div class="settings-field settings-field-folder">
                                        <SfTextBox CssClass="form-control" @bind-Value="settings.PastaPublicacoes" Placeholder="@L["mnuLivros"]" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                                        <span class="settings-folder-btn" @onclick="(() => OpenFileManager(FileManagerOptions.PublicationsFolder))"><i class="fa fa-folder-open"></i></span>
                                    </div>
                                    <div class="settings-field settings-field-folder">
                                        <SfTextBox CssClass="form-control" @bind-Value="settings.PastaListagens" Placeholder="@L["TituloListagens"]" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                                        <span class="settings-folder-btn" @onclick="(() => OpenFileManager(FileManagerOptions.ReportsFolder))"><i class="fa fa-folder-open"></i></span>
                                    </div>
                                </div>
                                break;
                            case "imagens":
                                <div class="card-box settings-card">
                                    <h6 class="settings-card-title">@L["lblImagens"]</h6>
                                    <div class="settings-field settings-field-folder">
                                        <SfTextBox CssClass="form-control" @bind-Value="settings.PastaImagens" Placeholder="@L["TituloAplicacao"]" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                                        <span class="settings-folder-btn" @onclick="(() => OpenFileManager(FileManagerOptions.ImagesFolder))"><i class="fa fa-folder-open"></i></span>
                                    </div>
                                    <div class="settings-field settings-field-folder">
                                        <SfTextBox CssClass="form-control" @bind-Value="settings.PastaImagensCapasLivros" Placeholder="@L["TituloImagensCapasLivros"]" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                                        <span class="settings-folder-btn" @onclick="(() => OpenFileManager(FileManagerOptions.BookImagesFolder))"><i class="fa fa-folder-open"></i></span>
                                    </div>
                                    <div class="settings-field settings-field-folder">
                                        <SfTextBox CssClass="form-control" @bind-Value="settings.PastaImagensAutores" Placeholder="@L["TituloImagensAutores"]" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                                        <span class="settings-folder-btn" @onclick="(() => OpenFileManager(FileManagerOptions.AuthorImagesFolder))"><i class="fa fa-folder-open"></i></span>
                                    </div>
                                </div>
                                break;
                            case "contactos":
                                <div class="card-box settings-card">
                                    <h6 class="settings-card-title">@L["TituloContactos"]</h6>
                                    <div class="settings-field">
                                        <SfTextBox CssClass="form-control" @bind-Value="settings.AuthorMobile" Placeholder="@L["lblAutor"]" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                                    </div>
                                    <div class="settings-field">
                                        <SfTextBox CssClass="form-control" @bind-Value="settings.SupportMail" Placeholder="@L["TituloEmailSuporte"]" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                                    </div>
                                </div>
                                break;
                            case "definicoes":
                                <div class="card-box settings-card">
                                    <h6 class="settings-card-title">@L["TituloOutrasDefinicoes"]</h6>
                                    <div class="settings-field">
                                        <SfNumericTextBox CssClass="form-control" @bind-Value="settings.TempoNotifier" Min="1" Max="5" Format="N0" Placeholder="@L["TituloNotificationTime"]" FloatLabelType="FloatLabelType.Always"></SfNumericTextBox>
                                    </div>
                                    <div class="settings-toggle-row">
                                        <span class="settings-toggle-label">@L["TituloFicheirosOrganizados"]</span>
                                        <SfSwitch CssClass="mt-1 p-2" @bind-Checked="settings.FicheirosOrganizados" OnLabel="On" OffLabel="Off"></SfSwitch>
                                    </div>
                                    <div class="settings-toggle-row">
                                        <span class="settings-toggle-label">@L["TituloRemoverImagemAposEdicao"]</span>
                                        <SfSwitch CssClass="mt-1 p-2" @bind-Checked="settings.RemoveImagemAposAlteracao" OnLabel="On" OffLabel="Off"></SfSwitch>
                                    </div>
                                </div>
                                break;
                            case "idioma":
                                <div class="card-box settings-card">
                                    <h6 class="settings-card-title">@L["TituloDefaultLanguage"]</h6>
                                    <SfDropDownList TValue="string" CssClass="template"
                                                    TItem="CountryModel"
                                                    Placeholder="@L["lblEscolhaLinguagem"]"
                                                    DataSource="@CountryData" Value="@selectedCulture">
                                        <DropDownListTemplates TItem="CountryModel">
                                            <ItemTemplate Context="langCtx">
                                                <div>
                                                    <img class="empImage" src="/images/@((langCtx as CountryModel).Pic).png" alt="pa�s" />
                                                    <div class="ename">@L[((langCtx as CountryModel).Text!)] </div>
                                                </div>
                                            </ItemTemplate>
                                            <ValueTemplate Context="ctx">
                                                <div class="dropdown-width" style="width:100%;height:100%;">
                                                    <img class="value" src="/images/@((ctx as CountryModel).Pic).png" height="26" width="26" alt="pa�s">
                                                    <div class="name">@L[((ctx as CountryModel).Text!)] </div>
                                                </div>
                                            </ValueTemplate>
                                        </DropDownListTemplates>
                                        <DropDownListFieldSettings Value="ID" Text="Text"></DropDownListFieldSettings>
                                        <DropDownListEvents TItem="CountryModel" TValue="string" ValueChange="OnSelected"></DropDownListEvents>
                                    </SfDropDownList>
                                </div>
                                break;
                            case "iaollama":
                                <div class="card-box settings-card">
                                    <h6 class="settings-card-title">@L["TituloIAOllama"]</h6>
                                    <div class="settings-field">
                                        <SfTextBox CssClass="form-control" @bind-Value="settings.ApiKey" Placeholder="@L["TituloChaveApi"]" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                                    </div>
                                    <div class="settings-field">
                                        <SfTextBox CssClass="form-control" @bind-Value="settings.ModelBaseUrl" Placeholder="@L["TituloModelBaseUrl"]" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                                    </div>
                                    <div class="settings-field">
                                        <SfDropDownList TItem="AIModelVM"
                                                        TValue="string"
                                                        DataSource="@AiModels"
                                                        @bind-Value="settings.AiModelName"
                                                        Placeholder="@L["TituloAIModelName"]">
                                            <DropDownListFieldSettings Text="Descricao" Value="Descricao" />
                                        </SfDropDownList>
                                    </div>
                                </div>
                                break;
                            case "webapi":
                                <div class="card-box settings-card">
                                    <h6 class="settings-card-title">@L["TituloWebApi"]</h6>
                                    <div class="settings-field">
                                        <SfTextBox CssClass="form-control" @bind-Value="settings.ApiBaseUrl_Production" Placeholder="@L["ApiBaseUrl_Production"]" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                                    </div>
                                    <div class="settings-field">
                                        <SfTextBox CssClass="form-control" @bind-Value="settings.ApiBaseUrl_Development" Placeholder="@L["ApiBaseUrl_Development"]" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                                    </div>
                                    <div class="settings-field">
                                        <SfTextBox CssClass="form-control" @bind-Value="settings.FileManagerApiBaseUrl_Production" Placeholder="@L["FileManagerApiBaseUrl_Production"]" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                                    </div>
                                    <div class="settings-field">
                                        <SfTextBox CssClass="form-control" @bind-Value="settings.FileManagerApiBaseUrl_Development" Placeholder="@L["FileManagerApiBaseUrl_Development"]" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                                    </div>
                                </div>
                                break;
                            case "servicos":
                                <div class="card-box settings-card">
                                    <h6 class="settings-card-title">@L["TituloServicos"]</h6>
                                    <div class="settings-field">
                                        <SfTextBox CssClass="form-control" @bind-Value="settings.LastFmApiKey" Placeholder="@L["LastFmApiKey"]" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                                    </div>
                                    <div class="settings-field">
                                        <SfTextBox CssClass="form-control" @bind-Value="settings.LastFmApiSecret" Placeholder="@L["LastFmApiSecret"]" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                                    </div>
                                    <div class="settings-field">
                                        <SfTextBox CssClass="form-control" @bind-Value="settings.GoogleBooksApiKey" Placeholder="@L["GoogleBooksApiKey"]" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                                    </div>
                                    <div class="settings-field">
                                        <SfTextBox CssClass="form-control" @bind-Value="settings.GoogleBooksCountry" Placeholder="@L["GoogleBooksCountry"]" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                                    </div>
                                    <div class="settings-field">
                                        <SfTextBox CssClass="form-control" @bind-Value="settings.IMDbKey" Placeholder="@L["IMDbKey"]" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                                    </div>
                                </div>
                                break;
                            case "basedados":
                                <div class="card-box settings-card">
                                    <h6 class="settings-card-title">@L["TituloBaseDados"]</h6>
                                    <div class="settings-field">
                                        <SfTextBox CssClass="form-control" @bind-Value="settings.Database_ConnectionString" Placeholder="@L["Database_ConnectionString"]" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                                    </div>
                                </div>
                                break;
                            case "iacomum":
                                <div class="card-box settings-card">
                                    <h6 class="settings-card-title">@L["TituloIAComum"]</h6>
                                    <div class="cloudchat-model-list mt-4 mx-3">
                                        <div class="form-label mt-2" style="color:var(--app-text-primary); font-size:small">@L["CloudChatEnableReasoning"]</div>
                                        <div><SfSwitch CssClass="mt-1 p-2" @bind-Checked="CloudChatEnableReasoning" OnLabel="On" OffLabel="Off"></SfSwitch></div>
                                        <div class="cloudchat-hint" style="color:var(--app-text-secondary); font-size:x-small">@L["CloudChatEnableReasoningHint"]</div>
                                    </div>
                                </div>
                                break;
                            case "iaopenrouter":
                                <div class="card-box settings-card">
                                    <h6 class="settings-card-title">@L["TituloIAOpenRouter"]</h6>
                                    <div class="row">
                                        <div class="col-md-6 col-sm-12">
                                            @if (CloudChatIsAdmin)
                                            {
                                                <SfTextBox CssClass="form-control mt-1"
                                                           @bind-Value="CloudChatApiKey"
                                                           Placeholder="@L["CloudChatApiKey"]"
                                                           HtmlAttributes="@(new Dictionary<string, object> { ["type"] = "password" })"
                                                           ShowClearButton="true"></SfTextBox>
                                                <div class="cloudchat-status @(CloudChatApiKeyStatus == "Configured" ? "cloudchat-ok" : "cloudchat-warn")">
                                                    @(CloudChatApiKeyStatus == "Configured" ? L["CloudChatApiKeyConfigured"] : L["CloudChatApiKeyMissing"])
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="cloudchat-status cloudchat-warn">@L["CloudChatAdminOnly"]</div>
                                            }
                                            <hr />
                                            <div class="cloudchat-model-list mt-4 mx-3">
                                                <div class="form-label mt-2" style="color:var(--app-text-primary); font-size:small">@L["CloudChatAllowPaidModels"]</div>
                                                <div><SfSwitch CssClass="mt-1 p-2" @bind-Checked="CloudChatAllowPaidModels" OnLabel="On" OffLabel="Off"></SfSwitch></div>
                                                <div class="form-label mt-2" style="color:var(--app-text-primary); font-size:small">@L["CloudChatAuthorBooksUseCloud"]</div>
                                                <div><SfSwitch CssClass="mt-1 p-2" @bind-Checked="CloudChatAuthorBooksUseCloud" OnLabel="On" OffLabel="Off"></SfSwitch></div>
                                                <div class="cloudchat-hint" style="color:var(--app-text-secondary); font-size:x-small">@L["CloudChatAuthorBooksUseCloudHint"]</div>
                                            </div>
                                        </div>
                                        <div class="col-md-6 col-sm-12">
                                            @if (CloudChatIsAdmin)
                                            {
                                                <div class="cloudchat-active">
                                                    <span class="cloudchat-active-label">@L["CloudChatActiveModelLabel"]</span>
                                                    <span class="cloudchat-active-id @(ModeloSelecionadoEhPago ? "paid" : "")">@CloudChatDefaultModel</span>
                                                    @if (ModeloSelecionadoEhPago)
                                                    {
                                                        <span class="cloudchat-model-badge paid">@L["CloudChatModelPaidBadge"]</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="cloudchat-model-badge free">@L["CloudChatModelFreeBadge"]</span>
                                                    }
                                                    @if (EhModeloRecomendado(CloudChatDefaultModel))
                                                    {
                                                        <span class="cloudchat-model-badge recommended">@L["CloudChatModelRecommendedBadge"]</span>
                                                    }
                                                </div>
                                                @if (AvisoModeloPagoSemChave)
                                                {
                                                    <div class="cloudchat-status cloudchat-warn">@AvisoModeloPagoMensagem</div>
                                                }
                                                <div class="cloudchat-search">
                                                    <input class="cloudchat-search-input"
                                                           @bind="CloudChatModelFilter"
                                                           @bind:event="oninput"
                                                           onkeydown="if(event.key==='Enter')event.preventDefault();"
                                                           placeholder="@L["CloudChatModelSearchPlaceholder"]" />
                                                </div>
                                                <div class="cloudchat-model-list">
                                                    @foreach (var modelo in OpenRouterModelsExibidos)
                                                    {
                                                        var selecionado = string.Equals(modelo.Id, CloudChatDefaultModel, StringComparison.OrdinalIgnoreCase);
                                                        <label class="cloudchat-model-row">
                                                            <input type="radio"
                                                                   name="cloudchat-default-model"
                                                                   value="@modelo.Id"
                                                                   checked="@selecionado"
                                                                   @onchange="() => SelectCloudChatModel(modelo.Id)" />
                                                            <span class="cloudchat-model-info">
                                                                <span class="cloudchat-model-name">@modelo.Nome</span>
                                                                <span class="cloudchat-model-id">@modelo.Id</span>
                                                            </span>
                                                            <span class="cloudchat-model-badges">
                                                                @if (modelo.EhRouter)
                                                                {
                                                                    <span class="cloudchat-model-badge router">@L["CloudChatModelRouterBadge"]</span>
                                                                }
                                                                else
                                                                {
                                                                    @if (modelo.ContextLength.HasValue)
                                                                    {
                                                                        <span class="cloudchat-model-badge">@($"~{FormatarContextoCloud(modelo.ContextLength.Value)}")</span>
                                                                    }
                                                                    @if (modelo.EhGratuito)
                                                                    {
                                                                        <span class="cloudchat-model-badge free">@L["CloudChatModelFreeBadge"]</span>
                                                                    }
                                                                    @if (EhModeloRecomendado(modelo.Id))
                                                                    {
                                                                        <span class="cloudchat-model-badge recommended">@L["CloudChatModelRecommendedBadge"]</span>
                                                                    }
                                                                }
                                                            </span>
                                                        </label>
                                                    }
                                                    @if (!OpenRouterModelsExibidos.Any())
                                                    {
                                                        <div class="cloudchat-model-empty">@L["CloudChatModelNoResults"]</div>
                                                    }
                                                </div>
                                                <div class="cloudchat-usage-grid mt-3">
                                                    <div class="cloudchat-card">
                                                        <h6 class="cloudchat-card-title">@L["CloudChatCreditsTitle"]</h6>
                                                        @if (CloudChatUsage is null)
                                                        {
                                                            <div class="cloudchat-status cloudchat-warn">@L["CloudChatUsageUnavailable"]</div>
                                                        }
                                                        else if (!CloudChatUsage.ChaveConfigurada)
                                                        {
                                                            <div class="cloudchat-status cloudchat-warn">@L["CloudChatApiKeyMissing"]</div>
                                                        }
                                                        else
                                                        {
                                                            @if (!string.IsNullOrWhiteSpace(CloudChatUsage.Erro))
                                                            {
                                                                <div class="cloudchat-status cloudchat-warn">@CloudChatUsage.Erro</div>
                                                            }
                                                            <div class="cloudchat-row">
                                                                <span class="cloudchat-row-label">@L["CloudChatBalanceLabel"]</span>
                                                                <span class="cloudchat-row-value">@CloudChatUsage.SaldoRestante?.ToString("0.##")</span>
                                                            </div>
                                                            <div class="cloudchat-row">
                                                                <span class="cloudchat-row-label">@L["CloudChatUsageTodayLabel"]</span>
                                                                <span class="cloudchat-row-value">@CloudChatUsage.UsoHoje?.ToString("0.##")</span>
                                                            </div>
                                                            <div class="cloudchat-row">
                                                                <span class="cloudchat-row-label">@L["CloudChatUsageWeekLabel"]</span>
                                                                <span class="cloudchat-row-value">@CloudChatUsage.UsoSemana?.ToString("0.##")</span>
                                                            </div>
                                                            <div class="cloudchat-row">
                                                                <span class="cloudchat-row-label">@L["CloudChatUsageMonthLabel"]</span>
                                                                <span class="cloudchat-row-value">@CloudChatUsage.UsoMes?.ToString("0.##")</span>
                                                            </div>
                                                            <div class="cloudchat-row">
                                                                <span class="cloudchat-row-label">@L["CloudChatKeyLimitLabel"]</span>
                                                                <span class="cloudchat-row-value">@CloudChatUsage.LimiteKey?.ToString("0.##")</span>
                                                            </div>
                                                            <div class="cloudchat-row">
                                                                <span class="cloudchat-row-label">@L["CloudChatKeyLimitRemainingLabel"]</span>
                                                                <span class="cloudchat-row-value">@CloudChatUsage.LimiteKeyRestante?.ToString("0.##")</span>
                                                            </div>
                                                            @if (!CloudChatUsage.PodeUsarModelosPagos)
                                                            {
                                                                <div class="cloudchat-status cloudchat-warn">@L["CloudChatPaidUnsupportedWarning"]</div>
                                                            }
                                                        }
                                                    </div>
                                                    <div class="cloudchat-card">
                                                        <h6 class="cloudchat-card-title">@L["CloudChatFreeUsageTitle"]</h6>
                                                        @if (CloudChatUsage is null)
                                                        {
                                                            <div class="cloudchat-status cloudchat-warn">@L["CloudChatUsageUnavailable"]</div>
                                                        }
                                                        else
                                                        {
                                                            <div class="cloudchat-row">
                                                                <span class="cloudchat-row-label">@L["CloudChatFreeUsedLabel"]</span>
                                                                <span class="cloudchat-row-value">@CloudChatUsage.UsadosGratisHoje / @CloudChatUsage.TetoDiario</span>
                                                            </div>
                                                            <div class="cloudchat-progress">
                                                                <div class="cloudchat-progress-fill @(CloudChatUsage.PercentagemUsada >= 80 ? "warn" : "")"
                                                                     style="width:@(Math.Min(100, CloudChatUsage.PercentagemUsada))%"></div>
                                                            </div>
                                                            <div class="cloudchat-row">
                                                                <span class="cloudchat-row-label">@L["CloudChatFreeResetLabel"]</span>
                                                                <span class="cloudchat-row-value">@CloudChatUsage.ResetUTC?.ToString("dd/MM HH:mm 'UTC'")</span>
                                                            </div>
                                                            <div class="cloudchat-row">
                                                                <span class="cloudchat-row-label">@L["CloudChatFreeCapModeLabel"]</span>
                                                                <span class="cloudchat-row-value">@(CloudChatUsage.TetoAutomatico ? L["CloudChatFreeCapAutomatic"] : L["CloudChatFreeCapCustom"])</span>
                                                            </div>
                                                            @if (CloudChatUsage.PercentagemUsada >= 80)
                                                            {
                                                                <div class="cloudchat-status cloudchat-warn">@L["CloudChatFreeNearLimitWarning"]</div>
                                                            }
                                                            <div class="form-label mt-2" style="color:var(--app-text-primary); font-size:small">@L["CloudChatFreeCapOverrideLabel"]</div>
                                                            <input class="form-control cloudchat-cap-input"
                                                                   type="number" min="0" step="1"
                                                                   @bind="CloudChatFreeDailyCap" />
                                                            <div class="cloudchat-hint">@L["CloudChatFreeCapOverrideHint"]</div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                                break;
                        }
                    </div>
                    <div class="d-flex justify-content-end align-items-md-center my-3">
                        <SfButton CssClass="e-btn e-primary e-round-corner pl-2 pr-3"
                                  IconCss="fa fa-save"
                                  Content="@L["btnSalvar"]"
                                  OnClick="UpdateSettings">
                        </SfButton>
                    </div>
                </div>
            </div>
        </EditForm>
    </div>
}


<SfDialog Width="50%"
          Height="auto"
          IsModal="true"
          EnableResize="true"
          AllowDragging="true"
          CloseOnEscape="true"
          ShowCloseIcon="false"
          @bind-Visible="IsFileManagerVisible">
    <DialogTemplates>
        <Header>
            <h5>@dialogTitle</h5>
        </Header>
        <Content>
            <SfFileManager TValue="FileManagerDirectoryContent"

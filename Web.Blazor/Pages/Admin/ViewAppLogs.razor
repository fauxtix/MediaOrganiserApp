@page "/admin/viewapplogs"
@using Web.Blazor.Components
@using Web.Blazor.Components.Logs
@using static MediaOrganizerApp.Application.Enums.AppDefinitions
@inject IConfiguration Configuration

@inherits ViewAppLogsBase
@{
    var Tool = (new List<object>() { "Search"});
}

<PageTitle>@L["LogViewer"]</PageTitle>
<PageTitleComponent PageTitle="@L["LogViewer"]" WithBadge="false"></PageTitleComponent>

@if (Logs is null)
{
    <LoadingData />
}
else
{
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
        <div class="d-flex align-items-center flex-wrap">
            <SfButton CssClass="e-info e-round-corner mx-3" IconCss="fa fa-info-circle" Content="@L["Information"]"
                      @onclick="@(() => OnFilterByLevel("infologs"))">
            </SfButton>
            <SfButton CssClass="e-warning e-round-corner mx-3" IconCss="fa fa-exclamation-triangle" Content="@L["Warning"]"
                      @onclick="@(() => OnFilterByLevel("warninglogs"))">
            </SfButton>
            <SfButton CssClass="e-danger e-round-corner mx-3" IconCss="fa fa-exclamation-circle" Content="@L["Error"]"
                      @onclick="@(() => OnFilterByLevel("errorlogs"))">
            </SfButton>
            <SfButton CssClass="e-success e-round-corner mx-3" IconCss="fa fa-eye" Content="@L["ViewLogins"]"
                      @onclick="onViewLogins">
            </SfButton>
            <SfButton CssClass="e-primary e-round-corner mx-3" IconCss="fa fa-table" Content="@L["msgAll"]"
                      @onclick="onGetAll">
            </SfButton>
        </div>
        <div class="d-flex align-items-center">
            <SfButton id="btn-1" CssClass="e-danger e-round-corner mx-3" IconCss="fa fa-trash" Content="@L["DeleteMsg"]"
                      @onclick="@onDeleteLogs">
            </SfButton>
        </div>
    </div>
    @* <hr class="divider" /> *@

    <div id="target" class="contaimer-fluid">
        <hr />
        <div class="table table-striped table-hover">
            <SfGrid DataSource="@Logs" ID="logsGrid"
                    @ref="LogGrid"
                    AllowPaging="true"
                    AllowSelection="true"
                    AllowSorting="true"
                    AllowFiltering="true"
                    AllowGrouping="true"
                    RowHeight="32"
                    Toolbar="@Tool"
                    EnableAltRow="true"
                    EnableStickyHeader="true"
                    TValue="AppLogDto"
                    AllowTextWrap="true">
                <GridPageSettings PageSize="15" PageSizes="@(new int[] { 15, 20, 50, 100, 200 })"></GridPageSettings>
                <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu"></GridFilterSettings>
                <GridEvents OnActionBegin="OnActionBegin" OnRecordDoubleClick="OnAppLogDoubleClickHandler"
                            CommandClicked="OnAppLogCommandClicked"
                            OnToolbarClick="ToolbarClickHandler"
                            TValue="AppLogDto" />
                <GridColumns>
                    <GridColumn Field=@nameof(AppLogDto.Id) Width="80" TextAlign=Syncfusion.Blazor.Grids.TextAlign.Center
                                HeaderText="ID#" 
                                AllowGrouping="false" 
                                AllowSorting="true">
                    </GridColumn>
                    <GridColumn Field=@nameof(AppLogDto.Message) Width="350"
                                HeaderText="@L["TituloMensagem"]" 
                                AllowGrouping="false"
                                AllowSorting="true">
                    </GridColumn>

                    <GridColumn Field=@nameof(AppLogDto.Level) Width="110"
                                HeaderText="@L["Level"]" 
                                AllowGrouping="true"
                                AllowSorting="true">
                        <Template>
                            @{
                                var currentEntry = (context as AppLogDto);
                                var level = currentEntry.Level.ToLower();
                                var chipStyle = level == "information" ? "e-primary" : level == "warning" ? "e-warning" : "e-danger";
                                <SfChip>
                                    <ChipItems>
                                        <ChipItem CssClass="@chipStyle" Text="@currentEntry.Level" />
                                    </ChipItems>
                                </SfChip>
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn Field=@nameof(AppLogDto.TimeStamp) Width="180"
                                TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center"
                                AllowGrouping="true"
                                HeaderText="@L["msgData"]" AllowSorting="true">

                        <FilterTemplate>
                            @{
                                <SfDateRangePicker Placeholder="@L["TituloSelecao"]" Width="500" @bind-StartDate="StartDate" @bind-EndDate="EndDate"
                                                   TValue="DateTime">
                                    <DateRangePickerEvents TValue="DateTime" ValueChange="LogDateChangeHandler"></DateRangePickerEvents>
                                </SfDateRangePicker>
                            }
                        </FilterTemplate>

                    </GridColumn>
                    <GridColumn HeaderText="" AllowFiltering="false" AllowSorting="false"
                                AllowGrouping="false"
                                Width="150">
                        <GridCommandColumns>
                            <GridCommandColumn Type=CommandButtonType.Edit
                                               ButtonOption="@(new CommandButtonOptions()
                                                                               {
                                                                                   CssClass = "e-btn e-success e-round",
                                                                                   IconCss = "fa fa-eye"
                                                                               })">
                            </GridCommandColumn>
                            <GridCommandColumn Type=CommandButtonType.Delete
                                               ButtonOption="@(new CommandButtonOptions()
                                                                               {
                                                                                   CssClass = "e-btn e-danger e-round",
                                                                                   IconCss = "fa fa-trash"
                                                                               })">
                            </GridCommandColumn>
                        </GridCommandColumns>
                    </GridColumn>
                </GridColumns>
            </SfGrid>
        </div>
    </div>
}

<SfDialog Width="600px"
          Height="auto"
          IsModal="true"
          ShowCloseIcon="false"
          CloseOnEscape="false"
          @bind-Visible="ViewLogVisibility">
    <DialogEvents Opened="@onOpenLogDialog"></DialogEvents>
    <DialogTemplates>
        <Content>
            <ViewAppLog SelectedLogEntry="SelectedAppLog" />
        </Content>
        <FooterTemplate>
            <div>
                @if (SelectedAppLog.Level.ToLower() == "error" || SelectedAppLog.Level.ToLower() == "fatal")
                {
                    <SfButton CssClass="e-outline e-success e-round-corner float-left" IconCss="fa fa-bug"
                              @onclick="@(() => OpenReportDialog())" Content="@L["btnSendEmail"]">
                    </SfButton>
                }

                <SfButton CssClass="e-outline e-success e-round-corner" IconCss="fa fa-times"
                          @onclick="@(() => ViewLogVisibility = false)" Content="@L["BtnSalir"]">
                </SfButton>
            </div>
        </FooterTemplate>
    </DialogTemplates>
    <DialogAnimationSettings Effect="DialogEffect.FadeZoom" Duration=500></DialogAnimationSettings>
</SfDialog>

<SendErrorEmailDialog Visible="SendEmailDialogVisible"
                      LogEntry="SelectedAppLog"
                      VisibleChanged="@((value) => SendEmailDialogVisible = value)"
                      OnSent="OnEmailSent" />

<ConfirmDeleteComponent AlertMessageType="AlertMessageType.Error"
                        DialogTitle="@L["TituloApagarRegistosLog"]"
                        Message="@DeleteLogEntryCaption" ConfirmationText="@L["MSG_ConfirmarOperacao"]"
                        Visible="@DeleteLogsDialogVisibility"
                        DialogWidth="25%"
                        DialogHeight="auto"
                        OnConfirmationYes="ConfirmDeleteYes"
                        OnConfirmationNo="@(()=>DeleteLogsDialogVisibility = false)" />

<ConfirmDeleteComponent AlertMessageType="AlertMessageType.Error"
                        DialogTitle="@L["TituloApagarRegisto"]"
                        Message="@DeleteLogEntryCaption" ConfirmationText="@L["MSG_ConfirmarOperacao"]"
                        Visible="@DeleteLogDialogVisibility"
                        DialogWidth="25%"
                        DialogHeight="auto"
                        OnConfirmationYes="DeleteLogRecord"
                        OnConfirmationNo="@(()=>DeleteLogDialogVisibility = false)" />

<AlertUserComponent AlertMessageType="AlertMessageType.Info"
                    Title="@alertTitle" DialogWidth="28%"
                    OperationType="OpcoesRegisto.Info"
                    Visibility="@AlertVisibility"
                    Message="@WarningMessage"
                    OnCloseDialog="(()=>AlertVisibility=false)"></AlertUserComponent>

<SfSpinner @ref="SpinnerObj"
           @bind-Visible="@SpinnerVisibility"
           Label="@L["TituloProcessandoPedido"]" Size="50"
           Type="SpinnerType.Bootstrap4"
           CssClass="e-spin-overlay" />

<style>
    #logsGrid .e-grid .e-gridheader {
        position: -webkit-sticky;
        position: sticky;
        top: 56px;
        z-index: 1;
    }

    .e-round-corner {
        border-radius: 10px;
    }

</style>
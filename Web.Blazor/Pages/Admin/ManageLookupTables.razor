@page "/admin/managelookuptables"

@using Microsoft.Extensions.Localization
@using Syncfusion.Blazor.Navigations
@using Syncfusion.Blazor.DropDowns
@using Web.Blazor.Components
@using Web.Blazor.Pages.LookupTables

@inject IStringLocalizer<App> L

<PageTitleComponent PageTitle="@L["TituloTabelasAuxiliares"]" />

<div class="container-fluid">
    <SfTab OverflowMode="OverflowMode.Scrollable">
        <TabAnimationSettings>
            <TabAnimationPrevious Effect="@PreviousEffect"></TabAnimationPrevious>
            <TabAnimationNext Effect="@NextEffect"></TabAnimationNext>
        </TabAnimationSettings>
        <TabItems>
            <TabItem>
                <ChildContent>
                    <TabHeader Text="@L["TituloCategoriasPublicacoes"]" IconCss="fa fa-book"></TabHeader>
                </ChildContent>
                <ContentTemplate>
                    <div class="mt-md-4 mx-md-3">
                        <CategoriasPublicacoes />
                    </div>
                </ContentTemplate>
            </TabItem>
            <TabItem>
                <ChildContent>
                    <TabHeader Text="@L["frmEditoras"]" IconCss="fa fa-building-o"></TabHeader>
                </ChildContent>
                <ContentTemplate>
                    <div class="mt-md-4 mx-md-3">
                        <Editoras />
                    </div>
                </ContentTemplate>
            </TabItem>
            <TabItem>
                <ChildContent>
                    <TabHeader Text="@L["frmFormatos"]" IconCss="fa fa-th-large"></TabHeader>
                </ChildContent>
                <ContentTemplate>
                    <div class="mt-md-4 mx-md-3">
                        <Formatos />
                    </div>
                </ContentTemplate>
            </TabItem>
            <TabItem>
                <ChildContent>
                    <TabHeader Text="@L["frmLocaisArquivo"]" IconCss="fa fa-folder-open-o"></TabHeader>
                </ChildContent>
                <ContentTemplate>
                    <div class="mt-md-4 mx-md-3">
                        <LocaisArquivo />
                    </div>
                </ContentTemplate>
            </TabItem>
            <TabItem>
                <ChildContent>
                    <TabHeader Text="@L["TituloCategoriasMedia"]" IconCss="fa fa-camera"></TabHeader>
                </ChildContent>
                <ContentTemplate>
                    <div class="mt-md-4 mx-md-3">
                        <CategoriasMedia />
                    </div>
                </ContentTemplate>
            </TabItem>
            <TabItem>
                <ChildContent>
                    <TabHeader Text="@(L["frmFormatos"] + " " + "Media")" IconCss="fa fa-film"></TabHeader>
                </ChildContent>
                <ContentTemplate>
                    <div class="mt-md-4 mx-md-3">
                        <FormatosMedia />
                    </div>
                </ContentTemplate>
            </TabItem>
            <TabItem>
                <ChildContent>
                    <TabHeader Text="@L["AiModelsTitle"]" IconCss="fa fa-cogs"></TabHeader>
                </ChildContent>
                <ContentTemplate>
                    <div class="mt-md-4 mx-md-3">
                        <AIModels />
                    </div>
                </ContentTemplate>
            </TabItem>
        </TabItems>
    </SfTab>
</div>
@code {
    private Syncfusion.Blazor.AnimationEffect PreviousEffect = Syncfusion.Blazor.AnimationEffect.SlideLeftIn;
    private Syncfusion.Blazor.AnimationEffect NextEffect = Syncfusion.Blazor.AnimationEffect.SlideRightIn;
}

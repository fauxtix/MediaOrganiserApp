        opacity: .87;
        font-size: 16px;
        margin-top: 8px;
    }

    .name {
        padding: 5px 42px;
        opacity: .87;
        line-height: 1.063em;
    }

    .empImage {
        margin: 6px 16px;
        float: left;
        width: 25px;
        height: 25px;
    }

    .value {
        border-radius: 50%;
        float: left;
        margin-top: 2px;
        margin-left: 2px;
    }

    .e-tab {
        border: 5px solid steelblue;
        padding: 5px;
        gap: 5px;
    }

        .e-tab .e-tab-header .e-toolbar-items {
            background: #9faed8;
            border: 2px solid gray;
        }

        .e-tab .e-content .e-item {
            color: #a78515;

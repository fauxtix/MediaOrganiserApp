    }

    .bootstrap .ename {
        font-size: 15px;
        margin-top: 20px;
        opacity: .87;
        padding: 3px 0 20px;
    }

    .e-bigger.bootstrap .ename {
        font-size: 12px;
        padding-bottom: 15px;
    }

    .e-dialog .e-dlg-header {
        color: var(--app-text-primary);
        font-size: 20px;
        font-weight: normal;
    }

    .e-dialog .e-dlg-content {

@page "/admin/appsettings"
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Buttons

@using Microsoft.AspNetCore.Components.Forms
@using Web.Blazor.Components
@using Syncfusion.Blazor.FileManager
@using Web.Blazor.Services.CloudChat


<PageTitle>@L["menu-admin-main"]</PageTitle>
<PageTitleComponent PageTitle="@L["menu-admin-main"]"></PageTitleComponent>
@if (settings is null || AiModels is null || !AiModels.Any())
{
    <LoadingData />
}
else
{
    <SfBreadcrumb>
        <BreadcrumbItems>
            <BreadcrumbItem Text="@L["Home"]" IconCss="e-icons e-home" Url="/" />
            <BreadcrumbItem Text="@L["TituloDefinicoes"]" Url="/admin/appsettings" />
        </BreadcrumbItems>
    </SfBreadcrumb>
    <hr />

    <div class="container">
        <EditForm Model="@settings">
            <SfTab>
                <TabItems>
                    <TabItem>
                        <ChildContent>
                            <TabHeader Text="@L["TituloPastas"]" IconCss="e-folders"></TabHeader>
                        </ChildContent>
                        <ContentTemplate>
                            @* <SfMessage CssClass="rounded" Variant="MessageVariant.Filled" ContentAlignment="HorizontalAlign.Center"
                                       Severity="MessageSeverity.Success" ShowCloseIcon=false ShowIcon=false>Folders</SfMessage> *@
                            <div class="row">
                                <div class="col-md-6 col-sm-12">
                                    <SfMessage CssClass="rounded" Variant="MessageVariant.Text"
                                               Severity="MessageSeverity.Success" ShowCloseIcon=false ShowIcon=false><h5>@L["Downloads"]</h5></SfMessage>
                                </div>
                                <div class="col-md-6 col-sm-12 ">
                                    <SfMessage CssClass="rounded" Variant="MessageVariant.Text"
                                               Severity="MessageSeverity.Success" ShowCloseIcon=false ShowIcon=false><h5>@L["TituloBackups"]</h5></SfMessage>
                                </div>
                            </div>
                            <div class="row my-1">
                                <div class="col-md-4 col-sm-12">
                                    <SfTextBox class="form-control mt-2" @bind-Value="settings.PastaDownloadsPdf" Placeholder="@L["PdfDownloads"]" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                                </div>
                                <div class="col-md-2 col-sm-12 mt-4">
                                    <SfButton OnClick="(() => OpenFileManager(FileManagerOptions.PdfDownloads))"><i class="fa fa-folder-open p-1"></i></SfButton>
                                </div>
                                <div class="col-md-4 col-sm-12">
                                    <SfTextBox class="form-control mt-2" @bind-Value="settings.PastaBackupBD" Placeholder="@L["btnManutBD"]" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                                </div>
                                <div class="col-md-2 col-sm-12 mt-4">
                                    <SfButton OnClick="(() => OpenFileManager(FileManagerOptions.BackupBD))"><i class="fa fa-folder-open p-1"></i></SfButton>
                                </div>
                            </div>
                            <div class="row my-1">
                                <div class="col-md-4 col-sm-12">
                                    <SfTextBox class="form-control mt-2" @bind-Value="settings.PastaDownloadsMedia" Placeholder="@L["TituloFormatoMedia"]" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                                </div>
                                <div class="col-md-2 col-sm-12 mt-4">
                                    <SfButton OnClick="(() => OpenFileManager(FileManagerOptions.MediaDownloads))"><i class="fa fa-folder-open p-1"></i></SfButton>
                                </div>
                                <div class="col-md-4 col-sm-12">
                                    <SfTextBox class="form-control mt-2" @bind-Value="settings.PastaBackupUploads" Placeholder="@L["TituloUploadsPublicacoes"]" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                                </div>
                                <div class="col-md-2 col-sm-12 mt-4">
                                    <SfButton OnClick="(() => OpenFileManager(FileManagerOptions.BackupUploads))"><i class="fa fa-folder-open p-1"></i></SfButton>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 col-sm-12 ">
                                    <SfMessage CssClass="rounded" Variant="MessageVariant.Text"
                                               Severity="MessageSeverity.Success" ShowCloseIcon=false ShowIcon=false><h5>@L["TituloArmazenamento"]</h5></SfMessage>
                                </div>
                                <div class="col-md-6 col-sm-12 ">
                                    <SfMessage CssClass="rounded" Variant="MessageVariant.Text"
                                               Severity="MessageSeverity.Success" ShowCloseIcon=false ShowIcon=false><h5>@L["lblImagens"]</h5></SfMessage>
                                </div>
                            </div>

                            <div class="row my-1">
                                <div class="col-md-4 col-sm-12">
                                    <SfTextBox class="form-control mt-1" @bind-Value="settings.PastaPublicacoes" Placeholder="@L["mnuLivros"]" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                                </div>
                                <div class="col-md-2 col-sm-12 mt-4">
                                    <SfButton OnClick="(() => OpenFileManager(FileManagerOptions.PublicationsFolder))"><i class="fa fa-folder-open p-1"></i></SfButton>
                                </div>
                                <div class="col-md-4 col-sm-12">
                                    <SfTextBox class="form-control mt-2" @bind-Value="settings.PastaImagens" Placeholder="@L["TituloAplicacao"]" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                                </div>
                                <div class="col-md-2 col-sm-12 mt-4">
                                    <SfButton OnClick="(() => OpenFileManager(FileManagerOptions.ImagesFolder))"><i class="fa fa-folder-open p-1"></i></SfButton>
                                </div>
                            </div>
                            <div class="row my-1">
                                <div class="col-md-4 col-sm-12">
                                    <SfTextBox class="form-control mt-2" @bind-Value="settings.PastaListagens" Placeholder="@L["TituloListagens"]" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                                </div>
                                <div class="col-md-2 col-sm-12 mt-4">
                                    <SfButton OnClick="(() => OpenFileManager(FileManagerOptions.ReportsFolder))"><i class="fa fa-folder-open p-1"></i></SfButton>
                                </div>

                                <div class="col-md-4 col-sm-12">
                                    <SfTextBox class="form-control mt-2" @bind-Value="settings.PastaImagensAutores" Placeholder="@L["TituloImagensAutores"]" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                                </div>
                                <div class="col-md-2 col-sm-12 mt-4">
                                    <SfButton OnClick="(() => OpenFileManager(FileManagerOptions.AuthorImagesFolder))"><i class="fa fa-folder-open p-1"></i></SfButton>
                                </div>
                            </div>
                            <div class="row my-1">
                                <div class="col-md-6"></div>
                                <div class="col-md-4 col-sm-12">
                                    <SfTextBox class="form-control mt-2" @bind-Value="settings.PastaImagensCapasLivros" Placeholder="@L["TituloImagensCapasLivros"]" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                                </div>
                                <div class="col-md-2 col-sm-12 mt-4">
                                    <SfButton OnClick="(() => OpenFileManager(FileManagerOptions.BookImagesFolder))"><i class="fa fa-folder-open p-1"></i></SfButton>
                                </div>

                            </div>
                        </ContentTemplate>
                    </TabItem>
                    <TabItem>
                        <ChildContent>
                            <TabHeader Text="@(L["TituloOtherSettings"] + " 1")" IconCss="e-settings"></TabHeader>
                        </ChildContent>
                        <ContentTemplate>
                            @* <SfMessage CssClass="rounded" Variant="MessageVariant.Filled" ContentAlignment="HorizontalAlign.Center"
                                       Severity="MessageSeverity.Success" ShowCloseIcon=false ShowIcon=false>Other Settings</SfMessage> *@

                            <div class="row my-1">
                                <div class="col-md-6 col-sm-12">
                                    <SfMessage CssClass="rounded" Variant="MessageVariant.Text"
                                               Severity="MessageSeverity.Success" ShowCloseIcon=false ShowIcon=false><h5>@L["TituloContactos"]</h5></SfMessage>
                                    <SfTextBox class="form-control mt-1" @bind-Value="settings.AuthorMobile" Placeholder="@L["lblAutor"]" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                                    <SfTextBox class="form-control mt-1" @bind-Value="settings.SupportMail" Placeholder="@L["TituloEmailSuporte"]" FloatLabelType="FloatLabelType.Always"></SfTextBox>
                                </div>
                                <div class="col-md-6 col-sm-12">
                                    <SfMessage CssClass="rounded" Variant="MessageVariant.Text"
                                               Severity="MessageSeverity.Success" ShowCloseIcon=false ShowIcon=false><h5>@L["TituloOutrasDefinicoes"]</h5></SfMessage>

                                    <SfNumericTextBox class="form-control mt-1" @bind-Value="settings.TempoNotifier" Min="1" Max="5" Width="30%"
                                                      Placeholder="@L["TituloNotificationTime"]" " FloatLabelType="FloatLabelType.Always"></SfNumericTextBox>
                                    <div class="row mt-2">
                                        <div class="col-md-9 my-1">
                                            <div class="form-label mt-2" style="color:var(--app-text-primary);font-size:small">@L["TituloFicheirosOrganizados"]</div>
                                            <div class="form-label mt-2" style="color:var(--app-text-primary); font-size:small">@L["TituloRemoverImagemAposEdicao"]</div>
                                        </div>
                                        <div class="col-md-3 my-1">
                                            <div><SfSwitch CssClass="mt-1 p-2" @bind-Checked="settings.FicheirosOrganizados" OnLabel="On" OffLabel="Off"></SfSwitch></div>
                                            <div><SfSwitch CssClass="mt-1 p-2" @bind-Checked="settings.RemoveImagemAposAlteracao" OnLabel="On" OffLabel="Off"></SfSwitch></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-12">
                                    <SfMessage CssClass="rounded" Variant="MessageVariant.Text"
                                               Severity="MessageSeverity.Success" ShowCloseIcon=false ShowIcon=false><h5>@L["TituloDefaultLanguage"]</h5></SfMessage>
                                    <SfDropDownList TValue="string" CssClass="template"
                                                    TItem="CountryModel"
                                                    Placeholder="@L["lblEscolhaLinguagem"]"
                                                    DataSource="@CountryData" Value="@selectedCulture">
                                        <DropDownListTemplates TItem="CountryModel">
                                            <ItemTemplate Context="langCtx">
                                                <div>
                                                    <img class="empImage" src="/images/@((langCtx as CountryModel).Pic).png" alt="pa�s" />
                                                    <div class="ename">@L[((langCtx as CountryModel).Text!)] </div>
                                                </div>
                                            </ItemTemplate>
                                            <ValueTemplate Context="ctx">
                                                <div class="dropdown-width" style="width:100%;height:100%;">
                                                    <img class="value" src="/images/@((ctx as CountryModel).Pic).png" height="26" width="26" alt="pa�s">
                                                    <div class="name">@L[((ctx as CountryModel).Text!)] </div>
                                                </div>
                                            </ValueTemplate>
                                        </DropDownListTemplates>
                                        <DropDownListFieldSettings Value="ID" Text="Text"></DropDownListFieldSettings>
                                        <DropDownListEvents TItem="CountryModel" TValue="string" ValueChange="OnSelected"></DropDownListEvents>
                                    </SfDropDownList>
                                </div>

                                </div>
                        </ContentTemplate>
                    </TabItem>
                    <TabItem>
                        <ChildContent>
                            <TabHeader Text="@(L["TituloOtherSettings"] + " 2")" IconCss="e-settings"></TabHeader>
                        </ChildContent>
                        <ContentTemplate>

                            @* Novos settings 2026 *@
                            <div class="row">
                                <div class="col-md-6 col-sm-12">
                                    <SfMessage CssClass="rounded" Variant="MessageVariant.Text"
                                               Severity="MessageSeverity.Success" ShowCloseIcon=false ShowIcon=false><h5>@L["ApiBaseUrl_Production"]</h5></SfMessage>
                                    <SfTextBox @bind-Value="settings.ApiBaseUrl_Production" Placeholder="@L["ApiBaseUrl_Production"]"></SfTextBox>
                                </div>
                                <div class="col-md-6 col-sm-12">
                                    <SfMessage CssClass="rounded" Variant="MessageVariant.Text"
                                               Severity="MessageSeverity.Success" ShowCloseIcon=false ShowIcon=false><h5>@L["ApiBaseUrl_Development"]</h5></SfMessage>
                                    <SfTextBox @bind-Value="settings.ApiBaseUrl_Development" Placeholder="@L["ApiBaseUrl_Development"]"></SfTextBox>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 col-sm-12">
                                    <SfMessage CssClass="rounded" Variant="MessageVariant.Text"
                                               Severity="MessageSeverity.Success" ShowCloseIcon=false ShowIcon=false><h5>@L["FileManagerApiBaseUrl_Production"]</h5></SfMessage>
                                    <SfTextBox @bind-Value="settings.FileManagerApiBaseUrl_Production" Placeholder="@L["FileManagerApiBaseUrl_Production"]"></SfTextBox>
                                </div>
                                <div class="col-md-6 col-sm-12">
                                    <SfMessage CssClass="rounded" Variant="MessageVariant.Text"
                                               Severity="MessageSeverity.Success" ShowCloseIcon=false ShowIcon=false><h5>@L["FileManagerApiBaseUrl_Development"]</h5></SfMessage>
                                    <SfTextBox @bind-Value="settings.FileManagerApiBaseUrl_Development" Placeholder="@L["FileManagerApiBaseUrl_Development"]"></SfTextBox>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 col-sm-12">
                                    <SfMessage CssClass="rounded" Variant="MessageVariant.Text"
                                               Severity="MessageSeverity.Success" ShowCloseIcon=false ShowIcon=false><h5>@L["LastFmApiKey"]</h5></SfMessage>
                                    <SfTextBox @bind-Value="settings.LastFmApiKey" Placeholder="@L["LastFmApiKey"]"></SfTextBox>
                                </div>
                                <div class="col-md-6 col-sm-12">
                                    <SfMessage CssClass="rounded" Variant="MessageVariant.Text"
                                               Severity="MessageSeverity.Success" ShowCloseIcon=false ShowIcon=false><h5>@L["LastFmApiSecret"]</h5></SfMessage>
                                    <SfTextBox @bind-Value="settings.LastFmApiSecret" Placeholder="@L["LastFmApiSecret"]"></SfTextBox>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 col-sm-12">
                                    <SfMessage CssClass="rounded" Variant="MessageVariant.Text"
                                               Severity="MessageSeverity.Success" ShowCloseIcon=false ShowIcon=false><h5>@L["GoogleBooksApiKey"]</h5></SfMessage>
                                    <SfTextBox @bind-Value="settings.GoogleBooksApiKey" Placeholder="@L["GoogleBooksApiKey"]"></SfTextBox>
                                </div>
                                <div class="col-md-6 col-sm-12">
                                    <SfMessage CssClass="rounded" Variant="MessageVariant.Text"
                                               Severity="MessageSeverity.Success" ShowCloseIcon=false ShowIcon=false><h5>@L["GoogleBooksCountry"]</h5></SfMessage>
                                    <SfTextBox @bind-Value="settings.GoogleBooksCountry" Placeholder="@L["GoogleBooksCountry"]"></SfTextBox>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 col-sm-12">
                                    <SfMessage CssClass="rounded" Variant="MessageVariant.Text"
                                               Severity="MessageSeverity.Success" ShowCloseIcon=false ShowIcon=false><h5>@L["IMDbKey"]</h5></SfMessage>
                                    <SfTextBox @bind-Value="settings.IMDbKey" Placeholder="@L["IMDbKey"]"></SfTextBox>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-12">
                                    <SfMessage CssClass="rounded" Variant="MessageVariant.Text"
                                               Severity="MessageSeverity.Success" ShowCloseIcon=false ShowIcon=false><h5>@L["Database_ConnectionString"]</h5></SfMessage>
                                    <SfTextBox @bind-Value="settings.Database_ConnectionString" Placeholder="@L["Database_ConnectionString"]"></SfTextBox>
                                </div>
                            </div>
                        </ContentTemplate>
                    </TabItem>

                    <TabItem>
                        <ChildContent>
                            <TabHeader Text="@L["TituloGrupoIA"]" IconCss="e-cloud"></TabHeader>
                        </ChildContent>
                        <ContentTemplate>
                            <SfMessage CssClass="rounded" Variant="MessageVariant.Text"
                                       Severity="MessageSeverity.Success" ShowCloseIcon=false ShowIcon=false><h5>@L["TituloIAComum"]</h5></SfMessage>
                            <div class="cloudchat-model-list mt-4 mx-3">
                                <div class="form-label mt-2" style="color:var(--app-text-primary); font-size:small">@L["CloudChatEnableReasoning"]</div>
                                <div><SfSwitch CssClass="mt-1 p-2" @bind-Checked="CloudChatEnableReasoning" OnLabel="On" OffLabel="Off"></SfSwitch></div>
                                <div class="cloudchat-hint" style="color:var(--app-text-secondary); font-size:x-small">@L["CloudChatEnableReasoningHint"]</div>
                            </div>
                            <hr />
                            <SfMessage CssClass="rounded" Variant="MessageVariant.Text"
                                       Severity="MessageSeverity.Success" ShowCloseIcon=false ShowIcon=false><h5>@L["TituloIAOpenRouter"]</h5></SfMessage>
                            <div class="row">
                                <div class="col-md-6 col-sm-12">
                                    <SfMessage CssClass="rounded" Variant="MessageVariant.Text"
                                               Severity="MessageSeverity.Success" ShowCloseIcon=false ShowIcon=false><h5>@L["CloudChatApiKey"]</h5></SfMessage>
                                    @if (CloudChatIsAdmin)
                                    {
                                        <SfTextBox class="form-control mt-1"
                                                   @bind-Value="CloudChatApiKey"
                                                   Placeholder="@L["CloudChatApiKey"]"
                                                   HtmlAttributes="@(new Dictionary<string, object> { ["type"] = "password" })"
                                                   ShowClearButton="true"></SfTextBox>
                                        <div class="cloudchat-status @(CloudChatApiKeyStatus == "Configured" ? "cloudchat-ok" : "cloudchat-warn")">
                                            @(CloudChatApiKeyStatus == "Configured" ? L["CloudChatApiKeyConfigured"] : L["CloudChatApiKeyMissing"])
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="cloudchat-status cloudchat-warn">@L["CloudChatAdminOnly"]</div>
                                    }
                                    <hr/>
                                    <div class="cloudchat-model-list mt-4 mx-3">
                                        <div class="form-label mt-2" style="color:var(--app-text-primary); font-size:small">@L["CloudChatAllowPaidModels"]</div>
                                        <div><SfSwitch CssClass="mt-1 p-2" @bind-Checked="CloudChatAllowPaidModels" OnLabel="On" OffLabel="Off"></SfSwitch></div>
                                        <div class="form-label mt-2" style="color:var(--app-text-primary); font-size:small">@L["CloudChatAuthorBooksUseCloud"]</div>
                                        <div><SfSwitch CssClass="mt-1 p-2" @bind-Checked="CloudChatAuthorBooksUseCloud" OnLabel="On" OffLabel="Off"></SfSwitch></div>
                                        <div class="cloudchat-hint" style="color:var(--app-text-secondary); font-size:x-small">@L["CloudChatAuthorBooksUseCloudHint"]</div>
                                    </div>
                                </div>
                                <div class="col-md-6 col-sm-12">
                                    <SfMessage CssClass="rounded" Variant="MessageVariant.Text"
                                               Severity="MessageSeverity.Success" ShowCloseIcon=false ShowIcon=false><h5>@L["CloudChatDefaultModel"]</h5></SfMessage>
                                    @if (CloudChatIsAdmin)
                                    {
                                        <div class="cloudchat-active">
                                            <span class="cloudchat-active-label">@L["CloudChatActiveModelLabel"]</span>
                                            <span class="cloudchat-active-id @(ModeloSelecionadoEhPago ? "paid" : "")">@CloudChatDefaultModel</span>
                                            @if (ModeloSelecionadoEhPago)
                                            {
                                                <span class="cloudchat-model-badge paid">@L["CloudChatModelPaidBadge"]</span>
                                            }
                                            else
                                            {
                                                <span class="cloudchat-model-badge free">@L["CloudChatModelFreeBadge"]</span>
                                            }
                                            @if (EhModeloRecomendado(CloudChatDefaultModel))
                                            {
                                                <span class="cloudchat-model-badge recommended">@L["CloudChatModelRecommendedBadge"]</span>
                                            }
                                        </div>
                                        @if (AvisoModeloPagoSemChave)
                                        {
                                            <div class="cloudchat-status cloudchat-warn">@AvisoModeloPagoMensagem</div>
                                        }
                                        <div class="cloudchat-search">
                                            <input class="cloudchat-search-input"
                                                   @bind="CloudChatModelFilter"
                                                   @bind:event="oninput"
                                                   onkeydown="if(event.key==='Enter')event.preventDefault();"
                                                   placeholder="@L["CloudChatModelSearchPlaceholder"]" />
                                        </div>
                                        <div class="cloudchat-model-list">
                                            @foreach (var modelo in OpenRouterModelsExibidos)
                                            {
                                                var selecionado = string.Equals(modelo.Id, CloudChatDefaultModel, StringComparison.OrdinalIgnoreCase);
                                                <label class="cloudchat-model-row">
                                                    <input type="radio"
                                                           name="cloudchat-default-model"
                                                           value="@modelo.Id"
                                                           checked="@selecionado"
                                                           @onchange="() => SelectCloudChatModel(modelo.Id)" />
                                                    <span class="cloudchat-model-info">
                                                        <span class="cloudchat-model-name">@modelo.Nome</span>
                                                        <span class="cloudchat-model-id">@modelo.Id</span>
                                                    </span>
                                                    <span class="cloudchat-model-badges">
                                                        @if (modelo.EhRouter)
                                                        {
                                                            <span class="cloudchat-model-badge router">@L["CloudChatModelRouterBadge"]</span>
                                                        }
                                                        else
                                                        {
                                                            @if (modelo.ContextLength.HasValue)
                                                            {
                                                                <span class="cloudchat-model-badge">@($"~{FormatarContextoCloud(modelo.ContextLength.Value)}")</span>
                                                            }
                                                            @if (modelo.EhGratuito)
                                                            {
                                                                <span class="cloudchat-model-badge free">@L["CloudChatModelFreeBadge"]</span>
                                                            }
                                                            @if (EhModeloRecomendado(modelo.Id))
                                                            {
                                                                <span class="cloudchat-model-badge recommended">@L["CloudChatModelRecommendedBadge"]</span>
                                                            }
                                                        }
                                                    </span>
                                                </label>
                                            }
                                            @if (!OpenRouterModelsExibidos.Any())
                                            {
                                                <div class="cloudchat-model-empty">@L["CloudChatModelNoResults"]</div>
                                            }
                                        </div>
                                        <div class="cloudchat-usage-grid mt-3">
                                            <div class="cloudchat-card">
                                                <h6 class="cloudchat-card-title">@L["CloudChatCreditsTitle"]</h6>
                                                @if (CloudChatUsage is null)
                                                {
                                                    <div class="cloudchat-status cloudchat-warn">@L["CloudChatUsageUnavailable"]</div>
                                                }
                                                else if (!CloudChatUsage.ChaveConfigurada)
                                                {
                                                    <div class="cloudchat-status cloudchat-warn">@L["CloudChatApiKeyMissing"]</div>
                                                }
                                                else
                                                {
                                                    @if (!string.IsNullOrWhiteSpace(CloudChatUsage.Erro))
                                                    {
                                                        <div class="cloudchat-status cloudchat-warn">@CloudChatUsage.Erro</div>
                                                    }
                                                    <div class="cloudchat-row">
                                                        <span class="cloudchat-row-label">@L["CloudChatBalanceLabel"]</span>
                                                        <span class="cloudchat-row-value">@CloudChatUsage.SaldoRestante?.ToString("0.##")</span>
                                                    </div>
                                                    <div class="cloudchat-row">
                                                        <span class="cloudchat-row-label">@L["CloudChatUsageTodayLabel"]</span>
                                                        <span class="cloudchat-row-value">@CloudChatUsage.UsoHoje?.ToString("0.##")</span>
                                                    </div>
                                                    <div class="cloudchat-row">
                                                        <span class="cloudchat-row-label">@L["CloudChatUsageWeekLabel"]</span>
                                                        <span class="cloudchat-row-value">@CloudChatUsage.UsoSemana?.ToString("0.##")</span>
                                                    </div>
                                                    <div class="cloudchat-row">
                                                        <span class="cloudchat-row-label">@L["CloudChatUsageMonthLabel"]</span>
                                                        <span class="cloudchat-row-value">@CloudChatUsage.UsoMes?.ToString("0.##")</span>
                                                    </div>
                                                    <div class="cloudchat-row">
                                                        <span class="cloudchat-row-label">@L["CloudChatKeyLimitLabel"]</span>
                                                        <span class="cloudchat-row-value">@CloudChatUsage.LimiteKey?.ToString("0.##")</span>
                                                    </div>
                                                    <div class="cloudchat-row">
                                                        <span class="cloudchat-row-label">@L["CloudChatKeyLimitRemainingLabel"]</span>
                                                        <span class="cloudchat-row-value">@CloudChatUsage.LimiteKeyRestante?.ToString("0.##")</span>
                                                    </div>
                                                    @if (!CloudChatUsage.PodeUsarModelosPagos)
                                                    {
                                                        <div class="cloudchat-status cloudchat-warn">@L["CloudChatPaidUnsupportedWarning"]</div>
                                                    }
                                                }
                                            </div>
                                            <div class="cloudchat-card">
                                                <h6 class="cloudchat-card-title">@L["CloudChatFreeUsageTitle"]</h6>
                                                @if (CloudChatUsage is null)
                                                {
                                                    <div class="cloudchat-status cloudchat-warn">@L["CloudChatUsageUnavailable"]</div>
                                                }
                                                else
                                                {
                                                    <div class="cloudchat-row">
                                                        <span class="cloudchat-row-label">@L["CloudChatFreeUsedLabel"]</span>
                                                        <span class="cloudchat-row-value">@CloudChatUsage.UsadosGratisHoje / @CloudChatUsage.TetoDiario</span>
                                                    </div>
                                                    <div class="cloudchat-progress">
                                                        <div class="cloudchat-progress-fill @(CloudChatUsage.PercentagemUsada >= 80 ? "warn" : "")"
                                                             style="width:@(Math.Min(100, CloudChatUsage.PercentagemUsada))%"></div>
                                                    </div>
                                                    <div class="cloudchat-row">
                                                        <span class="cloudchat-row-label">@L["CloudChatFreeResetLabel"]</span>
                                                        <span class="cloudchat-row-value">@CloudChatUsage.ResetUTC?.ToString("dd/MM HH:mm 'UTC'")</span>
                                                    </div>
                                                    <div class="cloudchat-row">
                                                        <span class="cloudchat-row-label">@L["CloudChatFreeCapModeLabel"]</span>
                                                        <span class="cloudchat-row-value">@(CloudChatUsage.TetoAutomatico ? L["CloudChatFreeCapAutomatic"] : L["CloudChatFreeCapCustom"])</span>
                                                    </div>
                                                    @if (CloudChatUsage.PercentagemUsada >= 80)
                                                    {
                                                        <div class="cloudchat-status cloudchat-warn">@L["CloudChatFreeNearLimitWarning"]</div>
                                                    }
                                                    <div class="form-label mt-2" style="color:var(--app-text-primary); font-size:small">@L["CloudChatFreeCapOverrideLabel"]</div>
                                                    <input class="form-control cloudchat-cap-input"
                                                           type="number" min="0" step="1"
                                                           @bind="CloudChatFreeDailyCap" />
                                                    <div class="cloudchat-hint">@L["CloudChatFreeCapOverrideHint"]</div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                            <hr />
                            <SfMessage CssClass="rounded" Variant="MessageVariant.Text"
                                       Severity="MessageSeverity.Success" ShowCloseIcon=false ShowIcon=false><h5>@L["TituloIAOllama"]</h5></SfMessage>
                            <div class="row">
                                <div class="col-md-6 col-sm-12">
                                    <SfMessage CssClass="rounded" Variant="MessageVariant.Text"
                                               Severity="MessageSeverity.Success" ShowCloseIcon=false ShowIcon=false><h5>@L["TituloChaveApi"]</h5></SfMessage>
                                    <SfTextBox @bind-Value="settings.ApiKey" Placeholder="@L["TituloChaveApi"]"></SfTextBox>
                                </div>
                                <div class="col-md-6 col-sm-12">
                                    <SfMessage CssClass="rounded" Variant="MessageVariant.Text"
                                               Severity="MessageSeverity.Success" ShowCloseIcon=false ShowIcon=false><h5>@L["TituloModelBaseUrl"]</h5></SfMessage>
                                    <SfTextBox @bind-Value="settings.ModelBaseUrl" Placeholder="@L["TituloModelBaseUrl"]"></SfTextBox>
                                </div>
                                <div class="col-md-6 col-sm-12">
                                    <SfMessage CssClass="rounded" Variant="MessageVariant.Text"
                                               Severity="MessageSeverity.Success" ShowCloseIcon=false ShowIcon=false><h5>@L["TituloAIModelName"]</h5></SfMessage>
                                    @* <SfTextBox @bind-Value="settings.AiModelName" Placeholder="@L["TituloAIModelName"]"></SfTextBox> *@
                                    <SfDropDownList TItem="AIModelVM"
                                                    TValue="string"
                                                    DataSource="@AiModels"
                                                    @bind-Value="settings.AiModelName"
                                                    Placeholder="@L["TituloAIModelName"]">
                                        <DropDownListFieldSettings Text="Descricao" Value="Descricao" />
                                    </SfDropDownList>
                                </div>
                            </div>
                        </ContentTemplate>
                    </TabItem>

                </TabItems>
            </SfTab>
            <hr />
            <div class="d-flex justify-content-end align-items-md-center my-3">
                <SfButton CssClass="e-btn e-primary e-round-corner pl-2 pr-3"
                          IconCss="fa fa-save"
                          Content="@L["btnSalvar"]"
                          OnClick="UpdateSettings">
                </SfButton>
            </div>

        </EditForm>
    </div>
}


<SfDialog Width="50%"
          Height="auto"
          IsModal="true"
          EnableResize="true"
          AllowDragging="true"
          CloseOnEscape="true"
          ShowCloseIcon="false"
          @bind-Visible="IsFileManagerVisible">
    <DialogTemplates>
        <Header>
            <h5>@dialogTitle</h5>
        </Header>
        <Content>
            <SfFileManager TValue="FileManagerDirectoryContent"
                           AllowMultiSelection="false"
                           Width="100%" Height="400px">
                <FileManagerAjaxSettings Url="/api/FileManager/FileOperations"
                                         UploadUrl="/api/FileManager/Upload"
                                         DownloadUrl="/api/FileManager/Download"
                                         GetImageUrl="/api/FileManager/GetImage">
                </FileManagerAjaxSettings>
                <FileManagerEvents TValue="FileManagerDirectoryContent"
                                   FileSelection="FileSelection"></FileManagerEvents>
            </SfFileManager>

        </Content>
        <FooterTemplate>
            <SfButton CssClass="e-btn e-success e-round-corner"
                      IconCss="fa fa-times p-1"
                      @onclick="(() => IsFileManagerVisible = false)" Content="@L["TituloConfirmar"]">
            </SfButton>
        </FooterTemplate>
    </DialogTemplates>
    <DialogAnimationSettings Effect="@Effects" Duration=600></DialogAnimationSettings>
</SfDialog>

<SfToast ID="toast_custom" @ref="ToastObj" ShowProgressBar=true
         Title="@ToastTitle" Icon="@ToastIcon"
         Content="@ToastMessage"
         CssClass="@ToastCss" Timeout="2000"
         ShowCloseButton="true">
    <ToastAnimationSettings>
        <ToastShowAnimationSettings Effect="ToastEffect.FadeIn" Duration="600"></ToastShowAnimationSettings>
        <ToastHideAnimationSettings Effect="ToastEffect.FadeOut" Duration="600"></ToastHideAnimationSettings>
    </ToastAnimationSettings>
    <ToastButtons>
        <ToastButton Content="@L["btnFechar"]" OnClick="@HideToast"></ToastButton>
    </ToastButtons>
    <ToastPosition X="Right" Y="Bottom"></ToastPosition>
</SfToast>

<style type="text/css">
    .container .e-message {
        margin: 10px 0;
        font-size: 3rem;
    }

        .container .e-message.rounded {
            border-radius: 15px;
        }

    .e-round-corner {
        border-radius: 10px;
    }

    .template.e-popup .e-list-item * {

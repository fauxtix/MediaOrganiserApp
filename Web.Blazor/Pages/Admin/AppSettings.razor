            }

                .e-tab .e-tab-header .e-toolbar-item.e-active .e-tab-text,
                .e-tab .e-tab-header .e-toolbar-item.e-active .e-tab-icon {
                    color: steelblue !important;
                    align-items: center;
                }

    .e-folders:before {
        content: '\e760';
    }

    .e-settings:before {
        content: '\<a href="#"></a>';
    }

    .cloudchat-status {
        margin-top: 8px;
        padding: 6px 10px;
        border-radius: 6px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .cloudchat-ok {
        background: var(--app-success-bg);
        border: 1px solid var(--app-success-border);
        color: var(--app-success-text);
    }

    .cloudchat-warn {
        background: var(--app-warning-bg);
        border: 1px solid var(--app-warning-border);
        color: var(--app-warning-text);
    }

    .cloudchat-active {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        padding: 8px 12px;
        border: 1px solid var(--app-border);
        border-radius: 8px;
        background: var(--app-surface);
        margin-bottom: 8px;
    }

    .cloudchat-active-label {
        font-size: 0.78rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .4px;
        color: var(--app-text-secondary);
    }

    .cloudchat-active-id {
        font-family: Consolas, "Courier New", monospace;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--app-text-primary);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

        .cloudchat-active-id.paid {
            color: var(--app-accent-yellow);
        }

    .cloudchat-model-badge.paid {
        background: var(--app-warning-bg);
        color: var(--app-warning-text);
        border: 1px solid var(--app-warning-border);
    }

    .e-cloud:before {
        content: '\e757';
    }

    .cloudchat-search {
        margin-bottom: 8px;
    }

    .cloudchat-search-input {
        width: 100%;
        padding: 8px 12px;
        border: 1px solid var(--app-border);
        border-radius: 8px;
        background: var(--app-surface);
        color: var(--app-text-primary);
        font-size: 0.9rem;
        outline: none;
    }

        .cloudchat-search-input:focus {
            border-color: var(--app-primary);
        }

    .cloudchat-model-list {
        display: flex;
        flex-direction: column;
        gap: 6px;
        max-height: 340px;
        overflow-y: auto;
        padding: 8px;
        border: 1px solid var(--app-border);
        border-radius: 10px;
        background: var(--app-surface-alt);
    }

    .cloudchat-model-row {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 12px;
        border: 1px solid transparent;
        border-radius: 8px;
        background: var(--app-surface);
        cursor: pointer;
        transition: border-color .15s ease, background-color .15s ease;
    }

        .cloudchat-model-row:hover {
            background: var(--app-surface-hover);
        }

        .cloudchat-model-row:has(input:checked) {
            border-color: var(--app-primary);
            background: var(--app-surface-hover);
        }

        .cloudchat-model-row input[type="radio"] {
            appearance: none;
            width: 18px;
            height: 18px;
            margin: 0;
            border: 2px solid var(--app-border);
            border-radius: 50%;
            flex-shrink: 0;
            cursor: pointer;
            position: relative;
        }

            .cloudchat-model-row input[type="radio"]:checked {
                border-color: var(--app-primary);
            }

                .cloudchat-model-row input[type="radio"]:checked::after {
                    content: "";
                    position: absolute;
                    inset: 3px;
                    border-radius: 50%;
                    background: var(--app-primary);
                }

    .cloudchat-model-info {
        display: flex;
        flex-direction: column;
        min-width: 0;
        flex: 1;
    }

    .cloudchat-model-name {
        font-weight: 600;
        color: var(--app-text-primary);
    }

    .cloudchat-model-id {
        font-size: 12px;
        color: var(--app-text-secondary);
        font-family: Consolas, "Courier New", monospace;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .cloudchat-model-badges {
        display: flex;
        gap: 6px;
        flex-shrink: 0;
    }

    .cloudchat-model-badge {
        font-size: 11px;
        line-height: 1;
        padding: 4px 8px;
        border-radius: 999px;
        background: var(--app-surface);
        color: var(--app-text-secondary);
        white-space: nowrap;
    }

        .cloudchat-model-badge.free {

@page "/admin/manageusers"


@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.Notifications
@using Syncfusion.Blazor.Navigations
@using Web.Blazor.Components

@inject Microsoft.Extensions.Localization.IStringLocalizer<App> L


@inherits Web.Blazor.Pages.Admin.CodeBehind.AdministrationBase

@attribute [Authorize(Roles = "Administrator")]

@{
    var Filtering = new
    {@@operator = "Contains"
};
var Tool = (new List<object>() { "Search", new ItemModel() { PrefixIcon = "e-searchclose", TooltipText = L["btnLimpar"], Align = ItemAlign.Right, Id = "Clear" } });
}

<PageTitleComponent PageTitle="@(LocalizerApp["frmUsers"])" />

<div id="spinnerContainer"></div>
@if (ColUsers == null)
{
    <LoadingData/>
}
else
{
    <div class="col-lg-12 control-section">
        <div class="content-wrapper">
            <div class="row">
                <div id="target">
                    <div>
                        <SfButton CssClass="e-btn e-success e-round-corner"
                                  IconCss="fa fa-plus"
                                  IsPrimary="true"
                                  @onclick="AddNewUser">
                            &nbsp;@(LocalizerApp["NewMsg"])&nbsp;&nbsp;@(LocalizerApp["Record"])
                        </SfButton>
                        <br /><br />
                    </div>
                    <hr>
                    <SfGrid @ref="gridObj" Toolbar=@Tool
                            Width="auto"
                            Height="400px"
                            DataSource="@ColUsers"
                            AllowFiltering="false"
                            AllowGrouping="false"
                            AllowPaging="true"
                            AllowSorting="true"
                            RowHeight="24"
                            AllowTextWrap="true">
                        <GridPageSettings PageSize="12" PageCount="12" PageSizes="true"></GridPageSettings>
                        <GridEvents OnRecordDoubleClick="onUserDoubleClick" OnToolbarClick="OnUserToolbarClick"
                                    CommandClicked="OnUserCommandClicked" TValue="IdentityUser"></GridEvents>
                        <GridFilterSettings Mode="FilterBarMode.Immediate" Type="Syncfusion.Blazor.Grids.FilterType.Excel"></GridFilterSettings>
                        <GridTemplates>
                        </GridTemplates>
                        <GridColumns>
                            <GridColumn Field=@nameof(IdentityUser.UserName)
                                        HeaderText="@LocalizerApp["lblUtilizador"]" IsPrimaryKey="true" AllowSorting="true" AllowGrouping="false" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Left"
                                        Width="170"></GridColumn>
                            <GridColumn Field=@nameof(IdentityUser.Email) HeaderText="e-mail"
                                        Width="220"></GridColumn>
                            <GridColumn HeaderText="" AllowFiltering="false" AllowSorting="false" Width="90">
                                <GridCommandColumns>
                                    <GridCommandColumn Type=CommandButtonType.Edit
                                                       ButtonOption="@(new CommandButtonOptions()
                                                       {
                                                           Content = "",
                                                           CssClass = "e-icon e-primary e-round",
                                                           IconCss = "fa fa-edit ",
                                                           IconPosition = @IconPosition.Left
                                                       })">
                                    </GridCommandColumn>
                                    <GridCommandColumn Type=CommandButtonType.Delete
                                                       ButtonOption="@(new CommandButtonOptions()
                                                       {
                                                           Content = "",
                                                           CssClass = "e-icon e-danger e-round",
                                                           IconCss = "fa fa-trash",
                                                           IconPosition = @IconPosition.Left
                                                       })">
                                    </GridCommandColumn>
                                </GridCommandColumns>
                            </GridColumn>

                        </GridColumns>
                    </SfGrid>
                </div>
            </div>
        </div>

        <SfDialog Width="600px"
                  Height="auto"
                  MinHeight="500px"
                  IsModal="true"
                  ShowCloseIcon="false" CloseOnEscape="false"
                  @bind-Visible="EditUserDialogVisibility">
            <DialogTemplates>
                <Header>
                    @*@if (EditRecord)
                        {
                            <div class="font-weight-bold"> Editar Utilizador</div>
                        }
                        else
                        {
                            <div class="font-weight-bold"> Novo Utilizador</div>
                        }*@
                </Header>
                <Content>
                    <EditUser SelectedUser="@User" blnEdit="@EditRecord" UserRoleID="@userRoleId" />
                </Content>
                <FooterTemplate>
                    <div>
                        <SfButton CssClass="e-btn e-primary e-round-corner"
                                  IconCss="fa fa-edit"
                                  @onclick="SaveUser">
                            &nbsp;@(LocalizerApp["btnSalvar"])
                        </SfButton>
                        <SfButton CssClass="e-btn e-outline e-round-corner"
                                  IconCss="fa fa-times"
                                  @onclick="Voltar">
                            &nbsp;@(LocalizerApp["BtnSalir"])
                        </SfButton>
                    </div>
                </FooterTemplate>
            </DialogTemplates>
            <DialogAnimationSettings Effect="@Effects" Duration=400></DialogAnimationSettings>
        </SfDialog>


        <SfDialog Target="#target"
                  Width="600px"
                  Height="auto"
                  IsModal="true"
                  ShowCloseIcon="false"
                  @bind-Visible="ErrorVisibility">
            <DialogTemplates>
                <Content>
                    <div class="alert alert-warning" role="alert">
                        <div class="modal-content">
                            <div class="modal-header">
                                @(LocalizerApp["DadosEmFalta"]).
                            </div>
                            <div class="text-wrap">
                                @if (ErrorMsgsList != null)
                                {
                                    <br />
                                    foreach (string errorMsg in ErrorMsgsList)
                                    {
                                        <div class="px-2"> @(errorMsg)</div>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </Content>
                <FooterTemplate>
                    <div class="modal-footer">
                        <SfButton CssClass="e-btn e-round-corner" IconCss="fa fa-times"
                                  @onclick="CloseErrorBox">
                            &nbsp;@(LocalizerApp["btnSalir"])
                        </SfButton>
                    </div>
                </FooterTemplate>
            </DialogTemplates>
            <DialogAnimationSettings Effect="@Effects" Duration=400></DialogAnimationSettings>
        </SfDialog>
        <SfDialog @bind-Visible="@DeleteUserConfirmVisibility" CssClass="quick-info-header"
                  Width="500px" Height="auto"
                  ShowCloseIcon="false">
            <DialogTemplates>
                <Header>
                    @if (User != null)
                    {
                        @User.UserName
                    }
                </Header>
                <Content>
                    @if (User != null)
                    {
                        <div class="row">
                            <div class="col-9">
                                <AlertMessage Message="@(LocalizerApp["ConfirmarExclusao"])" MessageType="AlertMessageType.Error"></AlertMessage>
                            </div>
                            <RightSideImageComponent Operation="@(AppDefinitions.OpcoesRegisto.Apagar)" />
                        </div>
                    }
                </Content>
                <FooterTemplate>
                    <div>
                        <SfButton CssClass="e-btn e-danger e-round-corner" IconCss="fa fa-trash"
                                  @onclick="ConfirmDeleteYes">
                            &nbsp;@(LocalizerApp["Sim"])
                        </SfButton>
                        <SfButton CssClass="e-btn e-outline e-round-corner" IconCss="fa fa-times"
                                  @onclick="ConfirmDeleteNo">
                            &nbsp;@(LocalizerApp["Nao"])

                        </SfButton>
                    </div>
                </FooterTemplate>
            </DialogTemplates>
            <DialogAnimationSettings Effect="@Effects" Duration=400></DialogAnimationSettings>
        </SfDialog>
    </div>


    <SfToast @ref="ToastObj"
             Title="@ToastTitle"
             Content="@ToastContent"
             CssClass="@ToastCssClass" Timeout="1500"
             ShowCloseButton="true">
        <ToastPosition X="Right" Y="Bottom"></ToastPosition>
    </SfToast>
}
<style>
    .e-round-corner {
        border-radius: 15px;
    }

</style>
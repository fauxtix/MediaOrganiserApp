@using System.Text.Json
@using Ganss.Xss
@using Microsoft.Extensions.Logging
@using Web.Blazor.Components
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<App> L
<HeaderDialogComponent HeaderCaption="@mp3Title"
                       ImageName="mp3Image.png"/>
<div class="row mt-2">
    <div class="col-sm-12 col-md-6 col-lg-6 player">
        <SfCard>
            <CardContent EnableSeparator="true">
                <p>@L["Band"]: <span style="font-weight:bold">@mp3FirstArtist</span></p>
                <p>@L["Album"]: <span style="font-weight:bold">@mp3Album</span></p>
                <p>@L["Year"]: <span style="font-weight:bold">@mp3EditionYear</span></p>
                <p>@L["lblEditora"]: <span style="font-weight:bold">@mp3Pusblisher</span></p>
                <p>@L["Genres"]: </p>
                @if (mp3Genres is not null)
                {
                    @foreach (var genero in mp3Genres)
                    {
                        <div class="font-bold">
                            <SfTextBox Enabled="false" Value="@genero"></SfTextBox>
                        </div>
                    }
                }
            </CardContent>
        </SfCard>
    </div>
    @if (sbWikiResponses.Count > 0)
    {
        string response = "";

        <div class="col-sm-12 col-md-6 col-lg-6 player">
            <SfCard>
                <CardHeader Title="@L["Wikipedia"]" SubTitle="@SelectedRecord.Autor"/>
                <CardContent EnableSeparator="true">
                    @foreach (string item in sbWikiResponses)
                    {
                        response += item;
                    }
                    <SfTextBox Value="@response" 
                        Multiline=true 
                        HtmlAttributes="htmlAttribute"
                         
                        CssClass="input-control e-corner" />
                </CardContent>
            </SfCard>
        </div>
    }
</div>

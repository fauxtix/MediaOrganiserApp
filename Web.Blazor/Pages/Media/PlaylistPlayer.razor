.pp-meta { flex: 1; min-width: 0; }
.pp-meta-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
.pp-meta-titles { min-width: 0; }

.pp-track-title { font-size: 1.2rem; font-weight: 800; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.pp-track-author { margin-top: 2px; opacity: .8; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.pp-flags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
.pp-pill { padding: 4px 10px; border-radius: 999px; background: var(--app-surface-hover); font-size: .85rem; font-weight: 700; }

.pp-controls { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }

.pp-sliders { margin-top: 12px; display: grid; gap: 10px; }

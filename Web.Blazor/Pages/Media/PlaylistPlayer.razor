.pp-slider-label { text-align: center; font-weight: 700; opacity: .85; }

.pp-media { margin-top: 10px; }
.pp-audio { width: 100%; }

.pp-status { margin-top: 10px; padding: 8px 10px; border-radius: 10px; background: var(--app-warning-bg); color: var(--app-warning-text); font-weight: 700; }

.pp-hidden { display: none !important; }

/* Bars */
.pp-loader-container {
    height: 40px;
    width: 160px;
    display: flex;
    justify-content: center;
    align-items: flex-end;
}

.pp-loader-container--mini {
    height: 28px;
    width: 130px;
}

.pp-loader-container > div {
    display: inline-block;
    background: #03A9F4;
    height: 100%;
    width: 10px;
    margin: 0;
    -webkit-animation: pp-load 3s ease-in-out infinite;
    animation: pp-load 3s ease-in-out infinite;
}

.pp-loader-container--mini > div { width: 8px; }

.pp-loader-container .pp-rectangle-2 { -webkit-animation-delay: 0.1s; animation-delay: 0.1s; }
.pp-loader-container .pp-rectangle-3 { -webkit-animation-delay: 0.2s; animation-delay: 0.2s; }
.pp-loader-container .pp-rectangle-4 { -webkit-animation-delay: 0.3s; animation-delay: 0.3s; }
.pp-loader-container .pp-rectangle-5 { -webkit-animation-delay: 0.4s; animation-delay: 0.4s; }
.pp-loader-container .pp-rectangle-6 { -webkit-animation-delay: 0.5s; animation-delay: 0.5s; }


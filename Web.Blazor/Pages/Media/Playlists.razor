@page "/media/playlists"

@inherits Web.Blazor.Pages.BaseComponents.PlaylistsBase

@using MediaOrganizerApp.Application.DTOs.PlayLists
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Spinner
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Notifications
@using Syncfusion.Blazor.Navigations
@using Web.Blazor.Components
@using Web.Blazor.Components.Playlists

@attribute [Authorize]

<PageTitle>Playlists</PageTitle>
<PageTitleComponent PageTitle="Playlists" WithBadge="false" PageSubTitle="" Css="title" />

<SfTab>
    <TabItems>
        <TabItem>
            <ChildContent>
                <TabHeader Text="MP3 Playlists"></TabHeader>
            </ChildContent>
            <ContentTemplate>
                @if (isLoading)
                {
                    <LoadingData />
                }
                else
                {
                    <div class="button-container my-2">
                        <SfButton CssClass="e-btn e-success e-round-corner"
                                  IconCss="fa fa-plus" IsPrimary="true"
                                  Content="@localizerApp["NewMsg"]"
                                  @onclick="BeginCreatePlaylist">
                        </SfButton>
                    </div>

                    <div id="target" class="container-fluid">
                        <SfGrid @ref="@gridObj"
                                Width="100%"
                                Height="auto"
                                DataSource="@playLists"
                                AllowFiltering="true"
                                AllowPaging="true"
                                AllowSorting="true"
                                EnableStickyHeader="true"
                                Toolbar="@(new List<object> { "Search" })"
                                RowHeight="26">

                            <GridPageSettings PageSize="10" PageCount="10" PageSizes="true"></GridPageSettings>
                            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu"></GridFilterSettings>

                            <GridEvents OnToolbarClick="OnToolbarClick"
                                        CommandClicked="OnCommandClicked"
                                        DetailDataBound="OnDetailDataBound"
                                        TValue="PlaylistDto" />

                            <GridColumns>
                                @* <GridColumn Field=@nameof(PlaylistDto.Id)
                            HeaderText="ID#" IsPrimaryKey="true"
                            AllowSorting="true" TextAlign="TextAlign.Center"
                            Width="80"></GridColumn> *@

                                <GridColumn Field=@nameof(PlaylistDto.Name)
                                            HeaderText="@localizerApp["lblNomeAutor"]"
                                            TextAlign="TextAlign.Left"
                                            CustomAttributes="@(new Dictionary<string, object>(){ { "class", "e-attr-bold"}})"
                                            Width="200"></GridColumn>

                                <GridColumn Field=@nameof(PlaylistDto.Description)
                                            HeaderText="@localizerApp["rbtDescricao"]"
                                            ClipMode="ClipMode.EllipsisWithTooltip"
                                            TextAlign="TextAlign.Left"
                                            Width="300"></GridColumn>
                                @* <GridColumn Field=@nameof(PlaylistDto.MediaType)
                            HeaderText="@localizerApp["lblTipoUtilizador"]"
                            ClipMode="ClipMode.EllipsisWithTooltip"
                            TextAlign="TextAlign.Left"
                            Width="100">
                    <Template>
                        <SfChip>
                            <ChipItems>
                                @{
                                    string classe = "";
                                    string icon = "";
                                    string msg = "";
                                    var currentRow = (context as PlaylistDto);
                                    if (currentRow.MediaType == MediaType.Audio)
                                    {
                                        msg = "Audio";
                                        classe = "e-info";
                                        icon = "oi oi-audio e-round-corner";
                                    }
                                    else
                                    {
                                        msg = "Video";
                                        classe = "e-success";
                                        icon = "oi oi-video e-round-corner";
                                    }
                                    <ChipItem Text="@msg" LeadingIconCss="@icon" CssClass="@classe"></ChipItem>
                                }
                            </ChipItems>
                        </SfChip>
                    </Template>
                </GridColumn> *@

                                <GridColumn Field=@nameof(PlaylistDto.CreatedAt)
                                            HeaderText="@localizerApp["TituloCriadoEm"]"
                                            Format="dd/MM/yyyy"
                                            TextAlign="TextAlign.Center"
                                            Width="160"></GridColumn>

                                <GridColumn HeaderText=""
                                            AllowFiltering="false"
                                            AllowSorting="false"
                                            TextAlign="TextAlign.Center"
                                            Width="220">
                                    <GridCommandColumns>
                                        <GridCommandColumn Type="CommandButtonType.Edit"
                                                           Title="@localizerApp["EditMsg"]"
                                                           ButtonOption="@(new CommandButtonOptions()
                                                           {
                                                               Content = "",
                                                               CssClass = "e-btn e-primary e-round",
                                                               IconCss = "fa fa-edit"
                                                           })">
                                        </GridCommandColumn>
                                        <GridCommandColumn Type="CommandButtonType.Delete"
                                                           Title="@localizerApp["DeleteMsg"]"
                                                           ButtonOption="@(new CommandButtonOptions()
                                                           {
                                                               Content = "",
                                                               CssClass = "e-btn e-danger e-round",
                                                               IconCss = "fa fa-trash"
                                                           })">
                                        </GridCommandColumn>
                                        <GridCommandColumn Type="CommandButtonType.None"
                                                           Title="@localizerApp["PlayMp3"]"
                                                           ButtonOption="@(new CommandButtonOptions()
                                                           {
                                                               Content = "",
                                                               CssClass = "e-btn e-info e-round",
                                                               IconCss = "fa fa-play"
                                                           })">
                                        </GridCommandColumn>
                                    </GridCommandColumns>
                                </GridColumn>
                            </GridColumns>
                            <GridTemplates>
                                <DetailTemplate Context="playlistObj">
                                    @{
                                        var playlist = playlistObj as PlaylistDto;
                                        if (playlist is null) return;

                                        var playlistId = playlist.Id;

                                        var isLoading = LoadingPlaylists.Contains(playlistId);

                                        // Lista do cache
                                        var itemsList = PlaylistItemsCache.ContainsKey(playlistId)
                                        ? PlaylistItemsCache[playlistId]
                                        : null;
                                    }

                                    <div class="p-2 w-100">
                                        <h5>@localizerApp["TituloItensPlaylist"]</h5>
                                        <hr />
                                        <div class="button-container my-2">
                                            <SfButton CssClass="e-btn e-success e-round-corner"
                                                      IconCss="fa fa-plus" Content="@localizerApp["NewMsg"]"
                                                      @onclick="() => OpenAddItemDialog(playlistId)">
                                            </SfButton>
                                        </div>

                                        @if (isLoading)
                                        {
                                            <div class="p-3">
                                                <span>Carregando...</span>
                                            </div>
                                        }
                                        else if (itemsList is null)
                                        {
                                            <div class="p-3">
                                                <span>Inicializando...</span>
                                            </div>
                                        }
                                        else if (!itemsList.Any())
                                        {
                                            <div class="alert alert-info">
                                                @localizerApp["TituloNoDataToShow"]
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="container-fluid">
                                                <SfGrid DataSource="@itemsList"
                                                        Width="100%"
                                                        AllowPaging="true"
                                                        AllowRowDragAndDrop="true"
                                                        AllowSorting="true"
                                                        AllowFiltering="true">
                                                    <GridRowDropSettings TargetID="@($"playlistItemsGrid-{playlistId}")" />

                                                    <GridPageSettings PageSize="5" PageCount="5" PageSizes="true"></GridPageSettings>
                                                    <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.Menu"></GridFilterSettings>
                                                    <GridSelectionSettings Type="Syncfusion.Blazor.Grids.SelectionType.Multiple">
                                                    </GridSelectionSettings>
                                                    <GridEvents CommandClicked="OnDetailDeleteCommandClicked"
                                                                TValue="PlaylistItemDto"
                                                                RowDragStarting="RowDragStartingHandler"
                                                                RowDropping="RowDroppingHandler"
                                                                RowDropped="RowDroppedHandler" />
                                                    <GridColumns>
                                                        <GridColumn Field=@nameof(PlaylistItemDto.Id)
                                                                    HeaderText="ID#" Visible="false" IsPrimaryKey="true"
                                                                    Width="10" />
                                                        <GridColumn Field=@nameof(PlaylistItemDto.Title)
                                                                    HeaderText="@localizerApp["lblTitulo"]"
                                                                    Width="350" />
                                                        <GridColumn Field=@nameof(PlaylistItemDto.Author)
                                                                    HeaderText="@localizerApp["lblAutor"]"
                                                                    Width="200" />
                                                        <GridColumn Field=@nameof(PlaylistItemDto.CategoriaMedia)
                                                                    HeaderText="@localizerApp["lblCategoria"]"
                                                                    Width="200" />
                                                        <GridColumn Field=@nameof(PlaylistItemDto.TrackTime)
                                                                    HeaderText="@localizerApp["TrackTime"]"
                                                                    Width="140" />
                                                        <GridColumn HeaderText=""
                                                                    AllowFiltering="false"
                                                                    AllowSorting="false"
                                                                    TextAlign="TextAlign.Center"
                                                                    Width="120">
                                                            <GridCommandColumns>
                                                                <GridCommandColumn Type="CommandButtonType.Delete"
                                                                                   Title=""
                                                                                   ButtonOption="@(new CommandButtonOptions()
                                                                                   {
                                                                                       Content = "",
                                                                                       CssClass = "e-btn e-danger e-round",
                                                                                       IconCss = "fa fa-trash"
                                                                                   })">
                                                                </GridCommandColumn>
                                                            </GridCommandColumns>
                                                        </GridColumn>
                                                    </GridColumns>
                                                </SfGrid>
                                            </div>
                                        }
                                    </div>
                                </DetailTemplate>
                            </GridTemplates>
                        </SfGrid>
                    </div>
                }
            </ContentTemplate>
        </TabItem>
        <TabItem>
            <ChildContent>
                <TabHeader Text="YouTube Playlists"></TabHeader>
            </ChildContent>
            <ContentTemplate>
                <YoutubePlaylists />
@*                 <div class="youtube-search-options">
                    <SfDropDownList TItem="string" TValue="string" Width="250px" 
                                    DataSource="@genreMap.Keys.ToList()"
                                    AllowFiltering="true"
                                    Placeholder="Select genre">
                        <DropDownListEvents TItem="string" TValue="string" ValueChange="OnGenreChange"></DropDownListEvents>

                    </SfDropDownList>

                    <SfDropDownList TItem="YoutubePlaylistItem" TValue="string"
                                    DataSource="@playlistList"
                                    Placeholder="Select playlist"
                                    AllowFiltering="true">
                        <DropDownListEvents TItem="YoutubePlaylistItem" TValue="string" ValueChange="OnPlaylistChange"></DropDownListEvents>

                        <DropDownListFieldSettings Text="Title" Value="Id" />
                    </SfDropDownList>
                    <SfButton CssClass="e-btn e-primary e-round-corner"
                              IconCss="fa fa-search"
                              Content="@localizerApp["btnLocalizar"]"
                              @onclick="GetYoutubePlaylist">
                    </SfButton>

                </div>

                @if (ShowTitleSearch)
                {
                    <div class="d-flex justify-content-start align-items-center my-4" style="gap:8px">
                        <label class="font-weight-bold">Search in the list </label>
                        <input class="form-control e-input e-round-corner" style="width:250px"
                               placeholder="Text to search"
                               @bind="TitleSearch"
                               @bind:event="oninput" />

                        @if (!string.IsNullOrEmpty(TitleSearch))
                        {
                            <SfButton CssClass="e-btn e-outline e-round-corner"
                                      IconCss="fa fa-times"
                                      Content="Clear"
                                      @onclick="ClearTitleSearch">
                            </SfButton>
                        }
                    </div>
                }


                @if (!string.IsNullOrWhiteSpace(youtubeSearchError))
                {
                    <div class="alert alert-danger">
                        @youtubeSearchError
                    </div>
                }
                else if (youtubeVideos is not null && youtubeVideos.Any())
                {
                    <div class="container e-container-style">
                        <div class="row text-lg-start">
                            @foreach (var video in FilteredYoutubeVideos)
                            {
                                <SfFab IconCss="fa fa-arrow-up"
                                       Position="FabPosition.BottomRight"
                                       OnClick="ScrollToTop">
                                </SfFab>
                                <div class="col-lg-4 col-md-6 col-sm-12">
                                    <a class="d-block mb-4 h-100" href="@($"https://www.youtube.com/watch?v={video.VideoId}")" target="_blank" style="text-decoration:none;">
                                        <div class="img-box fixed-img-box">
                                            <img class="img-fluid img-thumbnail fixed-img"
                                                 src="@video.ThumbnailUrl"
                                                 alt="@video.Title" />
                                        </div>
                                        <div class="card">
                                            <div class="card-body">
                                                <div class="d-flex justify-content-between align-items-start">
                                                    <p class="info-title"><i>@video.Title</i></p>
                                                    <SfChip>
                                                        <ChipItems>
                                                            <ChipItem CssClass="e-success" Text="@video.PublishedAt.ToString()" />
                                                        </ChipItems>
                                                    </SfChip>
                                                </div>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                } *@
            </ContentTemplate>
        </TabItem>
    </TabItems>
</SfTab>

<SfToast @ref="ToastObj"
         Title="@ToastTitle"
         Content="@ToastContent"
         CssClass="@ToastCssClass"
         Timeout="@ToastTimeOut"
         ShowCloseButton="true">
    <ToastPosition X="right" Y="bottom"></ToastPosition>
</SfToast>

<div id="spinner-container">
    <SfSpinner @ref="SpinnerObj"
               Label="@localizerApp["LoadingMsg"]"
               Type="@SpinnerType.Tailwind"
               CssClass="e-spin-overlay">
    </SfSpinner>
</div>

@* Diálogo Criar/Editar playlist *@
<SfDialog Width="35%"
          Height="auto"
          IsModal="true"
          ShowCloseIcon="false"
          EnableResize="true"
          AllowDragging="true"
          @bind-Visible="EditDialogVisibility">
    <DialogTemplates>
        <Header>
            <div>
                <h3>
                    <img src="/images/media-documents-icon.png" width="32" height="32" />
                    &nbsp;@(IsEditMode ? localizerApp["EditMsg"] + " '" + EditModel.Name + "'" : localizerApp["NewMsg"])
                </h3>
            </div>
        </Header>
        <Content>
            <div class="form-group">
                <label>Nome</label>
                <InputText class="form-control" @bind-Value="EditModel.Name" />
            </div>
            <div class="form-group">
                <label>Tipo de Média</label>
                <div class="radio-button-container">
                    <SfRadioButton TValue="int" CssClass="e-info"
                                   Label="Video"
                                   Value="1"
                                   Name="mediaType"
                                   @bind-Checked="EditModel.MediaType" />
                    <SfRadioButton TValue="int" CssClass="e-info"
                                   Label="Audio"
                                   Value="2"
                                   Name="mediaType"
                                   @bind-Checked="EditModel.MediaType" />
                </div>
            </div>

            <div class="form-group">
                <label>@localizerApp["rbtDescricao"]</label>
                <InputTextArea class="form-control" @bind-Value="EditModel.Description" rows="3" />
            </div>
        </Content>
        <FooterTemplate>
            <div>
                <SfButton CssClass="e-primary e-round-corner"
                          IconCss="fa fa-edit" Content="@localizerApp["btnSalvar"]"
                          @onclick="SavePlaylistAsync">
                </SfButton>
                <SfButton CssClass="e-outline e-round-corner"
                          IconCss="fa fa-times" Content="@localizerApp["BtnSalir"]"
                          @onclick="CancelEditPlaylist">
                </SfButton>
            </div>
        </FooterTemplate>
    </DialogTemplates>
    <DialogAnimationSettings Effect="@Effects" Duration="400"></DialogAnimationSettings>
</SfDialog>



@* Diálogo Detalhes *@
@if (DetailsDialogVisibility && CurrentDetails is not null)
{
    <SfDialog Width="50%"
              Height="auto"
              IsModal="true"
              ShowCloseIcon="false"
              EnableResize="true"
              AllowDragging="true"
              @bind-Visible="DetailsDialogVisibility">
        <DialogTemplates>
            <Header>
                <div class="font-weight-bold">
                    @CurrentDetails.Name
                </div>
            </Header>
            <Content>
                <p>@CurrentDetails.Description</p>
                <hr />
                <ul class="list-group">
                    @foreach (var item in CurrentDetails.Items.OrderBy(i => i.SortOrder))
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>@item.Title</span>
                            <span class="badge badge-secondary">@item.MediaType</span>
                        </li>
                    }
                </ul>
            </Content>
            <FooterTemplate>
                <div class="modal-footer">
                    <SfButton CssClass="e-btn e-outline e-round-corner"
                              IconCss="fa fa-times"
                              @onclick="CloseDetails">
                        &nbsp;@localizerApp["BtnSalir"]
                    </SfButton>
                </div>
            </FooterTemplate>
        </DialogTemplates>
        <DialogAnimationSettings Effect="@Effects" Duration="400"></DialogAnimationSettings>
    </SfDialog>
}

<SfDialog @bind-Visible="AddItemDialogVisibility" Width="50%"
          Height="80%"
          IsModal="true" ShowCloseIcon="true">
    <DialogTemplates>
        <Header>
            <h3>@localizerApp["TituloSelecionarArquivo"]</h3>
        </Header>
        <Content>
            @{
                if (DialogItems is null)
                {
                    <div class="p-3">
                        <span>@localizerApp["LoadingMsg"]...</span>
                    </div>
                }
            }
            <MediaSelector AlreadyAddedFiles="@DialogItems"
                           MediaTypePar="@((int)SelectedPlaylist.MediaType)"
                           PlayListId="@SelectedPlaylist.Id"
                           OnFileSelected="HandleFilesSelected" />
        </Content>
        <FooterTemplate>
            <SfButton IconCss="fa fa-times"
                      CssClass="e-danger e-outline e-round-corner"
                      Content="@localizerApp["btnCancelar"]"
                      @onclick="CloseAddItemDialog" />
        </FooterTemplate>
    </DialogTemplates>
</SfDialog>


@* Diálogo de Confirmação de Exclusão *@
<ConfirmDeleteComponent Visible="@DeleteRecordConfirmVisibility"
                        AlertMessageType="AlertMessageType.Error"
                        ConfirmationText="@(localizerApp["ConfirmarExclusao"])"
                        DialogTitle="@localizerApp["TituloApagarRegisto"]"
                        Message="@SelectedPlaylist.Name"
                        OnConfirmationYes="ConfirmDeleteYes"
                        OnConfirmationNo="CloseDialogDelete" />
@* Diálogo de Confirmação de Exclusão de item na playlist *@
<ConfirmDeleteComponent Visible="@DeletePlaylistItemConfirmVisibility"
                        AlertMessageType="AlertMessageType.Error"
                        ConfirmationText="@(localizerApp["ConfirmarExclusao"])"
                        DialogTitle="@localizerApp["TituloApagarRegisto"]"
                        Message="@(SelectedPlaylistItem.Title + " - " + @SelectedPlaylistItem.Author)"
                        OnConfirmationYes="ConfirmDeletePlaylistItemYes"
                        OnConfirmationNo="@(()=> @DeletePlaylistItemConfirmVisibility = false)" />

@* Erros de validação *@
<ValidateErrorComponent DialogEffect="DialogEffect.FlipXUp"
                        DialogTitle="@ErrorTitle"
                        Visible="@ErrorVisibility"
                        OnCloseDialog="@(()=>ErrorVisibility=false)"
                        ValidationMessages="@ValidationMessages" />


<style>

    .e-container-style {
        background-color: #f0f0f0;
    }

    .button-container {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 4px;
    }

    .radio-button-container {
        display: flex;
        justify-content: flex-start;
        align-items: center;
        gap: 12px;
    }

    .e-radio-wrapper.e-info .e-radio:checked + label::before {
        border-color: #2196f3;
        background-color: blue;
    }

    .e-attr-bold {
        font-weight: bold;
    }

    .video-gallery-thumb {
        position: relative;
        transition: .5s;
        max-height: 230px;
        overflow: hidden;
        margin-bottom: 30px;
        border-radius: 0px 100px;
        background-color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .video-gallery-img {
        max-width: 100%;
        border: 3px solid #FFC107;
        position: relative;
        width: 250px;
        height: 200px;
        object-fit: fill;
        object-position: center;
    }

    .video-gallery-thumb::before {
        content: '';
        border-left: 3px solid #ffffff;
        border-top: 3px solid #ffffff;
        position: absolute;
        left: 20px;
        top: 20px;
        width: 50px;
        height: 50px;
        z-index: 1;
        transition: .5s;
    }

    .video-gallery-thumb::after {
        content: '';
        border-right: 3px solid #ffffff;
        border-bottom: 3px solid #ffffff;
        position: absolute;
        right: 20px;
        bottom: 20px;
        width: 50px;
        height: 50px;
        z-index: 2;
        transition: .5s;
    }

    .video-gallery-thumb:hover {
        transform: scale(1.04);
    }

        .video-gallery-thumb:hover::before {
            left: 10px;
            top: 10px;
        }

        .video-gallery-thumb:hover::after {
            right: 10px;
            bottom: 10px;
        }

    .small-text {
        font-size: 0.8rem;
    }

    .fixed-img-box {
        width: 100%;
        height: 240px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background: #f8f8f8;
        border-radius: 16px;
    }

    .fixed-img {
        width: 100%;
        height: 100%;
        max-width: 340px;
        max-height: 240px;
        object-fit: fill;
        border-radius: 16px;
    }

    .fixed-card {
        min-height: 170px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .info-title {
        margin-left: 3px;
        font-weight: 500;
        flex: 1 1 0;
        font-size: 0.85rem;
        line-height: 1.2em;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        word-break: break-word;
        margin-bottom: 0;
    }

    .card-title-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 10px;
        min-height: 2.5em;
        max-height: 2.5em;
        overflow: hidden;
    }

    .youtube-fab {
        position: fixed !important;
        right: 30px;
        bottom: 30px;
        z-index: 10000;
    }

    .youtube-search-options{
        display: flex;
        gap: 12px;
        align-items: center;
        width:75%;
        margin-bottom: 20px;
        margin-top:20px;
    }

    .e-tab .e-tab-header .e-toolbar-item.e-active {
        background: #d1f4d1;
    }

    .e-tab .e-tab-header .e-toolbar-item .e-tab-wrap:hover {
        background: #badfba !important;
    }
    .e-tab .e-tab-header .e-toolbar-items {
        background: white;
        border: 2px solid  steelblue;
    }
</style>
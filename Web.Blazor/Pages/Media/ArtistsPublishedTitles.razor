@using MediaOrganizerApp.Application.DTOs.Api.MusicBrainz
@using Microsoft.Extensions.Localization
@using Web.Blazor.Components
@using Web.Blazor.Services.ApiWrappers
@inject IMusicApiClient MusicApi
@inject IStringLocalizer<App> L

<h3 class="mb-2">Discografia de @ArtistName</h3>

@if (isLoading)
{
    <LoadingData />
}
else if (isError)
{
    <SfMessage Severity="MessageSeverity.Error" ShowCloseIcon="true">
        @errorMessage
    </SfMessage>
}
else
{
    if (!FilteredReleases.Any())
    {
        <SfMessage Severity="MessageSeverity.Info" ShowCloseIcon="true">
            @L["NoDataFound"]
        </SfMessage>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-2">
            <div>
                <button class="btn btn-sm btn-outline-primary me-1" @onclick="PrevPage" disabled="@(currentPage <= 1 || TotalPages <= 1)">@L["TituloAnterior"]</button>
                <button class="btn btn-sm btn-outline-primary" @onclick="NextPage" disabled="@(currentPage >= TotalPages || TotalPages <= 1)">@L["TituloSeguinte"]</button>
            </div>
            <div class="text-muted small">@L["lblPagina"] @currentPage / @TotalPages</div>
        </div>


         <div class="releases-grid mt-2"> 
            @foreach (var r in PagedReleases)
            {
                <div class="release-item">
                    <div class="release-card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(r.CoverUrl))
                        {
                            <div class="img-box release-thumb">
                                <img src="@r.CoverUrl" alt="@r.Title" />
                            </div>
                        }
                        <div class="release-body p-2 d-flex flex-column">
                            <div class="d-flex align-items-start">
                                <div class="release-title flex-grow-1">@r.Title</div>
                            </div>
                            <div class="release-meta text-muted small mt-2">
                                @if (r.Year.HasValue)
                                {
                                    @r.Year.Value
                                }
                                else
                                {
                                    <em>@L["UnknownYear", "ano desconhecido"]</em>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="d-flex justify-content-end align-items-center mt-2">
            <div class="text-muted small">@L["lblPagina"] @currentPage / @TotalPages</div>
        </div>
    }
}


@code {
    [Parameter, EditorRequired]
    public string ArtistName { get; set; }

    [Parameter, EditorRequired]
    public int PageSize { get; set; } 

    private ArtistReleasesResponseDto? result;

    // loading / error state
    private bool isLoading = true;
    private bool isError = false;
    private string? errorMessage;

    private int currentPage = 1;

    protected override async Task OnParametersSetAsync()
    {
        currentPage = 1;
        await SearchAsync();
    }

    private async Task SearchAsync()
    {
        if (string.IsNullOrWhiteSpace(ArtistName))
        {
            result = null;
            return;
        }

        isLoading = true;
        isError = false;
        errorMessage = null;

        try
        {
           result = await MusicApi.GetLastFMArtistReleasesAsync(ArtistName);
            // clear cached filtered list so it will be recomputed once
            _filteredReleases = null;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ArtistsPublishedTitles.SearchAsync error for '{ArtistName}': {ex}");
            result = null;
            isError = true;
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
            // ensure currentPage is within the bounds after filtering/paging changes
            currentPage = Math.Clamp(currentPage, 1, TotalPages);
        }
    }

    // cache the filtered list to avoid repeated deferred LINQ enumeration during rendering
    private List<ReleaseDto>? _filteredReleases;
    private IEnumerable<ReleaseDto> FilteredReleases =>
        (_filteredReleases ??= (result?.Releases ?? Enumerable.Empty<ReleaseDto>())
            // exclude items without a title or without a cover image
            .Where(r => !string.IsNullOrWhiteSpace(r.Title) && !string.IsNullOrWhiteSpace(r.CoverUrl))
            // remove duplicate titles (case-insensitive), keeping the first occurrence
            .GroupBy(r => r.Title?.Trim() ?? string.Empty, StringComparer.OrdinalIgnoreCase)
            .Select(g => g.First())
            .ToList());

    private int TotalPages
    {
        get
        {
            var count = FilteredReleases.Count();
            if (count == 0) return 1;
            return (int)Math.Ceiling(count / (double)PageSize);
        }
    }

    private IEnumerable<ReleaseDto> PagedReleases => FilteredReleases
        .Skip((currentPage - 1) * PageSize)
        .Take(PageSize);

    private void NextPage()
    {
        if (currentPage < TotalPages) currentPage++;
    }

    private void PrevPage()
    {
        if (currentPage > 1) currentPage--;
    }
}

<style>
    /* Force more columns and override other rules */
.releases-grid {
        display: grid;
        gap: 0.75rem;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        align-items: stretch;
        width: 100%;
    }

/* escaped media queries inside .razor */
@@media (max-width: 768px) {
  .releases-grid { grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)) !important; }
}

    .release-item { display: flex; }

    .release-card {
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .img-box.release-thumb {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        aspect-ratio: 2 / 3;
        max-height: 240px;
        border: 2px solid #ccc;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0,0,0,0.08);
        overflow: hidden;
        background-color: #f9f9f9;
    }

    .img-box.release-thumb img {
            width: 100%;
            height: 100%;
            object-fit: fill;
            object-position: center;
            background-color: #f9f9f9;
            display: block;
        }

    .release-body {
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
    }

    .release-title {
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        word-break: break-word;
        line-height: 1.2;
        max-height: calc(1.2em * 2);
        min-height: calc(1.2em * 2);
    }

    .release-meta { margin-top: auto; }
</style>

@page "/mp3player"

@using Microsoft.AspNetCore.Hosting
@using Microsoft.Extensions.Localization
@using Web.Blazor.Services.ApiWrappers

@inherits MediaPlayer
@implements IDisposable
@inject IMediaServiceWrapper mediaSvc
@inject IWebHostEnvironment hostingEnvironment
@inject IJSRuntime js
@inject IStringLocalizer<App> L


@attribute [Authorize]

@if (mediaExtension.ToLower() == ".mp3" && !string.IsNullOrEmpty(SelectedRecord.FilePath))
{
    <div class="d-flex">
        @*Animation when music is playing*@
        <div class="container">
            <div id="bars-animation" class="loader-container col-md-6 col-lg-6">
                <div class="rectangle-1"></div>
                <div class="rectangle-2"></div>
                <div class="rectangle-3"></div>
                <div class="rectangle-4"></div>
                <div class="rectangle-5"></div>
                <div class="rectangle-6"></div>
                <div class="rectangle-5"></div>
                <div class="rectangle-4"></div>
                <div class="rectangle-3"></div>
                <div class="rectangle-2"></div>
                <div class="rectangle-1"></div>
            </div>

            @*When there's no music, show headphone image'*@
            <div id="myImage" class="image-container">
                <div>
                    <img id="audioImage"
                         src="@mp3CoverServerAddress" />
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-5" style="gap:15px;">
                <SfButton ID="playerPlayBtn" style="font-size:15px; font-weight:400"
                          CssClass="e-btn e-info button p-2"
                          IconCss="fa fa-play fa-5x"
                          @onclick="PlayAudio" Content="@L["Play"]">
                </SfButton>
                <SfButton ID="playerPauseBtn" style="font-size:15px; font-weight:400"
                          CssClass="e-btn e-info button p-2"
                          IconCss="fa fa-pause fa-5x" Disabled="true"
                          @onclick="PauseAudio" Content="@L["Pause"]">
                </SfButton>
                <SfButton ID="playerStopBtn" style="font-size:15px; font-weight:400"
                          CssClass="e-btn e-info button p-2"
                          IconCss="fa fa-stop fa-3x" Disabled="true"
                          @onclick="StopAudio" Content="@L["Stop"]">
                </SfButton>
            </div>
            <div class="mt-5">
                <audio @ref="AudioReference" id="audioPlayer" preload="auto" controls>
                    <source id="audioSource" src="@mp3FullPath" type="audio/mpeg" />
                    @L["BrowserDoesNotSupportAudio"]
                </audio>
            </div>
            <br />
            <div id="stateText" class="px-2"></div>
        </div>
        @if (!string.IsNullOrEmpty(mp3Title))
        {
            <div class="col-sm-12 col-md-6 col-lg-6 player">
                <SfCard>
                    <CardHeader ImageUrl="/images/information-icon.png" Title="@mp3Title" SubTitle="@mp3FirstArtist"></CardHeader>
                    <CardContent EnableSeparator="true">
                        <div class="row">
                            <div class="col-3">
                                <p>@L["Album"]</p>
                                <p>@L["Year"]</p>
                                <p>@L["lblEditora"]</p>
                            </div>
                            <div class="col-9">
                                <p class="font-weight-bold">@mp3Album</p>
                                <p class="font-weight-bold">@mp3EditionYear</p>
                                <p class="font-weight-bold">@mp3Pusblisher</p>
                            </div>
                        </div>
                        <p>@L["Genres"]: </p>
                        @if (mp3Genres is not null)
                        {
                            @foreach (var genero in mp3Genres)
                            {
                                <div class="font-weight-bold">
                                    <SfTextBox Enabled="false" Value="@genero"></SfTextBox>
                                </div>
                            }
                        }
                        @if (sbWikiResponses.Count > 0)
                        {
                            string response = "";
                            <br />
                            <div>
                                <div class="title">@L["Wikipedia"]</div>
                                <div class="underline"></div>
                                <div class="py-2">
                                    @L["References"] @SelectedRecord.Autor
                                </div>
                                <hr />

                                @foreach (string item in sbWikiResponses)
                                {
                                    response += item;
                                }
                                <SfTextBox Value="@response" Multiline=true HtmlAttributes="htmlAttribute"
                                           CssClass="input-control e-corner" />
                            </div>
                        }
                    </CardContent>
                </SfCard>
            </div>
        }
    </div>
}
else
{
    <div class="d-flex flex-column p-2 align-content-center border border-danger">
        <div class="error-message">@L["TitleCannotBeReproduced"] (@SelectedRecord.FormatoMedia)</div>
    </div>
    <hr />
    <div class="d-flex flex-column p-2 align-content-center border border-info">
        <SfCard>
            <CardHeader ImageUrl="/images/media-player.png" Title="@L["AdditionalInformation"]"></CardHeader>
            <CardContent EnableSeparator="true">
                <p>
                    @L["Path"]:
                    @if (!File.Exists(SelectedRecord.FilePath))
                    {
                        <span>@L["NotApplicable"]</span>
                    }
                    else
                    {
                        <span>&nbsp;@SelectedRecord.FilePath</span>
                    }
                </p>
                <p>
                    @L["Url"]:
                    @if (string.IsNullOrEmpty(SelectedRecord.FileUrl))
                    {
                        <span>@L["NotApplicable"]</span>
                    }
                    else
                    {
                        <span>&nbsp;@SelectedRecord.FileUrl</span>
                    }
                </p>
            </CardContent>
        </SfCard>
    </div>
}

@code {
    protected DotNetObjectReference<Mp3Player> mediaPlayer;
    protected ElementReference AudioReference { get; set; }

    private Dictionary<string, object> htmlAttribute { get; set; } = new Dictionary<string, object>()
{
            {"rows", "6" }
    };


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            mediaPlayer = DotNetObjectReference.Create(this);
            await js.InvokeVoidAsync("InitAudio", AudioReference, mediaPlayer);
        }

        // await base.OnAfterRenderAsync(firstRender);
    }

    [JSInvokable]
    public async Task OnEnd()
    {
        mp3FullPath = "";
        await InvokeAsync(StateHasChanged);
    }

    void IDisposable.Dispose()
    {
        mediaPlayer?.Dispose();
    }
}


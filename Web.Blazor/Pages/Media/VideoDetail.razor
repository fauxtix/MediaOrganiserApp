@using MediaOrganizerApp.Domain.Entities

@if (!string.IsNullOrEmpty(TituloVideo))
{
    <div class="title">Video Info</div>
    <div class="underline"></div>
    <br />

    <SfCard>
        <CardHeader Title="@TituloVideo" />           
        <CardContent EnableSeparator="true">
            <div class="py-2 my-2">
                <SfTextBox Readonly="true" Value="@VideoInfo.ChannelTitle" FloatLabelType="FloatLabelType.Always" Placeholder="Canal"></SfTextBox>
            </div>
            @*<div>
        <label class="label-primary py-2">Título</label>
        <SfTextBox Multiline="true" Readonly="true" Value="@VideoInfo.Title"></SfTextBox>
        </div>*@
            <div class="py-2 my-2">
                <SfTextBox @attributes="htmlAttribute"
                           Multiline="true" Readonly="true"
                           Value="@VideoInfo.Description"
                           FloatLabelType="FloatLabelType.Always"
                           Placeholder="Descrição"></SfTextBox>
            </div>
            <div class="py-2 my-2">
                <SfTextBox Readonly="true" Value="@VideoInfo.PublicationDate.ToString()"
                           FloatLabelType="FloatLabelType.Always" Placeholder="Publicado em"></SfTextBox>
            </div>
        </CardContent>
    </SfCard>
}

@code {
    [Parameter]
    public YouTubeVideoDetails VideoInfo { get; set; }
    [Parameter]
    public string TituloVideo { get; set; }

    private Dictionary<string, object> htmlAttribute = new Dictionary<string, object>()
    {
        {"rows", "15" }
    };

}


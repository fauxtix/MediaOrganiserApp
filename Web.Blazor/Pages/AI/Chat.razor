@page "/ai/chat"

@using Microsoft.AspNetCore.SignalR.Client
@using MediaOrganizerApp.Application.DTOs.AI
@inject HttpClient Http
@inject NavigationManager Nav
@using System.Text.Json
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Spinner
@using Syncfusion.Blazor.Notifications
@using Web.Blazor.Components
@inject IJSRuntime JS
@inject Web.Blazor.Services.Common.BooksInfoProgressClient BooksProgressClient
@inject Web.Blazor.Services.ApiWrappers.AiClientService AiClient

<div class="chat-container">
    <div class="chat-header">
        <div class="header-inner">
            <div class="header-title">Chat room</div>
            <SfToast @ref="toastObj"></SfToast>

            <div class="header-actions">
                <div class="conversation-list">
                    <SfDropDownList TValue="string" TItem="ConversationItem"
                                    DataSource="@conversations"
                                    Fields="@convFields"
                                    Placeholder="-- Conversations --"
                                    Value="@selectedConversationId"
                                    ValueChange="OnConversationSelected"
                                    CssClass="conversation-dropdown" />
                </div>

                @if (isProcessing)
                {
                    SpinnerVisible = true;
                }
                else
                {    SpinnerVisible = false;}

                <SfButton CssClass="new-conversation" OnClick="ShowConfirmNewConversation" Title="Start new conversation" AriaLabel="Start new conversation">
                    <span class="sf-btn-icon" aria-hidden="true">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </span>
                    <span class="btn-text">New</span>
                </SfButton>

                <SfButton CssClass="save-conversation" 
                          OnClick="SaveCurrentConversationAsync" 
                          Disabled="@(messages.Count == 0)" 
                          Title="Save current conversation">
                    Save
                </SfButton>
            </div>
        </div>
    </div>

        <div id="spinner-container">
    <SfSpinner Visible="@SpinnerVisible"
                Label="@SpinnerLabel" 
                Type="@SpinnerType.Tailwind"
                CssClass="e-spin-overlay">
    </SfSpinner>
</div>

    <ConfirmAppWarning DialogTitle="Start new conversation"
                       AlertMessage="This will clear the current messages and start a new chat context. Continue?"
                       AlertMessageType="AlertMessageType.Warning"
                       Visible="@showConfirmNewConversation"
                       OnConfirmationYes="@OnConfirmYes"
                       OnConfirmationNo="@OnConfirmNo" />
    <div class="messages" @ref="messagesDiv">
        @foreach (var msg in messages)
        {
            <div class="msg @(msg.Role)">
                @((MarkupString)FormatMessage(msg.Content, msg.Role == "assistant" && currentAssistantMessage == msg))
            </div>
        }
    </div>

    <div class="input-area">
        <div class="input-inner">
            <textarea class="chat-input"
                      @bind="userInput"
                      @ref="chatInputRef"
                      placeholder="Escreve mensagem..."
                      disabled="@(isConnecting || connectionId == null)"
                      aria-label="Chat message input"></textarea>

            <button class="send-button" @onclick="Send" disabled="@(isConnecting || connectionId == null)" title="Send message">
                Enviar
            </button>
        </div>

        @if (isConnecting)
        {
            <div class="connection-status" title="Connecting to progress hub...">
                <span class="spinner" aria-hidden="true"></span>
                <span class="status-text">Connecting...</span>
            </div>
        }
        else if (connectionId == null)
        {
            <div class="connection-status disconnected" title="Not connected">
                <span class="status-text">Not connected</span>
            </div>
        }
    </div>
</div>


<style>
    .chat-container {
        display: flex;
        flex-direction: column;
        height: calc(100vh - 56px);
    }

    .chat-header {
        position: sticky;
        top: 0;
        background: #fff;
        z-index: 10;
        border-bottom: 1px solid #eee;
    }

    .header-inner {
        max-width: 1000px;
        margin: 0 auto;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 16px;
    }

    .messages {
        flex: 1;
        overflow-y: auto;
        padding: 12px;
        display: flex;
        flex-direction: column;
    }

    .msg {
        max-width: 70%;
        padding: 10px;
        margin: 5px;
        border-radius: 12px;
    }

        .msg.user {
            align-self: flex-end;
            background: #007bff;
            color: white;
        }

        .msg.assistant {
            align-self: flex-start;
            background: #e5e5ea;
        }

    .input-area {
        position: sticky;
        bottom: 0;
        background: #fff;
        padding: 12px;
        border-top: 1px solid #eee;
    }

    .input-inner {
        display: flex;
        gap: 12px;
    }

    .chat-input {
        flex: 1;
        padding: 10px;
        border-radius: 10px;
    }

    .send-button {
        padding: 10px 14px;
        border-radius: 10px;
        background: #007bff;
        color: white;
        border: none;
    }

    .cursor {
        display: inline-block;
        width: 8px;
        animation: blink 1s step-start infinite;
        color: #007bff;
    }
    @@keyframes blink {
        50% {
            opacity: 0;
        }
    }

</style>

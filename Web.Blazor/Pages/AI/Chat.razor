@page "/ai/chat"

@using Markdig
@inject NavigationManager Nav
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Spinner
@using Syncfusion.Blazor.Notifications
@using Web.Blazor.Components
@inject Web.Blazor.Services.ApiWrappers.AiClientService AiClient

<div class="chat-container">
    <div class="chat-header">
        <div class="header-inner">
            <div class="header-title">Chat room</div>
            <div class="header-actions">
                @* <div class="token-bar-container">
                    <div class="token-bar-fill @GetTokenClass()" style="width:@GetTokenPercent()%"></div>
                </div>
                <div class="token-bar-label">
                    @tokensEstimados / @limiteTokens
                    <span style="margin-left:10px;">Usados: @tokensUsados</span>
                </div> *@

                <div class="token-bar-container">
                    <div class="token-bar-fill @GetTokenClass()" style="width:@GetTokenPercent()%"></div>
                </div>

                <div class="token-bar-label">
                    @if (isProcessing)
                    {
                        <span>Estimados: @tokensEstimados / @limiteTokens</span>
                    }
                    else
                    {
                        <span>Usados: @tokensUsados / @limiteTokens</span>
                    }
                </div>
                @if (ShowTokenWarning)
                {
                    <div class="token-warning @GetWarningClass()">
                        ⚠️ Atenção: estás a aproximar-te do limite de contexto.
                    </div>
                }
                <div>@modeloAtual</div>
                <div class="conversation-list">
                    <SfDropDownList TValue="string" TItem="ConversationItem"
                                    DataSource="@conversations"
                                    @bind-Value="selectedConversationId"
                                    Placeholder="@Localizer["Conversations"]"
                                    CssClass="conversation-dropdown">
                        <DropDownListFieldSettings Text="Title" Value="Id" />
                        <DropDownListEvents TItem="ConversationItem"
                                            TValue="string"
                                            ValueChange="OnConversationChanged" />
                    </SfDropDownList>
                </div>

                <SfButton CssClass="new-conversation" OnClick="ShowConfirmNewConversation">
                    <span class="sf-btn-icon">
                        <svg width="16" height="16" viewBox="0 0 24 24">
                            <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2"
                                  stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </span>
                    <span class="btn-text">@Localizer["NewMsg"]</span>
                </SfButton>

                <SfButton CssClass="delete-conversation"
                          OnClick="ShowConfirmDeleteConversation"
                          Disabled="@string.IsNullOrEmpty(selectedConversationId)"
                          Content="@Localizer["DeleteMsg"]" />
            </div>
        </div>
    </div>

    <div class="messages" @ref="messagesDiv" @onscroll="OnScroll">
        @foreach (var msg in messages)
        {
            <div class="msg @(msg.Role)">
                @((MarkupString)FormatMessage(msg.Content, msg == currentAssistantMessage))
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(ProgressStatus))
        {
            <div class="msg assistant assistant-status">
                <span class="status-text">@((MarkupString)FormatMessage(ProgressStatus, false))</span>
                <span class="dots"><span></span><span></span><span></span></span>
            </div>
        }
    </div>

    <div class="input-area">
        <div class="input-inner">
            <textarea class="chat-input"
                      style="@InputStyle"
                      @bind="userInput"
                      @ref="chatInputRef"
                      @onkeydown="HandleKeyDown"
                      placeholder="@Localizer["TypeMessage"]"
                      disabled="@isConnecting"></textarea>

            <div class="send-controls">
                <button class="chat-action-button"
                        @onclick="@(isProcessing ? CancelSend : Send)"
                        disabled="@isConnecting">
                    @if (isProcessing)
                    {
                        <span class="stop-icon"></span>
                    }
                    else
                    {
                        <span class="fa fa-paper-plane"></span>
                    }
                </button>
            </div>
        </div>
    </div>
</div>

@if (ShowSpinnerOverlay)
{
    <div class="global-spinner-overlay">
        <div class="spinner-container">
            <SfSpinner Visible="true" Label="@SpinnerLabel" Type="@SpinnerType.Tailwind" />
        </div>
    </div>
}

<ConfirmAppWarning DialogTitle="@Localizer["StartNewConversation"]"
                   AlertMessage="@Localizer["StartNewConversationMessage"]"
                   AlertMessageType="AlertMessageType.Warning"
                   Visible="@showConfirmNewConversation"
                   OnConfirmationYes="@OnConfirmYes"
                   OnConfirmationNo="@OnConfirmNo" />

<ConfirmAppWarning DialogTitle="@Localizer["ChatDeleteMessasagesTitle"]"
                   AlertMessage="@Localizer["ChatDeleteMessage"]"
                   AlertMessageType="AlertMessageType.Warning"
                   Visible="@showConfirmDeleteConversation"
                   OnConfirmationYes="@OnConfirmDeleteYes"
                   OnConfirmationNo="@OnConfirmDeleteNo" />

<SfToast @ref="toastObj"
         Title="@ToastTitle"
         Content="@ToastContent"
         CssClass="@ToastCssClass"
         Timeout="@ToastTimeOut"
         ShowCloseButton="true">
    <ToastPosition X="right" Y="bottom" />
</SfToast>


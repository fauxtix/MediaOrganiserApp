@page "/ai/chat"

@using Microsoft.AspNetCore.SignalR.Client
@using MediaOrganizerApp.Application.DTOs.AI
@inject NavigationManager Nav
@using System.Text.Json
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Spinner
@using Syncfusion.Blazor.Notifications
@using Web.Blazor.Components
@inject Web.Blazor.Services.ApiWrappers.AiClientService AiClient

<div class="chat-container">
    <div class="chat-header">
        <div class="header-inner">
            <div class="header-title">Chat room</div>
            <div class="header-actions">
                <div class="conversation-list">
                    <SfDropDownList TValue="string" TItem="ConversationItem"
                                    DataSource="@conversations"
                                    @bind-Value="selectedConversationId"
                                    Placeholder="-- Conversations --"
                                    CssClass="conversation-dropdown">
                        <DropDownListFieldSettings Text="Title" Value="Id" />
                        <DropDownListEvents TItem="ConversationItem" TValue="string" ValueChange="OnConversationChanged" />
                    </SfDropDownList>
                </div>

                <SfButton CssClass="new-conversation" OnClick="ShowConfirmNewConversation" AriaLabel="Start new conversation">
                    <span class="sf-btn-icon" aria-hidden="true">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </span>
                    <span class="btn-text">New</span>
                </SfButton>

                <SfButton CssClass="delete-conversation"
                          OnClick="ShowConfirmDeleteConversation"
                          Disabled="@(string.IsNullOrEmpty(selectedConversationId))"
                          Content="Delete">
                </SfButton>
            </div>
        </div>
    </div>


    <div class="messages" @ref="messagesDiv">
        @foreach (var msg in messages)
        {
            <div class="msg @(msg.Role)">
                @((MarkupString)FormatMessage(msg.Content, msg.Role == "assistant" && currentAssistantMessage == msg))
            </div>
        }

        @* Place the progress/status message inside the messages area so it's near the expected reply *@
        @if (!string.IsNullOrWhiteSpace(ProgressStatus))
        {
            <div class="msg assistant assistant-status" aria-live="polite">
                <span class="status-text">@((MarkupString)FormatMessage(ProgressStatus, false))</span>
                <span class="dots" aria-hidden="true"><span></span><span></span><span></span></span>
            </div>
        }
    </div>

    <div class="input-area">
        <div class="input-inner">
            <textarea class="chat-input"
                      @bind="userInput"
                      @ref="chatInputRef"
                      placeholder="Escreve mensagem..."
                      disabled="@(isConnecting)"
                      aria-label="Chat message input"></textarea>

            <div class="send-controls">
                <button class="chat-action-button"
                        @onclick="@(isProcessing ? CancelSend : Send)"
                        disabled="@isConnecting">

                    @if (isProcessing)
                    {
                        <span class="stop-icon"></span>
                    }
                    else
                    {
                        <span class="fa fa-paper-plane" />
@*                         <svg width="18" height="18"
                             viewBox="0 0 24 24"
                             fill="none"
                             xmlns="http://www.w3.org/2000/svg">
                            <path d="M5 12L19 12M19 12L13 6M19 12L13 18"
                                  stroke="currentColor"
                                  stroke-width="2"
                                  stroke-linecap="round"
                                  stroke-linejoin="round" />
                        </svg>
 *@                    }
                </button>
            </div>
        </div>
    </div>
</div>

@if (ShowSpinnerOverlay)
{
    <div class="global-spinner-overlay">
        <div class="spinner-container">
            <SfSpinner Visible="true"
                       Label="@SpinnerLabel"
                       Type="@SpinnerType.Tailwind">
            </SfSpinner>
        </div>
    </div>
}

<ConfirmAppWarning DialogTitle="Start new conversation"
                   AlertMessage="This will clear the current messages and start a new chat context. Continue?"
                   AlertMessageType="AlertMessageType.Warning"
                   Visible="@showConfirmNewConversation"
                   OnConfirmationYes="@OnConfirmYes"
                   OnConfirmationNo="@OnConfirmNo" />
<ConfirmAppWarning DialogTitle="Delete conversation"
                   AlertMessage="This will permanently delete the selected conversation. Continue?"
                   AlertMessageType="AlertMessageType.Warning"
                   Visible="@showConfirmDeleteConversation"
                   OnConfirmationYes="@OnConfirmDeleteYes"
                   OnConfirmationNo="@OnConfirmDeleteNo" />

<div>
    <SfToast @ref="toastObj"
             Title="@ToastTitle"
             Content="@ToastContent"
             CssClass="@ToastCssClass"
             Timeout="@ToastTimeOut" ShowCloseButton="true">
        <ToastPosition X="right" Y="bottom"></ToastPosition>
    </SfToast>
</div>

<style>
    .chat-container {
        margin: 0 !important;
        padding: 0 !important;
        display: flex;
        flex-direction: column;
        height: calc(100vh - 64px);
        overflow: hidden;
        position: relative;
        top: 0;
    }

    /* HEADER */
    .chat-header {
        flex: 0 0 auto;
        background: #fff;
        z-index: 10;
        border-bottom: 1px solid #eee;
    }

    /* HEADER LAYOUT */
    .header-inner {
        width: 100%;
        max-width: none;
        margin: 0;
        display: flex;
        justify-content: flex-start;
        align-items: center;
        padding: 6px 16px;
        box-sizing: border-box;
    }

    .header-title {
        text-align: left;
        padding-left: 8px;
        padding-right: 12px;
        flex: 0 0 auto;
        margin: 0;
        font-weight: 600;
    }

    .header-actions {
        display: flex;
        gap: 12px;
        align-items: center;
        margin-left: auto;
    }

    /* MESSAGES (ÚNICO SCROLL) */
    .messages {
        flex: 1;
        overflow-y: auto;
        padding: 12px;
        min-height: 0;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
        align-items: stretch;
    }

    /* MESSAGE BUBBLES */
    .msg {
        max-width: 70%;
        padding: 8px;
        font-size: 0.8rem;
        margin: 4px 5px;
        border-radius: 12px;
    }

        .msg.user {
            align-self: flex-end;
            background: #007bff;
            color: white;
        }

        .msg.assistant {
            align-self: flex-start;
            background: #e5e5ea;
        }

    /* INPUT AREA FIXA (SEM STICKY) */
    .input-area {
        flex: 0 0 auto;
        background: #fff;
        padding: 12px;
        border-top: 1px solid #eee;
    }

    /* INPUT LAYOUT */
    .input-inner {
        display: flex;
        gap: 12px;
        align-items: flex-start;
    }

    .chat-input {
        flex: 1;
        padding: 10px;
        border-radius: 10px;
        font-size: 0.8rem;
        min-height: 40px;
        max-height: 220px;
        resize: vertical;
        overflow: auto;
        box-sizing: border-box;
    }

    /* BUTTON */
    .send-button {
        padding: 0 14px;
        border-radius: 10px;
        background: #007bff;
        color: white;
        border: none;
        height: 40px;
        min-width: 72px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        align-self: flex-start;
    }

    /* DROPDOWN */
    .conversation-list {
        display: inline-block;
        margin-right: 12px;
        vertical-align: middle;
    }

    .conversation-dropdown {
        min-width: 300px;
        max-width: 360px;
        width: 100%;
        box-sizing: border-box;
    }

    /* CURSOR */
    .cursor {
        display: inline-block;
        width: 8px;
        animation: blink 1s step-start infinite;
        color: #007bff;
    }

    @@keyframes blink {
        50% {
            opacity: 0;
        }
    }

    /* SPINNER */
    .spinner-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.5);
        z-index: 9999;
        animation: fadeIn 0.2s ease-in-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    #spinner-container {
        display: none;
    }

    .global-spinner-overlay {
        position: fixed;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        pointer-events: none;
        z-index: 9999;
    }

        .global-spinner-overlay .spinner-container {
            pointer-events: auto;
            background: rgba(255,255,255,0.85);
            padding: 10px;
            border-radius: 8px;
        }

    /* STATUS (ASSISTANT TYPING) */
    .assistant-status {
        margin-left: 12px;
        color: #666;
        font-size: 0.8rem;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .assistant-status .dots {
            display: inline-flex;
            gap: 6px;
            align-items: center;
            margin-left: 6px;
        }

            .assistant-status .dots span {
                width: 6px;
                height: 6px;
                background: #666;
                border-radius: 50%;
                opacity: 0.25;
                animation: assistant-dot 1000ms ease-in-out infinite;
            }

                .assistant-status .dots span:nth-child(1) {
                    animation-delay: 0ms;
                }

                .assistant-status .dots span:nth-child(2) {
                    animation-delay: 160ms;
                }

                .assistant-status .dots span:nth-child(3) {
                    animation-delay: 320ms;
                }

    @@keyframes assistant-dot {
        0% {
            opacity: 0.25;
            transform: translateY(0);
        }

        50% {
            opacity: 1;
            transform: translateY(-4px);
        }

        100% {
            opacity: 0.25;
            transform: translateY(0);
        }
    }

    /* SEND CONTROLS */
    .send-controls {
        display: inline-flex;
        gap: 8px;
        align-items: center;
    }

    .chat-action-button {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        border: solid 0.08em #000;
        background-color: transparent;
        color: black;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all .2s ease;
    }

        .chat-action-button:hover {
            transform: scale(1.05);
        }

        .chat-action-button:disabled {
            opacity: .5;
            cursor: not-allowed;
        }

    /* Ícone STOP */
    .stop-icon {
        width: 12px;
        height: 12px;
        background: #ff3b30;
        border-radius: 2px;
    }
</style>
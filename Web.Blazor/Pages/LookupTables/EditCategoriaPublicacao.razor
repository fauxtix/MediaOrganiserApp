@using Microsoft.Extensions.Localization;
@using Web.Blazor.Components
@inject IStringLocalizer<App>  localizerApp

@attribute [Authorize]

<div class="row">
    <div class="col-9">
        @if (blnEdit)
        {
            <div class="form-group">
                <SfTextBox Enabled="false" Placeholder="ID#" Width="60px"
                           CssClass="input-control e-corner center-text"
                           FloatLabelType="@FloatLabelType.Auto"
                           Value="@SelectedRecord.Id.ToString()">
                </SfTextBox>
            </div>
        }
        <div class="form-group">
            <SfTextBox Enabled="true" 
                       Placeholder="@(localizerApp["rbtDescricao"])"
                       CssClass="input-control e-corner"
                       FloatLabelType="@FloatLabelType.Auto"
                       @bind-Value="@SelectedRecord.Descricao">
            </SfTextBox>
        </div>
    </div>
    <RightSideImageComponent Operation="@(blnEdit?AppDefinitions.OpcoesRegisto.Gravar:AppDefinitions.OpcoesRegisto.Inserir)" />
</div>

    @code {

        [Parameter]
        public CategoryVM SelectedRecord { get; set; }

        [Parameter]
        public bool blnEdit { get; set; }
    }

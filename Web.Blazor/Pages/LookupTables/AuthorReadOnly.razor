@using MediaOrganizerApp.Application.DTOs
@using Ganss.Xss
@using MediaOrganizerApp.Application.Interfaces.Services.Api
@using Microsoft.AspNetCore.Components
@inject IAutorService AutorService
@inject ILogger<AuthorReadOnly> Logger


<div class="author-readonly card p-2">
    @if (author is null)
    {
        <div class="text-muted">Autor não carregado.</div>
    }
    else
    {
        <div class="row">
            <div class="col-md-4 text-center h-100">
                @if (authorHasImage)
                {
                    <div class="img-box portrait">
                        <img src="@author.ImagemAutor" width="320" height="240"
                             alt="@author.Descricao" />
                    </div>
                }
                else
                {
                    <div class="img-box portrait">
                        <img src="images/NoPhoto.png" alt="Sem imagem" width="320" height="240" />
                    </div>
                }
            </div>
            <div class="col-md-8">
                <h5 class="mb-1">@author.Descricao</h5>
                <div class="author-sobre">
                    @if (!string.IsNullOrWhiteSpace(sanitizedSobre))
                    {
                        @((MarkupString)sanitizedSobre)
                    }
                    else
                    {
                        <div class="text-muted">Sem descrição.</div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private AutorDTO? author;
    private string sanitizedSobre = string.Empty;
    [Parameter]
    public int AuthorId { get; set; }

    private bool authorHasImage;

    protected override async Task OnParametersSetAsync()
    {
        if (AuthorId <= 0)
        {
            author = null;
            sanitizedSobre = string.Empty;
            return;
        }

        try
        {
            author = await AutorService.GetAuthorsById(AuthorId);
            sanitizedSobre = SanitizeHtml(author?.Sobre);
            authorHasImage = !string.IsNullOrWhiteSpace(author?.ImagemAutor) &&
                !(author.ImagemAutor?.ToLower().Contains("no-image") ?? false) &&
                !(author.ImagemAutor?.ToLower().Contains("noimage") ?? false);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading author {AuthorId}", AuthorId);
            author = null;
            sanitizedSobre = string.Empty;
        }
    }

    private string SanitizeHtml(string? html)
    {
        if (string.IsNullOrWhiteSpace(html)) return string.Empty;
        var sanitizer = new HtmlSanitizer();
        sanitizer.AllowedAttributes.Add("class");
        sanitizer.AllowedAttributes.Add("target");
        sanitizer.AllowedAttributes.Add("rel");
        sanitizer.AllowedSchemes.Add("http");
        sanitizer.AllowedSchemes.Add("https");
        return sanitizer.Sanitize(html);
    }
}

<style>
    .img-box.portrait {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        height: 100%;
        border: 2px solid #ccc;
        border-radius: 10px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
        overflow: hidden;
        background-color: #f9f9f9;
    }

        .img-box.portrait img {
            max-width: 100%;
            max-height: 100%;
            object-fit: cover;
        }
</style>
@page "/formatosmedia"

@using Syncfusion.Blazor.Spinner
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Notifications
@using Syncfusion.Blazor.Navigations
@using Syncfusion.Blazor.Data
@using Web.Blazor.Components
@using Web.Blazor.Pages.BaseComponents
@using Web.Blazor.Pages.Tools
@using Web.Blazor.Services.ApiWrappers
@using MediaOrganizerApp.Application.DTOs.AI

@*@inject IFormatos_MediaService formatosMediaService*@

@inherits FormatosMediaBase

@attribute [Authorize]

@{
    var Tool = (new List<object>()
{
            "Search",
            new ItemModel() {
                PrefixIcon = "fa fa-times",
                TooltipText = "Clear",
                Align = ItemAlign.Right,
                Id = "Clear"
            }
        }
         );
}
<div class="title">@(localizerApp["frmFormatos"]) (Media)</div>
<div class="underline"></div>
<br />

@if (formatos == null || !formatos.Any())
{
    <div class="spinner-border" role="status">
        <span class="sr-only">@localizerApp["LoadingMsg"]</span>
    </div>
}
else
{
    <div class="col-lg-12 control-section">
        <div class="content-wrapper">
            <div class="row">
                <div class="e-dddata">
                    <SfButton CssClass="e-btn e-success e-round-corner"
                              IconCss="fa fa-plus"
                              IsPrimary="true"
                              @onclick="NotifyAddingRecord">
                        &nbsp;@(localizerApp["NewMsg"])&nbsp;@(localizerApp["Record"])
                    </SfButton>
                    <br /><br />
                </div>
                <hr>
                <div id="target" class="table table-responsive overflow-auto table-striped">
                    <SfGrid @ref="gridObj"
                            Height="100%"
                            Width="70%"
                            DataSource="@formatos"
                            AllowFiltering="false"
                            AllowGrouping="false"
                            Toolbar="@Tool"
                            AllowPaging="true"
                            AllowSorting="true"
                            RowHeight="32"
                            AllowTextWrap="true">
                        <GridPageSettings PageSize="9"></GridPageSettings>
                        <GridEvents OnToolbarClick="OnToolbarClick"
                                    CommandClicked="OnCommandClicked"
                                    TValue="FormatoMediaVM"></GridEvents>
                        <GridTemplates>
                            <DetailTemplate>
                                <SfTab Height="240" HeaderPlacement="HeaderPosition.Top">
                                    <TabItems>
                                        <TabItem>
                                            <ChildContent>
                                                <TabHeader Text="@(localizerApp["MSG_PubsCatalogadas"])"></TabHeader>
                                            </ChildContent>
                                            <ContentTemplate>
                                                @{
                                                    var formato = (context as FormatoMediaVM);
                                                    var MediaCatalogadas = GetMediaCatalogadas(formato.Id);
                                                }
                                                <div style="padding:25px">
                                                    <SfGrid Width="100%" DataSource="@MediaCatalogadas"
                                                            AllowSorting="true" AllowPaging="true">
                                                        <GridPageSettings PageSize="8"></GridPageSettings>
                                                        <GridEvents CommandClicked="OnPdfButtonClicked" TValue="MediaVM"></GridEvents>
                                                        <GridColumns>
                                                            <GridColumn Field=@nameof(MediaVM.FileName) HeaderText="Título" Width="220"></GridColumn>
                                                            <GridColumn Field=@nameof(MediaVM.Autor) HeaderText="Autor" Width="150"></GridColumn>
                                                        </GridColumns>
                                                    </SfGrid>
                                                </div>
                                            </ContentTemplate>
                                        </TabItem>
                                    </TabItems>
                                </SfTab>
                            </DetailTemplate>
                        </GridTemplates>
                        <GridColumns>
                            <GridColumn Field=@nameof(FormatoMediaVM.Id)
                                        HeaderText="ID#" IsPrimaryKey="true" Visible="false"
                                        AllowSorting="true" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Center"
                                        Width="60"></GridColumn>
                            <GridColumn Field=@nameof(FormatoMediaVM.Descricao) HeaderText=@(localizerApp["rbtDescricao"])
                                        Width="150"></GridColumn>
                            <GridColumn HeaderText="" AllowFiltering="false" AllowSorting="false" TextAlign="Syncfusion.Blazor.Grids.TextAlign.Left" Width="50">
                                <GridCommandColumns>
                                    <GridCommandColumn Type=CommandButtonType.Edit
                                                       ButtonOption="@(new CommandButtonOptions()
                                                                                               {
                                                                                                   CssClass = "e-btn e-primary e-round",
                                                                                                   IconCss = "fa fa-edit",
                                                                                                   IconPosition = @IconPosition.Left
                                                                                               })">
                                    </GridCommandColumn>
                                    <GridCommandColumn Type=CommandButtonType.Delete
                                                       ButtonOption="@(new CommandButtonOptions()
                                                                                               {
                                                                                                   CssClass = "e-btn e-danger e-round",
                                                                                                   IconCss = "fa fa-trash",
                                                                                                   IconPosition = @IconPosition.Left
                                                                                               })">
                                    </GridCommandColumn>
                                </GridCommandColumns>
                            </GridColumn>

                        </GridColumns>
                    </SfGrid>
                </div>
            </div>
        </div>
    </div>
    <SfDialog Target="#target"
              Width="450px"
              Height="auto"
              IsModal="true"
              ShowCloseIcon="true"
              @bind-Visible="EditDialogVisibility">
        <DialogTemplates>
            <Header>
                <div>
                    @if (blnEdit)
                    {
                        <p>@localizerApp["editionMsg"]</p>
                    }
                    else
                    {
                        <p>@localizerApp["NewMsg"]</p>
                    }
                </div>
            </Header>
            <Content>
                <EditFormatosMedia SelectedRecord="@SelectedRecord" blnEdit="@blnEdit" />
            </Content>
            <FooterTemplate>
                <!-- Layout: translate button left, others right -->
                <div class="modal-footer footer-with-sides">
                    <div class="left-actions">
                        @if (blnEdit && !string.IsNullOrWhiteSpace(SelectedRecord?.Descricao))
                        {
                            <SfButton CssClass="e-btn e-info e-round-corner translate-btn"
                                      IconCss="fa fa-language"
                                      Content="@localizerApp["TituloTraduzir"]"
                                      @onclick="() => showTranslateModal = true" />
                        }
                    </div>

                    <div class="right-actions">
                        <SfButton CssClass="e-btn e-primary e-round-corner"
                                  IconCss="fa fa-edit"
                                  @onclick="AddOrSaveRecord">
                            &nbsp;@(localizerApp["btnSalvar"])
                        </SfButton>

                        <SfButton CssClass="e-btn e-outline e-round-corner"
                                  IconCss="fa fa-times"
                                  @onclick="Voltar">
                            &nbsp;@(localizerApp["BtnSalir"])
                        </SfButton>
                    </div>
                </div>
            </FooterTemplate>
        </DialogTemplates>
        <DialogAnimationSettings Effect="@Effects" Duration=400></DialogAnimationSettings>
    </SfDialog>
    <SfDialog @bind-Visible="@DeleteRecordConfirmVisibility"
              Width="450px" Height="auto"
              ShowCloseIcon="false">
        <DialogTemplates>
            <Header>
                <div class="text-wrap">
                    @(localizerApp["lblFormato"]): @SelectedRecord.Descricao
                </div>
            </Header>
            <Content>
                <div class="row">
                    <div class="col-9">
                        <AlertMessage Message="@(localizerApp["ConfirmarExclusao"])" MessageType="AlertMessageType.Error"></AlertMessage>
                    </div>
                    <RightSideImageComponent Operation="@(AppDefinitions.OpcoesRegisto.Apagar)" />
                </div>
            </Content>
            <FooterTemplate>
                <div class="e-footer">
                    <SfButton CssClass="e-btn e-danger e-round-corner" IconCss="fa fa-trash"
                              @onclick="ConfirmDeleteYes">
                        &nbsp;@(localizerApp["Sim"])
                    </SfButton>
                    <SfButton CssClass="e-btn e-outline e-round-corner" IconCss="fa fa-times"
                              @onclick="ConfirmDeleteNo">
                        &nbsp;@(localizerApp["Nao"])
                    </SfButton>
                </div>
            </FooterTemplate>
        </DialogTemplates>
        <DialogAnimationSettings Effect="@Effects" Duration=400></DialogAnimationSettings>
    </SfDialog>
    <SfDialog Target="#target"
              Width="400px"
              Height="300x"
              IsModal="true"
              ShowCloseIcon="false"
              @bind-Visible="ValidationErrorsVisibility">
        <DialogTemplates>
            <Header>
                <div class="alert-warning">
                    @(localizerApp["DadosEmFalta"]).
                </div>
            </Header>
            <Content>
                <div class="border-warning">
                    <div>
                        Formato: @SelectedRecord.Descricao
                        <br />
                    </div>
                    <div>
                        @pubsCatalogadas.ToString()&nbsp;@(localizerApp["RegistosCatalogados"])
                    </div>
                    <div class="border-warning">
                        <br />
                        @(localizerApp["OperacaoCancelada"])
                    </div>
                </div>
            </Content>
            <FooterTemplate>
                <div class="button-container">
                    <SfButton CssClass="e-btn e-outline e-round-corner"
                              @onclick="closeAlertBox">
                        @(localizerApp["btnFechar"])
                    </SfButton>
                </div>
            </FooterTemplate>
        </DialogTemplates>
        <DialogAnimationSettings Effect="@Effects" Duration=400></DialogAnimationSettings>
    </SfDialog>

    <SfDialog Target="#target"
              Width="600px"
              Height="300x"
              IsModal="true"
              ShowCloseIcon="false"
              @bind-Visible="ErrorVisibility">
        <DialogTemplates>
            <Header>
                @(localizerApp["DadosEmFalta"])
            </Header>
            <Content>
                <AlertMessage Message="@sErrorMsgs" MessageType="AlertMessageType.Warning"></AlertMessage>
            </Content>
            <FooterTemplate>
                <div class="modal-footer">
                    <SfButton CssClass="e-btn e-outline e-round-corner"
                              IconCss="fa fa-times"
                              @onclick="closeErrorBox">
                        &nbsp;@(localizerApp["btnFechar"])
                    </SfButton>
                </div>
            </FooterTemplate>
        </DialogTemplates>
        <DialogAnimationSettings Effect="@Effects" Duration=400></DialogAnimationSettings>
    </SfDialog>

    <SfDialog Height="60%" Width="90%"
              IsModal="true"
              ShowCloseIcon="true"
              CssClass="sidebar" AllowDragging="true"
              @bind-Visible="ReadPdfVisibility">
        <DialogTemplates>
            <Header>
            </Header>
            <Content>
                <ReadPDF PdfFile="@DigitalPath" />
            </Content>
            <FooterTemplate>
                <div>
                    <SfButton CssClass="e-btn e-outline e-round-corner"
                              @onclick="()=>ReadPdfVisibility = false">
                        &nbsp;@(localizerApp["btnFechar"])
                    </SfButton>
                </div>
            </FooterTemplate>
        </DialogTemplates>
        <DialogAnimationSettings Effect="@Effects" Duration=400></DialogAnimationSettings>
    </SfDialog>

    <TranslateText Visible="@showTranslateModal"
                   InitialText="@SelectedRecord.Descricao"
                   InitialSourceLanguage="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName"
                   InitialTargetLanguage="en"
                   TranslateFunc="@(TranslateClient.TranslateAsync)"
                   OnTranslateRequested="OnTranslateApplied"
                   OnClose="@(()=> showTranslateModal = false)" />

    <SfToast @ref="ToastObj"
             Title="@ToastTitle"
             Content="@ToastContent"
             CssClass="@ToastCssClass"
             Timeout="1500" ShowCloseButton="true">
        <ToastPosition X="Right" Y="Bottom"></ToastPosition>
    </SfToast>

    <SfSpinner @ref="SpinnerObj"
               Label="@localizerApp["LoadingMsg"]"
               Type="@SpinnerType.Bootstrap4"
               CssClass="e-spin-overlay">
    </SfSpinner>

    <style>
        .footer-with-sides {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.5rem;
        }

        .footer-with-sides .left-actions {
            flex: 0 0 auto;
        }

        .footer-with-sides .right-actions {
            display: flex;
            gap: 0.5rem;
            flex: 0 0 auto;
        }

        .footer-with-sides .e-btn {
            white-space: nowrap;
        }
    </style>

    @code {
        [Inject] TranslateClientService TranslateClient { get; set; }

        protected bool showTranslateModal { get; set; }

        protected async Task OnTranslateApplied(TranslateRequestDto dto)
        {
            if (dto is null || string.IsNullOrWhiteSpace(dto.Text))
                return;

            SelectedRecord.Descricao = dto.Text;
            showTranslateModal = false;
            StateHasChanged();
            await Task.CompletedTask;
        }
    }
}

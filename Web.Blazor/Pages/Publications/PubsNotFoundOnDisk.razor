@page "/pubsnotfoundondisk"
@using MediaOrganizerApp.Application.Interfaces.Services.Api
@using Microsoft.Extensions.Localization
@using Web.Blazor.Components
@if (FilesNotFound is null || FilesNotFound.Count == 0)
{
    <LoadingData />
}
else
{
    <div>
        <h3>Publicações não encontradas no disco (@FilesNotFound.Count)</h3>
        <hr />

        <SfBreadcrumb>
            <BreadcrumbItems>
                <BreadcrumbItem Text="Home" IconCss="e-icons e-home" Url="/" />
                <BreadcrumbItem Text="Publications" Url="/publicacoes" />
                <BreadcrumbItem Text= "Pubs not found on disk" Url="/pubsnotfoundondisk" />
            </BreadcrumbItems>
        </SfBreadcrumb>
        <hr />

        <div class="container-fluid mt-2">
            <div class="row">
                @foreach (var file in FilesNotFound)
                {
                    string directoryPath = Path.GetDirectoryName(file.DigitalPath);
                    DirectoryInfo directoryInfo = new DirectoryInfo(directoryPath);
                    string lastSubFolder = directoryInfo.Name;
                    <div class="col-md-6 col-lg-3 col-sm-12">
                        <SfCard CssClass="teste my-1">
                            <CardHeader Title="@file.Id.ToString()"
                                        SubTitle="@file.FileName" />
                            <CardContent EnableSeparator="true">
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="row mt-2">
                                            <div class="col-md-3">
                                                <div class="text-center"><b>Edição</b></div>
                                                <div class="mt-2 text-center">@file.Edition</div>
                                            </div>
                                            <div class="col-md-3">
                                                <div class="text-center"><b>Páginas</b></div>
                                                <div class="mt-2 text-center">@file.Pages</div>
                                            </div>
                                            <div class="col-md-6">
                                                <div><b>Pasta</b></div>
                                                <div class="text-ellipsis mt-2">@lastSubFolder</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </CardContent>
                            <CardFooter>
                                <CardFooterContent>
                                    <hr />
                                    <div class="options-buttons-container">
                                        <SfButton IconCss="fa fa-edit" CssClass="e-btn e-primary e-round-corner"
                                                  @onclick="@( async ()=>await ShowPublication(file.Id))"
                                                  Content="Edit"></SfButton>
                                        <SfButton IconCss="fa fa-trash" CssClass="e-btn e-danger e-round-corner" Content="Delete"></SfButton>
                                    </div>
                                </CardFooterContent>
                            </CardFooter>
                        </SfCard>
                    </div>
                    <br />
                }
            </div>
        </div>
    </div>
}

<SfDialog Width="900px"
          Height="800px"
          IsModal="true"
          MinHeight="700px"
          ShowCloseIcon="false"
          @bind-Visible="EditDialogVisibility">
    <DialogTemplates>
        <Header>
            <div class="modal-header">
                <h5 class="modal-title">
                    @SelectedRecord.Titulo
                </h5>
            </div>
        </Header>
        <Content>
            <EditPublicacoes SelectedRecord="@SelectedRecord" CurrentCategory="@SelectedRecord.IdCategoria" blnEdit="true" />
        </Content>
        <FooterTemplate>
            <div>
                <SfButton CssClass="e-btn e-outline e-round-corner"
                          IconCss="fa fa-times"
                          @onclick="@(()=>EditDialogVisibility = false)" Content="@(L["BtnSalir"])">
                </SfButton>
            </div>
        </FooterTemplate>
    </DialogTemplates>
    <DialogAnimationSettings Effect="@Effects" Duration=400></DialogAnimationSettings>
</SfDialog>


@code {
    [Inject] public IPublicacaoService PublicacationsService { get; set; }
    [Inject] protected IWebHostEnvironment hostingEnvironment { get; set; }
    [Inject] public IStringLocalizer<App> L { get; set; }

    protected PubsWithDescriptions SelectedRecord { get; set; }
    protected bool EditDialogVisibility { get; set; } = false;

    protected DialogEffect Effects = DialogEffect.FadeZoom;

    protected List<FileCheckResult> FilesNotFound { get; set; } = new();
    string webRoot = "";
    protected override async Task OnInitializedAsync()
    {
        webRoot = hostingEnvironment.WebRootPath;
        FilesNotFound = await PublicacationsService.PubsNotFoundOnDisk(webRoot);
    }

    protected async Task ShowPublication(int pubId)
    {
        SelectedRecord = await PublicacationsService.GetByIdAsync_Extended(pubId);
        EditDialogVisibility = true;
    }
}


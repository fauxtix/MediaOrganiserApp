@page "/pubswithwrongpath"

@using MediaOrganizerApp.Application.Interfaces.Services
@using MediaOrganizerApp.Application.Interfaces.Services.Api
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Logging
@using Web.Blazor.Components

@inject IPublicacaoService publicacoesService
@inject IFileService fileService
@inject IWebHostEnvironment env
@inject IStringLocalizer<App> L



@if (publicacoes is null)
{
    <p><em>@L["LoadingMsg"]</em></p>
}
else
{

    <h3>@L["TituloCaminhoFicheirosIncorreto"] (@pubsWithWrongPath.Count)</h3>
    <hr />

    <SfBreadcrumb>
        <BreadcrumbItems>
            <BreadcrumbItem Text="@L["BreadcrumbHome"]" IconCss="e-icons e-home" Url="/" />
            <BreadcrumbItem Text="@L["mnuLivros"]" Url="/publicacoes" />
            <BreadcrumbItem Text="@L["TituloCaminhoFicheirosIncorreto"]" Url="/pubswithwrongpath" />
        </BreadcrumbItems>
    </SfBreadcrumb>
    <hr />

    <div class="container-fluid mt-2">
        <div class="row">
            @foreach (var PubNotTransferedCtx in pubsWithWrongPath)
            {
                <div class="col-xl-3 col-lg-4 col-md-4 col-sm-6 col-xs-12 col-12">
                    <SfCard CssClass="teste my-1">
                        @*<CardImage Image="@fileService.DecodeImage(PubNotTransferedCtx.WrongCoverPath)"/>*@
                        <CardHeader Title="@PubNotTransferedCtx.Id.ToString()"
                                    SubTitle="@PubNotTransferedCtx.PubTitle" />
                        <CardContent EnableSeparator="true">
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="row mt-2">
                                        <div class="col-6">
                                            <div><b>@L["TituloCategoriaRegistada"]</b></div>
                                            <div class="mt-2">@PubNotTransferedCtx.ActualCategory</div>
                                        </div>
                                        <div class="col-6">
                                            <div><b>@L["TituloCategoriaPrevista"]</b></div>
                                            <div class="mt-2">@PubNotTransferedCtx.WantedCategory</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </CardContent>
                        <CardFooter>
                            <CardFooterContent>
                                <hr />
                                <div class="options-buttons-container">
                                    <SfButton IconCss="fa fa-exchange"
                                              CssClass="e-btn e-warning e-round-corner"
                                              Content="@L["TituloTransferir"]" @onclick="()=>RequestTransfer(PubNotTransferedCtx)" />
                                </div>
                            </CardFooterContent>
                        </CardFooter>
                    </SfCard>
                </div>
                <br />
            }
        </div>
    </div>

    <SfDialog Width="400px"
              Height="auto"
              IsModal="true"
              ShowCloseIcon="false"
              CloseOnEscape="false"
              Visible="@transferConfirmVisibility">
        <DialogTemplates>
            <Header>
                <div class="modal-header">
                    <p class="text-warning">@L["ConfirmarTransferencia"]</p>
                </div>
            </Header>
            <Content>
                <div class="e-textbox">
                    <b>@(pendingTransfer?.PubTitle)</b>
                </div>
            </Content>
            <FooterTemplate>
                <div class="modal-footer">
                    <SfButton CssClass="e-btn e-success e-round-corner" IconCss="fa fa-check"
                              Content="@L["Sim"]" @onclick="OnTransferConfirmYes" />
                    <SfButton CssClass="e-btn e-outline e-round-corner" IconCss="fa fa-times"
                              Content="@L["Nao"]" @onclick="OnTransferConfirmNo" />
                </div>
            </FooterTemplate>
        </DialogTemplates>
        <DialogAnimationSettings Effect="DialogEffect.Fade" Duration=400></DialogAnimationSettings>
    </SfDialog>

    <SfDialog @ref="ErrorDialog"
              Width="600px"
              Height="300px"
              IsModal="true"
              ShowCloseIcon="false"
              CloseOnEscape="false"
              Visible="false">
        <DialogTemplates>
            <Header>
                <div class="modal-header">
                    <p class="text-danger">@L["MsgFileTransferError"]</p>
                </div>
            </Header>
            <Content>
                <div class="e-textbox">
                    <SfTextBox Multiline="true" @bind-Value="ErrorMessage" Readonly="true" />
                </div>
                <br />
                <p class="text-info">@L["OperacaoCancelada"]</p>
            </Content>
            <FooterTemplate>
                <div class="modal-footer">
                    <SfButton CssClass="btn btn-info e-primary" Content="@L["btnFechar"]"
                              @onclick="CloseErrorBox">
                    </SfButton>
                </div>
            </FooterTemplate>
        </DialogTemplates>
        <DialogAnimationSettings Effect="DialogEffect.Fade" Duration=400></DialogAnimationSettings>
    </SfDialog>

    <AlertUserComponent Visibility="alertUserVisibility"
                        Message="@L["msgSuccess"]"
                        Title="@L["TitleFileTransfer"]"
                        OnCloseDialog="@(()=>alertUserVisibility = false)" />
}

@code {

    [Inject] public IUserService UserService { get; set; }
    [Inject] AuthenticationStateProvider AuthenticationStateProvider { get; set; }
    [Inject] ILogger<PubsWithWrongPath> Logger { get; set; }

    protected IEnumerable<PubsWithDescriptions> publicacoes;
    protected List<PubNotTransfered> pubsWithWrongPath = new();
    protected bool alertUserVisibility = false;
    protected SfDialog ErrorDialog;
    protected string ErrorMessage = "";
    protected string dialogMessage = "";

    protected override async Task OnInitializedAsync()
    {
        publicacoes = await GetAllPublicationsWithDescriptions();
        pubsWithWrongPath = GetPubsWithWrongPaths();
    }

    protected async Task<IEnumerable<PubsWithDescriptions>> GetAllPublicationsWithDescriptions()
    {
        string userId;
        string role;
        var userDetails = await UserService.GetAuthenticatedUserDetails(AuthenticationStateProvider);
        userId = userDetails.UserId;
        role = userDetails.Role;

        var output = await publicacoesService.GetAllAsync( userId, role);
        return output;
    }

    protected class PubNotTransfered
    {
        public int Id { get; set; }
        public string PubTitle { get; set; }

        public string ActualCategory { get; set; }
        public string WantedCategory { get; set; }

        public DateTime UploadedDate { get; set; }

        public string ActualPubPath { get; set; }
        public string WantedDestinationPath { get; set; }

        public string ActualCoverPath { get; set; }
        public string WantedCoverPath { get; set; }
    }

    protected List<PubNotTransfered> GetPubsWithWrongPaths()
    {
        List<PubNotTransfered> pubs = new();
        var wwwRoot = env.WebRootPath;
        foreach (var pub in publicacoes)
        {
            var fileFullPath = Path.Combine(wwwRoot, pub.DigitalPath ?? "");
            if (!File.Exists(fileFullPath) && !string.IsNullOrEmpty(pub.DigitalPath))
            {
                var names = GetActualCategory(Path.GetFileName(fileFullPath));

                var wantedPubDir = Path.GetDirectoryName(fileFullPath) ?? "";
                var actualPubDir = string.IsNullOrEmpty(names.Item1)
                    ? ""
                    : Path.GetDirectoryName(names.Item1) ?? "";

                var coverFileName = GetCoverFileName(pub.ImagemCapa);

                var actualCoverPath = "";
                var wantedCoverPath = "";
                if (!string.IsNullOrEmpty(coverFileName) && !string.IsNullOrEmpty(actualPubDir) && !string.IsNullOrEmpty(wantedPubDir))
                {
                    actualCoverPath = Path.Combine(actualPubDir, "Capas", coverFileName);
                    wantedCoverPath = Path.Combine(wantedPubDir, "Capas", coverFileName);
                }

                pubs.Add(
                    new PubNotTransfered
                        {
                            Id = pub.Id,
                            PubTitle = pub.Titulo,
                            UploadedDate = pub.DataMovimento,

                            WantedDestinationPath = fileFullPath,
                            ActualPubPath = names.Item1,

                            ActualCategory = names.Item2,
                            WantedCategory = pub.Categoria ?? "",

                            ActualCoverPath = actualCoverPath,
                            WantedCoverPath = wantedCoverPath
                        }
                );
            }
        }

        return pubs;

    }

    private string? GetCoverFileName(string imagemCapa)
    {
        if (string.IsNullOrWhiteSpace(imagemCapa))
        {
            return null;
        }

        if (imagemCapa.StartsWith("data:", StringComparison.OrdinalIgnoreCase)
            || imagemCapa.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
            || imagemCapa.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            return null;
        }

        return Path.GetFileName(imagemCapa);
    }


    protected (string, string) GetActualCategory(string searchFile)
    {
        var pubsPath = Path.Combine(env.WebRootPath, "Files", "Uploads", "Publicacoes");
        var searchExt = Path.GetExtension(searchFile).ToLowerInvariant();
        var allowedExts = new[] { ".pdf", ".docx", ".msg", ".eml" };

        if (!allowedExts.Contains(searchExt))
        {
            return ("", L["MsgNotFound"]);
        }

        DirectoryInfo dir = new DirectoryInfo(pubsPath);
        foreach (var f in dir.EnumerateFiles("*." + searchExt.TrimStart('.'), SearchOption.AllDirectories))
        {
            if (string.Equals(f.Name, searchFile, StringComparison.OrdinalIgnoreCase))
            {
                return (
                    f.FullName,
                    Path.GetFileName(f.DirectoryName ?? "") ?? L["MsgNotFound"]);
            }
        }

        return ("", L["MsgNotFound"]);

    }

    private PubNotTransfered pendingTransfer;
    private bool transferConfirmVisibility = false;

    private void RequestTransfer(PubNotTransfered pubToMove)
    {
        pendingTransfer = pubToMove;
        transferConfirmVisibility = true;
    }

    private void OnTransferConfirmNo()
    {
        transferConfirmVisibility = false;
        pendingTransfer = null;
    }

    private async Task OnTransferConfirmYes()
    {
        transferConfirmVisibility = false;
        if (pendingTransfer == null)
        {
            return;
        }

        var pubToMove = pendingTransfer;
        pendingTransfer = null;
        await ExecuteTransfer(pubToMove);
    }

    private void EnsureDirectoryExists(string filePath)
    {
        var dir = Path.GetDirectoryName(filePath);
        if (!string.IsNullOrEmpty(dir) && !Directory.Exists(dir))
        {
            Directory.CreateDirectory(dir);
            Logger.LogInformation("TransferFile: pasta de destino criada em {Dir}", dir);
        }
    }

    private async Task ExecuteTransfer(PubNotTransfered pubToMove)
    {
        Logger.LogInformation(
            "TransferFile iniciado: Id={Id}, ActualPubPath='{ActualPubPath}', WantedDestination='{WantedDestination}', ActualCategory='{ActualCategory}', WantedCategory='{WantedCategory}'",
            pubToMove.Id, pubToMove.ActualPubPath, pubToMove.WantedDestinationPath,
            pubToMove.ActualCategory, pubToMove.WantedCategory);

        var pubFileTransfered = false;
        alertUserVisibility = false;

        try
        {
            if (string.IsNullOrWhiteSpace(pubToMove.ActualPubPath))
            {
                var productionPubPath = @"C:\inetpub\OrganiseIt\wwwroot\Files\Uploads\Publicacoes\";
                var productionFullPubPath = Path.Combine(productionPubPath, pubToMove.WantedCategory, Path.GetFileName(pubToMove.WantedDestinationPath));
                var productionFullPubCoverPath = Path.Combine(productionPubPath, pubToMove.WantedCategory, "Capas", Path.GetFileName(pubToMove.WantedCoverPath));

                if (File.Exists(productionFullPubPath))
                {
                    EnsureDirectoryExists(pubToMove.WantedDestinationPath);
                    File.Copy(productionFullPubPath, pubToMove.WantedDestinationPath, overwrite: true);
                    if (File.Exists(productionFullPubCoverPath))
                    {
                        EnsureDirectoryExists(pubToMove.WantedCoverPath);
                        File.Copy(productionFullPubCoverPath, pubToMove.WantedCoverPath, overwrite: true);
                    }

                    Logger.LogInformation("TransferFile ok (branch de produção) para Id={Id}", pubToMove.Id);
                    pubsWithWrongPath = GetPubsWithWrongPaths();
                    alertUserVisibility = true;
                    StateHasChanged();
                    return;
                }

                Logger.LogWarning("TransferFile: ficheiro não encontrado na origem de produção para Id={Id}", pubToMove.Id);
                ErrorMessage = L["MsgFileNotTransferredNotFound", pubToMove.PubTitle];
                await ErrorDialog.ShowAsync();
                return;
            }

            System.IO.FileInfo fileInfo = new System.IO.FileInfo(pubToMove.ActualPubPath);
            if (!fileService.IsFileLocked(fileInfo))
            {
                if (File.Exists(pubToMove.ActualPubPath))
                {
                    EnsureDirectoryExists(pubToMove.WantedDestinationPath);
                    File.Move(pubToMove.ActualPubPath, pubToMove.WantedDestinationPath, overwrite: true);
                    pubFileTransfered = true;
                }
                else
                {
                    ErrorMessage = L["MsgFileNotTransferredNotFound", Path.GetFileNameWithoutExtension(pubToMove.ActualPubPath)];
                    await ErrorDialog.ShowAsync();
                    return;
                }
                if (!string.IsNullOrEmpty(pubToMove.ActualCoverPath)
                    && !string.IsNullOrEmpty(pubToMove.WantedCoverPath)
                    && File.Exists(pubToMove.ActualCoverPath) && pubFileTransfered)
                {
                    EnsureDirectoryExists(pubToMove.WantedCoverPath);
                    File.Move(pubToMove.ActualCoverPath, pubToMove.WantedCoverPath, overwrite: true);
                }

                Logger.LogInformation("TransferFile ok (branch local) para Id={Id}", pubToMove.Id);
                pubsWithWrongPath = GetPubsWithWrongPaths();
                alertUserVisibility = true;
                StateHasChanged();
            }
            else
            {
                Logger.LogWarning("TransferFile: ficheiro bloqueado para Id={Id}", pubToMove.Id);
                ErrorMessage = L["MsgFileLocked"];
                await ErrorDialog.ShowAsync();
            }
        }
        catch (FileNotFoundException fnfe)
        {
            Logger.LogError(fnfe, "TransferFile: ficheiro não encontrado para Id={Id}", pubToMove.Id);
            ErrorMessage = $"{fnfe.Message}: {L["MsgFileNotFound"]}";
            await ErrorDialog.ShowAsync();
        }
        catch (IOException ioe)
        {
            Logger.LogError(ioe, "TransferFile: erro de E/S para Id={Id}", pubToMove.Id);
            ErrorMessage = $"{ioe.Message}: {L["MsgIoError"]}";
            await ErrorDialog.ShowAsync();
        }
        catch (OutOfMemoryException oome)
        {
            Logger.LogError(oome, "TransferFile: memória insuficiente para Id={Id}", pubToMove.Id);
            ErrorMessage = $"{oome.Message}: {L["MsgInsufficientMemory"]}";
            await ErrorDialog.ShowAsync();
        }

        catch (Exception ex)
        {
            Logger.LogError(ex, "TransferFile: erro inesperado para Id={Id}", pubToMove.Id);
            ErrorMessage = $"{ex.Message}: {L["MsgFileTransferError"]}";
            await ErrorDialog.ShowAsync();
        }
    }

    public async Task CloseErrorBox()
    {
        ErrorMessage = "";
        await ErrorDialog.HideAsync();
    }
}

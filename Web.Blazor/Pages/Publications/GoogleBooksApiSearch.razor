@using Web.Blazor.Components
@using Syncfusion.Blazor.Spinner

<div class="container-fluid">
    <SfSpinner @ref="spinner" Label="@localizerApp["MSG_PreparandoDados"]" Visible="false" />

    @if (showAiProgress)
    {
        <div class="e-message e-info mt-2">
            <div class="e-msg-content">@aiProgressMessage</div>
        </div>
    }

    @if (isBusy && !string.IsNullOrWhiteSpace(busyStatusMessage))
    {
        <div style="background:var(--app-info-bg);padding:8px;border-radius:4px;font-weight:bold;">
            @busyStatusMessage
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(sourceMessage))
    {
        <div class="mb-2" style="background:var(--app-info-bg);color:var(--app-info-text);border:1px solid var(--app-info-border);padding:8px;border-radius:4px;">
            <i class="fa fa-info-circle"></i>&nbsp;@sourceMessage
        </div>
    }


    <div class="form-row mt-1">
        <SfTextBox Enabled="true" Placeholder="@localizerApp["lblTitulo"]"
                   CssClass="form-control font-weight-bold e-corner"
                   ShowClearButton="true"
                   FloatLabelType="@FloatLabelType.Always"
                   @bind-Value="@titleToSearch"
                   Readonly="@isBusy">
        </SfTextBox>
    </div>
    <div>
        <SfTextBox Enabled="true" Placeholder="@localizerApp["lblAutor"]"
                   CssClass="form-control font-weight-bold e-corner"
                   ShowClearButton="true"
                   FloatLabelType="@FloatLabelType.Always"
                   @bind-Value="@authorToSearch"
                   Readonly="@isBusy">
        </SfTextBox>
    </div>
    <hr />

    <div class="row justify-content-end mt-2">
        <SfButton CssClass="e-success e-round-corner mr-3"
                  IconCss="fa fa-search"
                  Content="@localizerApp["btnPesquisar"]"
                  Disabled="@(isBusy || (string.IsNullOrWhiteSpace(titleToSearch) && string.IsNullOrWhiteSpace(authorToSearch)))"
                  @onclick="(async () => await GetBookInfo(titleToSearch, authorToSearch))" />
    </div>
</div>



<AlertUserComponent Visibility="@alertUser"
                    Title="@localizerApp["SerarchGoogleApi"]"
                    Message="@alertMessage"
                    AlertMessageType="AlertMessageType.Info"
                    XPosition="right"
                    YPosition="top"
                    OnCloseDialog="CloseDialog"
                    DialogWidth="400"
                    ShowRightSideIcon="false"
                    MessageNote="@noteMessage" />





<style>
    .search-title {
        display: flex;
        gap: 16px;
        justify-content: start;
        align-items: center;
    }
</style>
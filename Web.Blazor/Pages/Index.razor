@code {
    [Inject] IConfiguration _env { get; set; }

    public double ExplodeIndex { get; set; } = 0;
    public string OuterRadius = "70%", ExplodeRadius = "10%";
    public int StartAngle = 0, EndAngle = 360;
    List<string> PubImages = new List<string> { "card-Pubs-image-click" };
    List<string> MediaImage = new List<string> { "card-Media-image-click" };
    List<string> AuthorsImage = new List<string> { "card-Authors-image-click" };
    List<string> CategoriesImage = new List<string> { "card-FileOrganizer-image-click" };
    List<string> PublishersImage = new List<string> { "card-Publisher-image-click" };
    List<string> TableManagementImage = new List<string> { "card-TablesManagement-image-click" };
    protected string authorMobile;

    public bool AlertUserVisibility { get; set; } = false;
    public string AlertUserTitle { get; set; } = string.Empty;
    public string AlertUserMessage { get; set; } = string.Empty;
    public AppDefinitions.OpcoesRegisto AlertUserMessageType { get; set; } = AppDefinitions.OpcoesRegisto.Info;

    protected override void OnInitialized()
    {
        authorMobile = _env["AuthorMobile"];
        if (!InternetAccess())
        {
            AlertUserVisibility = true;
            AlertUserTitle = "Verificação de acessos";
            AlertUserMessage = "Internet indisponível. Sistema poderá ficar mais lento e algumas informações poderão não ser mostradas corretamente. Se ocorrer um erro de execução, refresque o browser, p.f. .";
        }
    }

    private bool InternetAccess()
    {
        bool isAlive = InternetService.CheckForInternetConnection(1000, "https://www.google.com");
        return isAlive;

    }

}

@using Microsoft.Extensions.Localization
@using Microsoft.JSInterop
@using System.Text.Json
@using MediaOrganizerApp.Application.DTOs.AI
@using Web.Blazor.Components
@using Web.Blazor.Services.ApiWrappers
@inject ConversationsClientService ConversationsClient
@inject IStringLocalizer<App> L
@inject IJSRuntime JS

@if (IsOpen)
{
    <div class="chat-history-overlay" @onclick="Close"></div>
}

<div class="chat-history-aside @(IsOpen ? "open" : "")" @onclick:stopPropagation>
    <div class="chat-history-header">
        <h3>@L["ChatHistory"]</h3>
        <button class="chat-history-close" @onclick="Close" title="@L["btnFechar"]">&times;</button>
    </div>

    <div class="chat-history-actions">
        <button class="chat-history-action"
                disabled="@(Conversations.Count == 0)"
                @onclick="ExportConversationsAsync">@L["ChatExport"]</button>
        <button class="chat-history-action"
                disabled="@(Conversations.Count == 0)"
                @onclick="ImportConversationsAsync">@L["ChatImport"]</button>
        <button class="chat-history-action chat-history-action-danger"
                disabled="@(_deleting || Conversations.Count == 0)"
                title="@L["ChatDeleteHistoryTitle"]"
                @onclick="AskDeleteAllConversations">
            <i class="fa fa-trash" aria-hidden="true"></i>
            <span>@L["ChatDeleteHistory"]</span>
        </button>
    </div>

    @if (!string.IsNullOrEmpty(_status))
    {
        <div class="chat-history-status">@_status</div>
    }

    <div class="chat-history-list">
        @if (_loading)
        {
            <div class="chat-history-empty">@L["LoadingMsg"]</div>
        }
        else if (Conversations.Count == 0)
        {
            <div class="chat-history-empty">@L["ChatNoConversations"]</div>
        }
        else
        {
            @foreach (var conv in Conversations)
            {
                <div class="chat-history-row" @onclick="() => LoadConversation(conv.Id)">
                    <div class="chat-history-info">
                        <span class="chat-history-title">@conv.Title</span>
                        <span class="chat-history-meta">@FormatDate(conv)</span>
                    </div>
                    <span class="chat-history-arrow">&#8594;</span>
                </div>
            }
        }
    </div>
</div>

<ConfirmAppWarning DialogTitle="@L["ChatDeleteHistoryTitle"]"
                   Message="@string.Format(L["ChatDeleteHistoryMessage"], Conversations.Count)"
                   AlertMessage="@L["ChatDeleteHistoryWarning"]"
                   AlertMessageType="AlertMessageType.Error"
                   IconType="AppDefinitions.OpcoesRegisto.Apagar"
                   DialogWidth="440px"
                   ZIndex="10010"
                   Visible="_confirmDeleteAll"
                   OnConfirmationYes="DeleteAllConversationsAsync"
                   OnConfirmationNo="CancelDeleteAllConversations" />

@code {
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<string> OnLoadConversation { get; set; }

    [Parameter]
    public EventCallback OnHistoryCleared { get; set; }

    private List<ConversationDto> Conversations { get; set; } = new();
    private bool _loading;
    private bool _deleting;
    private bool _confirmDeleteAll;
    private string _status = string.Empty;

    public async Task Open()
    {
        _loading = true;
        _status = string.Empty;
        _confirmDeleteAll = false;
        IsOpen = true;
        StateHasChanged();

        try
        {
            Conversations = await ConversationsClient.GetAllAsync();
        }
        catch
        {
            Conversations = new List<ConversationDto>();
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    public void Close()
    {
        IsOpen = false;
    }

    private async Task LoadConversation(string id)
    {
        if (OnLoadConversation.HasDelegate)
        {
            await OnLoadConversation.InvokeAsync(id);
        }

        Close();
    }

    private static string FormatDate(ConversationDto conv)
    {
        var when = conv.UpdatedAt ?? conv.CreatedAt;
        return when.ToLocalTime().ToString("yyyy-MM-dd HH:mm");
    }

    private async Task ExportConversationsAsync()
    {
        try
        {
            var items = Conversations
                .Where(c => !string.IsNullOrWhiteSpace(c.Title))
                .Select(c => new ConversationExportDto
                {
                    Id = c.Id,
                    Title = c.Title,
                    Json = c.Json,
                    CreatedAt = c.CreatedAt,
                    UpdatedAt = c.UpdatedAt
                })
                .ToList();

            var options = new JsonSerializerOptions { WriteIndented = true };
            string json = JsonSerializer.Serialize(items, options);
            string fileName = $"conversas_{DateTime.Now:yyyyMMdd_HHmmss}.json";

            await JS.InvokeVoidAsync("downloadJson", fileName, json);
            _status = string.Format(L["ChatExportOk"], items.Count);
        }
        catch (Exception ex)
        {
            _status = string.Format(L["ChatExportError"], ex.Message);
        }

        StateHasChanged();
    }

    private async Task ImportConversationsAsync()
    {
        try
        {
            string? conteudo = await JS.InvokeAsync<string>("pickJsonFile");
            if (string.IsNullOrWhiteSpace(conteudo))
            {
                return;
            }

            List<ConversationExportDto>? items;
            try
            {
                items = JsonSerializer.Deserialize<List<ConversationExportDto>>(conteudo);
            }
            catch
            {
                items = null;
            }

            if (items is null || items.Count == 0)
            {
                _status = L["ChatImportInvalid"];
                StateHasChanged();
                return;
            }

            int imported = 0;
            foreach (var item in items)
            {
                if (string.IsNullOrWhiteSpace(item.Title) || !IsValidMessagesJson(item.Json))
                    continue;

                await ConversationsClient.CreateAsync(new ConversationCreateDto
                {
                    Id = Guid.NewGuid().ToString(),
                    Title = item.Title,
                    Json = string.IsNullOrWhiteSpace(item.Json) ? "[]" : item.Json
                });
                imported++;
            }

            Conversations = await ConversationsClient.GetAllAsync() ?? new List<ConversationDto>();
            _status = string.Format(L["ChatImportOk"], imported);
        }
        catch (Exception ex)
        {
            _status = string.Format(L["ChatImportError"], ex.Message);
        }

        StateHasChanged();
    }

    private void AskDeleteAllConversations()
    {
        if (_deleting || Conversations.Count == 0)
        {
            return;
        }

        _confirmDeleteAll = true;
    }

    private void CancelDeleteAllConversations()
    {
        _confirmDeleteAll = false;
    }

    private async Task DeleteAllConversationsAsync()
    {
        if (_deleting || Conversations.Count == 0)
        {
            _confirmDeleteAll = false;
            return;
        }

        _deleting = true;
        _confirmDeleteAll = false;
        StateHasChanged();

        var pending = Conversations.ToList();
        var deleted = 0;

        try
        {
            foreach (var conv in pending)
            {
                await ConversationsClient.DeleteAsync(conv.Id);
                deleted++;
            }

            Conversations.Clear();
            _status = string.Format(L["ChatDeleteHistoryOk"], deleted);

            if (OnHistoryCleared.HasDelegate)
            {
                await OnHistoryCleared.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            // Reload what actually survived: a failure halfway through leaves the panel
            // showing conversations that are already gone.
            _status = string.Format(L["ChatDeleteHistoryError"], ex.Message);
            try
            {
                Conversations = await ConversationsClient.GetAllAsync() ?? new List<ConversationDto>();
            }
            catch
            {
                Conversations = new List<ConversationDto>();
            }
        }
        finally
        {
            _deleting = false;
            StateHasChanged();
        }
    }

    private static bool IsValidMessagesJson(string? json)
    {
        if (string.IsNullOrWhiteSpace(json))
            return true;

        try
        {
            using var doc = JsonDocument.Parse(json);
            return doc.RootElement.ValueKind == JsonValueKind.Array;
        }
        catch
        {
            return false;
        }
    }

    private sealed class ConversationExportDto
    {
        public string Id { get; set; } = string.Empty;
        public string Title { get; set; } = string.Empty;
        public string Json { get; set; } = "[]";
        public DateTime CreatedAt { get; set; }
        public DateTime? UpdatedAt { get; set; }
    }
}

<style>
    .chat-history-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background: rgba(0, 0, 0, 0.35);
        z-index: 9998;
    }

    .chat-history-aside {
        position: fixed;
        top: 0;
        right: 0;
        width: min(92vw, 560px);
        height: 100dvh;
        background: var(--app-surface);
        color: var(--app-text-primary);
        box-shadow: -4px 0 12px var(--app-shadow);
        padding: 16px;
        display: flex;
        flex-direction: column;
        overflow-y: auto;
        overflow-x: hidden;
        z-index: 9999;
        transform: translateX(100%);
        transition: transform 0.35s ease;
    }

    .chat-history-aside.open {
        transform: translateX(0);
    }

    .chat-history-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
    }

    .chat-history-header h3 {
        margin: 0;
        font-size: 1.05rem;
    }

    .chat-history-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        margin: 2px 0 16px;
        padding: 10px 12px;
        border: 1px solid var(--app-border);
        border-radius: 12px;
        background: var(--app-surface-alt);
        box-shadow: var(--app-shadow);
    }

    .chat-history-actions-label {
        margin-right: 2px;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--app-text-secondary);
        white-space: nowrap;
    }

    .chat-history-action {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        border: 1px solid var(--app-border);
        background: var(--app-surface);
        color: var(--app-text-primary);
        border-radius: 8px;
        padding: 6px 12px;
        font-size: 0.85rem;
        font-weight: 500;
        line-height: 1.35;
        cursor: pointer;
        transition: background-color 0.15s ease, border-color 0.15s ease,
                    color 0.15s ease, transform 0.1s ease;
    }

    .chat-history-action:hover {
        background: var(--app-surface-hover);
    }

    .chat-history-action:active {
        transform: translateY(1px);
    }

    .chat-history-action:disabled {
        opacity: 0.55;
        cursor: not-allowed;
    }

    .chat-history-action:disabled:hover {
        background: var(--app-surface);
    }

    [data-theme="dark"] .chat-history-action:not(.chat-history-action-danger) {
        background: var(--app-surface-hover);
    }

    [data-theme="dark"] .chat-history-action:not(.chat-history-action-danger):hover:not(:disabled) {
        background: var(--app-border);
    }

    [data-theme="dark"] .chat-history-action:disabled:not(.chat-history-action-danger) {
        background: var(--app-surface-hover);
    }

    .chat-history-action-danger {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        margin-left: auto;
        background: var(--app-danger-bg);
        border-color: var(--app-danger-border);
        color: var(--app-danger-text);
    }

    .chat-history-action-danger:hover:not(:disabled) {
        background: var(--app-danger-hover);
        border-color: var(--app-danger-hover);
        color: var(--app-on-danger);
    }

    .chat-history-action-danger:disabled {
        background: var(--app-danger-bg);
        border-color: var(--app-danger-border);
        color: var(--app-danger-text);
    }

    .chat-history-status {
        padding: 6px 8px;
        margin-bottom: 10px;
        border-radius: 6px;
        font-size: 0.8rem;
        background: var(--app-info-bg);
        border: 1px solid var(--app-info-border);
        color: var(--app-info-text);
    }

    .chat-history-close {
        border: none;
        background: transparent;
        color: var(--app-text-secondary);
        font-size: 1.3rem;
        line-height: 1;
        cursor: pointer;
        padding: 4px 8px;
        border-radius: 6px;
    }

    .chat-history-close:hover {
        background: var(--app-surface-hover);
    }

    .chat-history-list {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .chat-history-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        padding: 10px 8px;
        border-bottom: 1px solid var(--app-border);
        cursor: pointer;
        border-radius: 6px;
    }

    .chat-history-row:hover {
        background: var(--app-surface-hover);
    }

    .chat-history-info {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .chat-history-title {
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        color: var(--app-text-primary);
    }

    .chat-history-meta {
        font-size: 12px;
        color: var(--app-text-secondary);
    }

    .chat-history-arrow {
        color: var(--app-text-secondary);
        flex-shrink: 0;
    }

    .chat-history-empty {
        padding: 12px 8px;
        font-size: 0.9rem;
        color: var(--app-text-secondary);
    }
</style>
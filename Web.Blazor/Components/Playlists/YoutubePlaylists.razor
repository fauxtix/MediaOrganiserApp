@using MediaOrganizerApp.Application.DTOs.PlayLists
@using Syncfusion.Blazor.Spinner

<div class="youtube-search-options">
    <SfDropDownList TItem="string" TValue="string" Width="250px"
                    DataSource="@genreMap.Keys.ToList()"
                    AllowFiltering="true"
                    Placeholder="@localizerApp["TituloSelecionarGeneroMusical"]">
        <DropDownListEvents TItem="string" TValue="string" ValueChange="OnGenreChange"></DropDownListEvents>

    </SfDropDownList>

    <SfDropDownList TItem="YoutubePlaylistItem" TValue="string"
                    DataSource="@playlistList"
                    Placeholder="@localizerApp["TituloSelecionarPlaylist"]"
                    AllowFiltering="true">
        <DropDownListEvents TItem="YoutubePlaylistItem" TValue="string" ValueChange="OnPlaylistChange"></DropDownListEvents>

        <DropDownListFieldSettings Text="Title" Value="Id" />
    </SfDropDownList>

    <SfButton CssClass="e-primary e-round-corner"
              IconCss="fa fa-search"
              Disabled="@(!CanSearch)"
              @onclick="GetYoutubePlaylist">
    </SfButton>
</div>

@if (youtubeVideos != null && youtubeVideos.Count > 0)
{
    <div class="d-flex flex-row justify-content-start my-2" style="gap:8px">
        <SfTextBox Placeholder="@localizerApp["TituloPesquisaTituloPlaylist"]"
                   CssClass="form-control p-1 align-items-center e-round-corner"
                   Input="OnTitleInput" Width="300px"
                   @bind-Value="TitleSearch" />
        @if (!string.IsNullOrEmpty(TitleSearch))
        {
            <SfButton CssClass="e-btn e-outline e-round"
                      IconCss="fa fa-times"
                      @onclick="ClearTitleSearch">
            </SfButton>
        }
    </div>
}

@if (!string.IsNullOrWhiteSpace(youtubeSearchError))
{
    <SfMessage CssClass="e-error"
               Severity="MessageSeverity.Error"
               ShowCloseIcon="true"
               Variant="MessageVariant.Text">
        @youtubeSearchError
    </SfMessage>
}
else if (youtubeVideos is not null && youtubeVideos.Any())
{
    <hr />
    <div class="container e-container-style">
        <div class="row text-lg-start">
            @foreach (var video in FilteredYoutubeVideos)
            {
                <SfFab IconCss="fa fa-arrow-up"
                       Position="FabPosition.BottomRight"
                       OnClick="ScrollToTop">
                </SfFab>
                <div class="col-lg-4 col-md-6 col-sm-12">
                    <a class="d-block mb-4 h-100" href="@($"https://www.youtube.com/watch?v={video.VideoId}")" target="_blank" style="text-decoration:none;">
                        <div class="img-box fixed-img-box">
                            <img class="img-fluid img-thumbnail fixed-img"
                                 src="@video.ThumbnailUrl"
                                 alt="@video.Title" />
                        </div>
                        <div class="card">
                            <div class="card-body">
                                <div class="d-flex justify-content-start align-items-center small-text w-100">
                                    <p class="info-title mb-0"
                                       data-bs-toggle="tooltip"
                                       data-bs-placement="top"
                                       title="@video.Title">
                                        @video.Title
                                    </p>
                                </div>
                                <hr />
                                <div class="d-flex justify-content-between align-items-center w-100">
                                    <div>
                                        <SfChip>
                                            <ChipItems>
                                                <ChipItem CssClass="e-success e-outline fs-5"
                                                          Text="@($"{localizerApp["PublishedDate"]}: {video.PublishedAt}")" />
                                            </ChipItems>
                                        </SfChip>
                                    </div>
                                    <div>
                                        <SfChip>
                                            <ChipItems>
                                                <ChipItem CssClass="e-warning e-outline fs-5"
                                                          Text="@($"{localizerApp["TrackTime"]}: {video.DurationFormatted}")" />
                                            </ChipItems>
                                        </SfChip>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
}

<div class="e-spin-material">
    <SfSpinner Label="@localizerApp["LoadingMsg"]"
               Type="@SpinnerType.Material"
               @bind-Visible="@SpinnerVisibleProperty"
               CssClass="e-customClass">
    </SfSpinner>
</div>

<style>
    .youtube-search-options {
        display: flex;
        gap: 12px;
        align-items: center;
        width: 75%;
        margin-bottom: 20px;
        margin-top: 20px;
    }

    .fixed-img-box {
        width: 100%;
        height: 240px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background: #f8f8f8;
        border-radius: 16px;
    }

    .fixed-img {
        width: 100%;
        height: 100%;
        max-width: 340px;
        max-height: 240px;
        object-fit: cover;
        border-radius: 16px;
    }

    .fixed-card {
        min-height: 170px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .info-title {
        font-size: 0.95rem !important;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .youtube-fab {
        position: fixed !important;
        right: 50px;
        bottom: 30px;
        z-index: 10000;
    }

    .e-customClass {
        .e-spinner-pane.e-customClass .e-spinner-inner .e-spin-material {
            stroke: ivory;
        }
    }
</style>
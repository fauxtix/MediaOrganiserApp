@if (!string.IsNullOrWhiteSpace(youtubeSearchError))
{
    <div class="alert alert-danger">
        @youtubeSearchError
    </div>
}
else if (youtubeVideos is not null && youtubeVideos.Any())
{
    <div class="container e-container-style">
        <div class="row text-lg-start">
            @foreach (var video in FilteredYoutubeVideos)
            {
                <SfFab IconCss="fa fa-arrow-up"
                       Position="FabPosition.BottomRight"
                       OnClick="ScrollToTop">
                </SfFab>
                <div class="col-lg-4 col-md-6 col-sm-12">
                    <a class="d-block mb-4 h-100" href="@($"https://www.youtube.com/watch?v={video.VideoId}")" target="_blank" style="text-decoration:none;">
                        <div class="img-box fixed-img-box">
                            <img class="img-fluid img-thumbnail fixed-img"
                                 src="@video.ThumbnailUrl"
                                 alt="@video.Title" />
                        </div>
                        <div class="card">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start">
                                    <p class="info-title"><i>@video.Title</i></p>
                                    <SfChip>
                                        <ChipItems>
                                            <ChipItem CssClass="e-success" Text="@video.PublishedAt.ToString()" />
                                        </ChipItems>
                                    </SfChip>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>  
}

<div class="e-spin-material">
<SfSpinner Label="@localizerApp["LoadingMsg"]"  
           Type="@SpinnerType.Material"
           @bind-Visible="@VisibleProperty"
           CssClass="e-customClass">
</SfSpinner>
</div>

@code {

    [Inject] public IStringLocalizer<App> localizerApp { get; set; }
    [Inject] IJSRuntime JS { get; set; }
    [Inject] public YoutubeService YoutubeService { get; set; } = default!;

    protected List<YoutubePlaylistItem> playlistList = new();
    protected string selectedPlaylistId;
    protected string youtubePlaylistQuery = string.Empty;
    protected bool ShowTitleSearch { get; set; } = false;
    protected string? youtubeSearchError;
    protected string TitleSearch { get; set; } = string.Empty;
    protected List<YoutubeVideoDto>? youtubeVideos;
    protected bool VisibleProperty { get; set; } = false; 

    protected Dictionary<string, string> genreMap = new Dictionary<string, string>
        {
            { "Pop", "pop music playlist" },
            { "Punk", "punk music playlist" },
            { "Rock", "rock classics playlist" },
            { "Progressive Rock", "progressive rock classics playlist" },
            { "Hard Rock", "hard rock classics playlist" },
            { "Blues", "blues classics playlist" },
            { "Soul", "soul music playlist" }
        };

    protected IEnumerable<YoutubeVideoDto> FilteredYoutubeVideos =>
    string.IsNullOrWhiteSpace(TitleSearch)
    ? youtubeVideos ?? Enumerable.Empty<YoutubeVideoDto>()
    : youtubeVideos?.Where(v =>
        v.Title.Contains(TitleSearch, StringComparison.OrdinalIgnoreCase)
        || v.Title.Contains(TitleSearch, StringComparison.OrdinalIgnoreCase))
      ?? Enumerable.Empty<YoutubeVideoDto>();

    protected async Task GetYoutubePlaylist()
    {
        youtubeSearchError = null;
        youtubeVideos = null;

        if (string.IsNullOrWhiteSpace(youtubePlaylistQuery))
        {
            youtubeSearchError = "Informe o nome ou URL da playlist.";
            return;
        }

        try
        {
            VisibleProperty = true;
            youtubeVideos = await YoutubeService.GetVideosFromPlaylist(youtubePlaylistQuery);
            ShowTitleSearch = youtubeVideos != null && youtubeVideos.Any();
        }
        catch (Exception ex)
        {
            youtubeSearchError = $"Erro ao pesquisar playlist: {ex.Message}";
        }
        finally
        {
            VisibleProperty = false;
        }
    }

    protected async Task OnGenreChange(ChangeEventArgs<string, string> args)
    {
        try
        {
            VisibleProperty = true;
            var query = genreMap[args.Value];
            playlistList = await YoutubeService.GetPlaylistsAsync(query);
            //StateHasChanged();
        }
        catch (Exception ex)
        {
            youtubeSearchError = $"Erro ao buscar playlist: {ex.Message}";
        }
        finally
        {
            VisibleProperty = false;
        }
    }

    protected void OnPlaylistChange(ChangeEventArgs<string, YoutubePlaylistItem> args)
    {
        try
        {
            VisibleProperty = true;

            selectedPlaylistId = args.Value;
            youtubePlaylistQuery = selectedPlaylistId;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            youtubeSearchError = $"Erro ao processar playlist: {ex.Message}";
        }
        finally
        {
            VisibleProperty = false;
        }
    }

    protected async Task ScrollToTop()
    {
        await JS.InvokeVoidAsync(
            "window.scrollTo",
            new { top = 0, behavior = "smooth" });
    }

}

<style>
    .youtube-search-options {
        display: flex;
        gap: 12px;
        align-items: center;
        width: 75%;
        margin-bottom: 20px;
        margin-top: 20px;
    }

    .fixed-img-box {
        width: 100%;
        height: 240px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        background: #f8f8f8;
        border-radius: 16px;
    }

    .fixed-img {
        width: 100%;
        height: 100%;
        max-width: 340px;
        max-height: 240px;
        object-fit: cover;
        border-radius: 16px;
    }

    .fixed-card {
        min-height: 170px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .info-title {
        margin-left: 3px;
        font-weight: 500;
        flex: 1 1 0;
        font-size: 0.85rem;
        line-height: 1.2em;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        word-break: break-word;
        margin-bottom: 0;
    }

    .card-title-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 10px;
        min-height: 2.5em;
        max-height: 2.5em;
        overflow: hidden;
    }

    .youtube-fab {
        position: fixed !important;
        right: 30px;
        bottom: 30px;
        z-index: 10000;
    }

    .e-customClass {
        .e-spinner-pane.e-customClass .e-spinner-inner .e-spin-material {
            stroke: #808080;
        }
    }
</style>
@page "/edit-prompts"
@using Microsoft.Extensions.Localization
@using Web.Blazor.Components.Prompts
@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.DropDowns
@using Web.Blazor.Utilities
@using Ganss.Xss
@using Markdig

@inject PromptFilesService PromptService
@inject IStringLocalizer<App> localizerApp
@inject ILogger<App> Logger


<PageTitle>@localizerApp["TituloEditorPrompts"]</PageTitle>
<PageTitleComponent PageTitle="@localizerApp["TituloEditorPrompts"]" />

<!-- Remove global dropdown row, move dropdown and buttons to prompt editor pane -->
<div class="edit-prompts-main">
    <div class="prompt-editor-pane">
        <div class="prompt-header-row">
            <div class="dropdown-container">
                <SfDropDownList TItem="string" TValue="string"
                                DataSource="PromptFiles"
                                Placeholder="@localizerApp["TituloSelecioneFicheiro"]"
                                @bind-Value="SelectedPromptFile"
                                PopupHeight="200px">
                    <ChildContent>
                        <DropDownListEvents TItem="string" TValue="string"
                                            ValueChange="OnPromptSelected" />
                    </ChildContent>
                    <ItemTemplate Context="file">
                        @System.IO.Path.GetFileNameWithoutExtension(file)
                    </ItemTemplate>
                </SfDropDownList>
            </div>
            <div class="prompt-actions">
                <SfButton CssClass="e-success e-round-corner"
                          IconCss="fa fa-save"
                          OnClick="OnSave"
                          Content="@localizerApp["btnSalvar"]" />
                <SfButton CssClass="e-outline e-round-corner ml-2"
                          IconCss="fa fa-times"
                          OnClick="OnCancel"
                          Content="@localizerApp["btnCancelar"]" />
            </div>
        </div>
        <hr />
        @if (!string.IsNullOrEmpty(SelectedPromptFile))
        {
            <SfTextArea @bind-Value="EditorContent" Rows="30" Width="100%" CssClass="sf-textarea" Placeholder="Edit prompt..." />
        }
    </div>
    <div class="readme-pane">
        <h5>README.md</h5>
        @if (!string.IsNullOrEmpty(ReadmeMd))
        {
            @((MarkupString)ReadmeMd)
        }
        else
        {
            <div>README.md não encontrado.</div>
        }
    </div>
</div>

    <SfToast @ref="ToastObj"
             Title="@ToastTitle"
             Content="@ToastContent"
             CssClass="@ToastCssClass" Timeout="1500"
             ShowCloseButton="true">
        <ToastPosition X="Right" Y="Bottom"></ToastPosition>
    </SfToast>


@code {
    List<string> PromptFiles = new();
    string SelectedPromptFile;
    private string _editorContent;
    public string EditorContent
    {
        get => _editorContent;
        set
        {
            if (_editorContent != value)
            {
                _editorContent = value;
                Logger.LogInformation("EditorContent updated: {Content}", _editorContent);
            }
        }
    }
    string ReadmeMd;
    protected SfToast ToastObj;
    protected string ToastTitle = "Prompt Editor";
    protected string ToastContent = "";
    protected string ToastCssClass = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var files = await PromptService.GetPromptFilesAsync();
            PromptFiles = files.Where(f => f.EndsWith(".txt", StringComparison.OrdinalIgnoreCase)).ToList();
            var readme = await PromptService.GetReadmeContentAsync();
            // Render markdown as HTML using Markdig with advanced extensions
            var pipeline = new Markdig.MarkdownPipelineBuilder()
                .UseAdvancedExtensions()
                .Build();

            // Normalize line endings and convert to HTML
            var raw = readme?.Replace("\r\n", "\n") ?? string.Empty;
            var html = Markdig.Markdown.ToHtml(raw, pipeline);

            // Sanitize HTML using Ganss.XSS HtmlSanitizer
            var sanitizer = new HtmlSanitizer();
            // Allow common attributes used by Markdown output
            sanitizer.AllowedAttributes.Add("target");
            sanitizer.AllowedAttributes.Add("rel");
            sanitizer.AllowedAttributes.Add("class");
            // Allow common URL schemes
            sanitizer.AllowedSchemes.Add("http");
            sanitizer.AllowedSchemes.Add("https");
            sanitizer.AllowedSchemes.Add("mailto");

            var safe = sanitizer.Sanitize(html);

        // Wrap in a container for styling
        ReadmeMd = $"<article class=\"markdown-body\">{safe}</article>";        }

        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading prompt files or README.md"); 
            ReadmeMd = $"Erro ao carregar README.md: {ex.Message}";
        }
    }


    private async Task OnPromptSelected(Syncfusion.Blazor.DropDowns.ChangeEventArgs<string, string> e)
    {

        try
        {
            SelectedPromptFile = e.Value?.ToString();
            if (!string.IsNullOrEmpty(SelectedPromptFile))
            {
                var content = await PromptService.GetPromptFileContentAsync(SelectedPromptFile);
                EditorContent = content;
            }
            else
            {
                EditorContent = null;
            }
        }
        catch (Exception ex)
        {
           Logger.LogError(ex, "Error saving prompt atual"); 

            ToastContent = "Erro ao gravar prompt atual";
            ToastCssClass = "e-danger";
            ToastTitle = "Editor de Prompts";
        }
    }

    private async Task OnSaved()
    {
        ToastContent = "Prompt salvo com sucesso!";
        ToastCssClass = "e-success";
        ToastTitle = "Editor de Prompts";
        await ToastObj.ShowAsync();
    }

    private async Task OnSave()
    {
        try
        {
            Logger.LogInformation("OnSave triggered. EditorContent: {Content}", EditorContent);

            if (!string.IsNullOrEmpty(SelectedPromptFile))
            {
                await PromptService.SavePromptFileAsync(SelectedPromptFile, EditorContent);
               await OnSaved();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error in saving prompt"); 

            ToastContent = "Erro ao gravar ficheiro";
            ToastCssClass = "e-danger";
            ToastTitle = "Editor de Prompts";
            await ToastObj.ShowAsync();
        }
    }

    private void OnCancel()
    {
        // Reload original content of the selected prompt file
        _ = ReloadPromptContentAsync();
    }

    private async Task ReloadPromptContentAsync()
    {
        if (!string.IsNullOrEmpty(SelectedPromptFile))
        {
            EditorContent = await PromptService.GetPromptFileContentAsync(SelectedPromptFile);

            ToastContent = "Ficheiro recarregado com sucesso!";
            ToastCssClass = "e-warning";
            ToastTitle = "Editor de Prompts";
            StateHasChanged();
            await ToastObj.ShowAsync();
        }
    }

}

<style>
/* ===== HARD RESET (override Syncfusion / dark inheritance) ===== */

.readme-pane,
.readme-pane * {
    background-color: #ffffff !important;
    color: #24292f !important;
    opacity: 1 !important;
    filter: none !important;
}

/* ===== Layout ===== */

.edit-prompts-main {
    display: flex;
    flex-direction: row;
    gap: 1.5rem;
    /* Account for the gap so children 60%+40% fill the area without leaving unused space */
    width: calc(100% - 1.5rem);
    box-sizing: border-box;
    /* Prevent the page from scrolling; let inner panes manage their own scrolling */
    height: calc(100vh - 64px);
    overflow: hidden;
    max-width: 100%;
    align-items: stretch;
}

/* Ensure direct children can't force the flex container wider */
.edit-prompts-main > * {
    min-width: 0;
    box-sizing: border-box;
    /* Keep editor content visible; if necessary allow internal scrolling */
    overflow: visible;
}

/* ===== LEFT: Prompt Editor ===== */

.prompt-editor-pane {
    /* Left pane: 60% of the container */
    flex: 0 0 60%;
    min-width: 0;
    height: calc(100vh - 64px);
    display: flex;
    flex-direction: column;
    border-right: 1px solid #e5e7eb;
    padding-right: 0.5rem;
    padding-left: 0.5rem;
    box-sizing: border-box;
}

.prompt-header-row {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.dropdown-container {
    /* Limit to available space so it doesn't force horizontal scroll */
    width: 100%;
    max-width: 400px;
    box-sizing: border-box;
}

.prompt-actions {
    margin-left:10px;
    display: flex;
    gap: 0.5rem;
    justify-content: flex-end;
    align-items: center;
}

/* ===== RIGHT: README ===== */

.readme-pane {
    /* Right pane: 40% of the container */
    flex: 0 0 40%;
    min-width: 0;
    height: calc(100vh - 64px);
    padding: 1rem 1rem;
    /* Scroll only the README content vertically */
    overflow-y: auto;
    overflow-x: hidden;
    border-radius: 6px;
    box-sizing: border-box;
}

/* ===== Markdown Container ===== */

.readme-pane .markdown-body {
    /* Let content use the full pane width to avoid unused right-side space */
    max-width: none;
    width: 100%;
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    font-size: 16px;
    line-height: 1.6;
}

/* ===== Headings ===== */

.readme-pane h1,
.readme-pane h2 {
    border-bottom: 1px solid #d0d7de;
    padding-bottom: 0.3em;
}

.readme-pane h1 { font-size: 2em; margin-top: 1.2em; }
.readme-pane h2 { font-size: 1.5em; margin-top: 1.2em; }
.readme-pane h3 { font-size: 1.25em; margin-top: 1em; }
.readme-pane h4 { font-size: 1em; }
.readme-pane h5 { font-size: 0.875em; }
.readme-pane h6 { font-size: 0.85em; color: #57606a !important; }

.readme-pane h1,
.readme-pane h2,
.readme-pane h3,
.readme-pane h4,
.readme-pane h5,
.readme-pane h6 {
    margin-bottom: 0.5em;
    font-weight: 600;
}

/* ===== Text ===== */

.readme-pane p {
    margin: 0.8em 0;
}

.readme-pane strong {
    font-weight: 600;
}

/* ===== Lists ===== */

.readme-pane ul,
.readme-pane ol {
    padding-left: 2em;
    margin: 0.8em 0;
}

.readme-pane li {
    margin: 0.3em 0;
}

/* ===== Links ===== */

.readme-pane a {
    color: #0969da !important;
    text-decoration: none;
}

.readme-pane a:hover {
    text-decoration: underline;
}

/* ===== Inline Code ===== */

.readme-pane code {
    background-color: #f6f8fa !important;
    padding: 0.2em 0.4em;
    border-radius: 6px;
    font-size: 85%;
    font-family: Consolas, Monaco, "Courier New", monospace;
}

/* ===== Code Blocks ===== */

.readme-pane pre {
    background-color: #0d1117 !important;
    color: #c9d1d9 !important;
    padding: 1em;
    border-radius: 6px;
    overflow-x: auto;
    margin: 1em 0;
}

.readme-pane pre code {
    background: none !important;
    padding: 0;
    color: inherit !important;
}

/* ===== Tables ===== */

.readme-pane table {
    border-collapse: collapse;
    margin: 1em 0;
    width: 100%;
}

.readme-pane th,
.readme-pane td {
    border: 1px solid #d0d7de;
    padding: 8px 12px;
}

.readme-pane th {
    background-color: #f6f8fa !important;
    font-weight: 600;
}

/* ===== Blockquotes ===== */

.readme-pane blockquote {
    border-left: 4px solid #d0d7de;
    padding: 0 1em;
    color: #57606a !important;
    margin: 1em 0;
}

/* ===== Horizontal Rule ===== */

.readme-pane hr {
    border: none;
    border-top: 1px solid #d0d7de;
    margin: 2em 0;
}

/* ===== Images (FIX BIG IMAGE ISSUE) ===== */

.readme-pane img {
    max-width: 100% !important;
    height: auto !important;
    display: block;
    margin: 1rem 0;
    border-radius: 6px;
}

/* ===== Responsive ===== */

@@media (max-width: 900px) {

    .edit-prompts-main {
        flex-direction: column;
        gap: 1rem;
    }

    .prompt-editor-pane,
    .readme-pane {
        width: 100%;
        max-width: 100%;
        height: auto;
        border-right: none;
        padding: 1rem;
    }

    .dropdown-container {
        width: 100%;
    }

    .prompt-header-row {
        flex-direction: column;
        align-items: stretch;
        gap: 0.75rem;
    }

    .prompt-actions {
        justify-content: flex-end;
    }
}
</style>
@page "/edit-prompts"
@using Microsoft.Extensions.Localization
@using Web.Blazor.Components.Prompts
@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.DropDowns
@using Web.Blazor.Utilities

@inject PromptFilesService PromptService
@inject IStringLocalizer<App> localizerApp
@inject ILogger<App> Logger


<PageTitle>@localizerApp["TituloEditorPrompts"]</PageTitle>
<PageTitleComponent PageTitle="@localizerApp["TituloEditorPrompts"]" />

<!-- Remove global dropdown row, move dropdown and buttons to prompt editor pane -->
<div class="edit-prompts-main">
    <div class="prompt-editor-pane">
        <div class="prompt-header-row">
            <div class="dropdown-container">
                <SfDropDownList TItem="string" TValue="string"
                                DataSource="PromptFiles"
                                Placeholder="@localizerApp["TituloSelecioneFicheiro"]"
                                @bind-Value="SelectedPromptFile"
                                PopupHeight="200px">
                    <ChildContent>
                        <DropDownListEvents TItem="string" TValue="string"
                                            ValueChange="OnPromptSelected" />
                    </ChildContent>
                    <ItemTemplate Context="file">
                        @System.IO.Path.GetFileNameWithoutExtension(file)
                    </ItemTemplate>
                </SfDropDownList>
            </div>
            <div class="prompt-actions">
                <SfButton CssClass="e-success e-round-corner"
                          IconCss="fa fa-save"
                          OnClick="OnSave"
                          Content="@localizerApp["btnSalvar"]" />
                <SfButton CssClass="e-outline e-round-corner ml-2"
                          IconCss="fa fa-times"
                          OnClick="OnCancel"
                          Content="@localizerApp["btnCancelar"]" />
            </div>
        </div>
        <hr />
        @if (!string.IsNullOrEmpty(SelectedPromptFile))
        {
            <SfTextArea @bind-Value="EditorContent" Rows="30" Width="100%" CssClass="sf-textarea" Placeholder="Edit prompt..." />
        }
    </div>
    <div class="readme-pane">
        <h5>README.md</h5>
        @if (!string.IsNullOrEmpty(ReadmeMd))
        {
            @((MarkupString)ReadmeMd)
        }
        else
        {
            <div>README.md não encontrado.</div>
        }
    </div>
</div>

    <SfToast @ref="ToastObj"
             Title="@ToastTitle"
             Content="@ToastContent"
             CssClass="@ToastCssClass" Timeout="1500"
             ShowCloseButton="true">
        <ToastPosition X="Right" Y="Bottom"></ToastPosition>
    </SfToast>


@code {
    List<string> PromptFiles = new();
    string SelectedPromptFile;
    private string _editorContent;
    public string EditorContent
    {
        get => _editorContent;
        set
        {
            if (_editorContent != value)
            {
                _editorContent = value;
                Logger.LogInformation("EditorContent updated: {Content}", _editorContent);
            }
        }
    }
    string ReadmeMd;
    protected SfToast ToastObj;
    protected string ToastTitle = "Prompt Editor";
    protected string ToastContent = "";
    protected string ToastCssClass = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var files = await PromptService.GetPromptFilesAsync();
            PromptFiles = files.Where(f => f.EndsWith(".txt", StringComparison.OrdinalIgnoreCase)).ToList();
            var readme = await PromptService.GetReadmeContentAsync();
            // Render markdown as HTML using Markdig
            // Render markdown as HTML using Markdig with advanced extensions
            var pipeline = new Markdig.MarkdownPipelineBuilder().Build();
            // Normalize line endings for Markdig
            ReadmeMd = Markdig.Markdown.ToHtml(readme?.Replace("\r\n", "\n") ?? "", pipeline);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading prompt files or README.md"); 
            ReadmeMd = $"Erro ao carregar README.md: {ex.Message}";
        }
    }


    private async Task OnPromptSelected(Syncfusion.Blazor.DropDowns.ChangeEventArgs<string, string> e)
    {

        try
        {
            SelectedPromptFile = e.Value?.ToString();
            if (!string.IsNullOrEmpty(SelectedPromptFile))
            {
                var content = await PromptService.GetPromptFileContentAsync(SelectedPromptFile);
                EditorContent = content;
            }
            else
            {
                EditorContent = null;
            }
        }
        catch (Exception ex)
        {
           Logger.LogError(ex, "Error saving prompt atual"); 

            ToastContent = "Erro ao gravar prompt atual";
            ToastCssClass = "e-danger";
            ToastTitle = "Editor de Prompts";
        }
    }

    private async Task OnSaved()
    {
        ToastContent = "Prompt salvo com sucesso!";
        ToastCssClass = "e-success";
        ToastTitle = "Editor de Prompts";
        await ToastObj.ShowAsync();
    }

    private async Task OnSave()
    {
        try
        {
            Logger.LogInformation("OnSave triggered. EditorContent: {Content}", EditorContent);

            if (!string.IsNullOrEmpty(SelectedPromptFile))
            {
                await PromptService.SavePromptFileAsync(SelectedPromptFile, EditorContent);
               await OnSaved();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error in saving prompt"); 

            ToastContent = "Erro ao gravar ficheiro";
            ToastCssClass = "e-danger";
            ToastTitle = "Editor de Prompts";
            await ToastObj.ShowAsync();
        }
    }

    private void OnCancel()
    {
        // Reload original content of the selected prompt file
        _ = ReloadPromptContentAsync();
    }

    private async Task ReloadPromptContentAsync()
    {
        if (!string.IsNullOrEmpty(SelectedPromptFile))
        {
            EditorContent = await PromptService.GetPromptFileContentAsync(SelectedPromptFile);

            ToastContent = "Ficheiro recarregado com sucesso!";
            ToastCssClass = "e-warning";
            ToastTitle = "Editor de Prompts";
            StateHasChanged();
            await ToastObj.ShowAsync();
        }
    }

}

<style>

    .dropdown-row {
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
    }
    .dropdown-actions {
        display: flex;
        gap: 0.5rem;
        align-items: center;
    }
    .dropdown-container {
        width: 400px;
    }
    .edit-prompts-main {
        display: flex;
        flex-direction: row;
        gap: 1.5rem;
        width: 100%;
        box-sizing: border-box;
    }
    .prompt-editor-pane {
        flex: 1 1 0;
        min-width: 0;
        height: calc(100vh - 64px);
        display: flex;
        flex-direction: column;
    }
    .readme-pane {
        flex: 1 1 0;
        min-width: 0;
        height: calc(100vh - 64px);
        background: #f8f9fa;
        border-radius: 6px;
        padding: 1em;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        overflow: auto;
    }
    .document-options {
        display: flex;
        justify-content: flex-end;
        gap: 5px;
        align-items: flex-end;
        margin-right: 10px;
    }

    .prompt-header-row {
        width: 100%;
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0;
    }
    .prompt-actions {
        display: flex;
        gap: 0.5rem;
        align-items: center;
    }

    .readme-pane h1,
    .readme-pane h2,
    .readme-pane h3,
    .readme-pane h4,
    .readme-pane h5,
    .readme-pane h6 {
        font-size: 1.2em;
    }

    .readme-pane p,
    .readme-pane ul,
    .readme-pane ol,
    .readme-pane li {
        font-size: 1em;
    }


@@media (max-width: 900px) {
    .edit-prompts-main {
        flex-direction: column;
        gap: 0.75rem;
    }
    .prompt-editor-pane, .readme-pane {
        max-width: 100%;
        min-width: 0;
        width: 100%;
        height: auto;
    }
    .dropdown-container {
        width: 100%;
        min-width: 0;
    }
    .readme-rich-text-editor {
        height: 300px !important;
    }
}
</style>
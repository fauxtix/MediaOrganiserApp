@page "/edit-prompts"
@using Microsoft.Extensions.Localization
@using Syncfusion.Blazor.DropDowns

@inject PromptFilesService PromptService
@inject IStringLocalizer<App> localizerApp
@inject ILogger<App> Logger


<PageTitle>@localizerApp["TituloEditorPrompts"]</PageTitle>
<PageTitleComponent PageTitle="@localizerApp["TituloEditorPrompts"]" />

<!-- Remove global dropdown row, move dropdown and buttons to prompt editor pane -->
<div class="edit-prompts-main">
    <div class="prompt-editor-pane">
        <div class="prompt-header-row">
            <div class="dropdown-container">
                <SfDropDownList TItem="string" TValue="string"
                                DataSource="PromptFiles"
                                CssClass="e-primary"
                                Placeholder="@localizerApp["TituloSelecioneFicheiro"]"
                                @bind-Value="SelectedPromptFile"
                                PopupHeight="200px">
                    <ChildContent>
                        <DropDownListEvents TItem="string" TValue="string"
                                            ValueChange="OnPromptSelected" />
                    </ChildContent>
                    <ItemTemplate Context="file">
                        @System.IO.Path.GetFileNameWithoutExtension(file)
                    </ItemTemplate>
                </SfDropDownList>
            </div>
            <div class="prompt-actions">
                <SfButton CssClass="e-success e-round-corner"
                          IconCss="fa fa-save"
                          OnClick="OnSave"
                          Content="@localizerApp["btnSalvar"]" />
                <SfButton CssClass="e-outline e-round-corner ml-2"
                          IconCss="fa fa-times"
                          OnClick="OnCancel"
                          Content="@localizerApp["btnCancelar"]" />
            </div>
        </div>
        <hr />
        @if (!string.IsNullOrEmpty(SelectedPromptFile))
        {
            <SfTextArea @bind-Value="EditorContent" Rows="30" Width="100%" CssClass="sf-textarea" Placeholder="Edit prompt..." />
        }
    </div>
    <div class="readme-pane">
        <h5>README.md</h5>
        @if (!string.IsNullOrEmpty(ReadmeMd))
        {
            @((MarkupString)ReadmeMd)
        }
        else
        {
            <div>README.md não encontrado.</div>
        }
    </div>
</div>

    <SfToast @ref="ToastObj"
             Title="@ToastTitle"
             Content="@ToastContent"
             CssClass="@ToastCssClass" Timeout="1500"
             ShowCloseButton="true">
        <ToastPosition X="Right" Y="Bottom"></ToastPosition>
    </SfToast>




<style>
/* ===== HARD RESET (override Syncfusion inheritance using theme tokens) ===== */

.readme-pane,
.readme-pane * {
    background-color: var(--app-surface) !important;
    color: var(--app-text-primary) !important;
    opacity: 1 !important;
    filter: none !important;
}

/* ===== Layout ===== */

.edit-prompts-main {
    display: flex;
    flex-direction: row;
    gap: 1.5rem;
    /* Account for the gap so children 60%+40% fill the area without leaving unused space */
    width: calc(100% - 1.5rem);
    box-sizing: border-box;
    /* Prevent the page from scrolling; let inner panes manage their own scrolling */
    height: calc(100vh - 64px);
    overflow: hidden;
    max-width: 100%;
    align-items: stretch;
}

/* Ensure direct children can't force the flex container wider */
.edit-prompts-main > * {
    min-width: 0;
    box-sizing: border-box;
    /* Keep editor content visible; if necessary allow internal scrolling */
    overflow: visible;
}

/* ===== LEFT: Prompt Editor ===== */

.prompt-editor-pane {
    /* Left pane: 60% of the container */
    flex: 0 0 60%;
    min-width: 0;
    height: calc(100vh - 64px);
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--app-border);
    padding-right: 0.5rem;
    padding-left: 0.5rem;
    box-sizing: border-box;
}

.prompt-header-row {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.dropdown-container {
    /* Limit to available space so it doesn't force horizontal scroll */
    width: 100%;
    max-width: 400px;
    box-sizing: border-box;
}

.prompt-actions {
    margin-left:10px;
    display: flex;
    gap: 0.5rem;
    justify-content: flex-end;
    align-items: center;
}

/* ===== RIGHT: README ===== */

.readme-pane {
    /* Right pane: 40% of the container */
    flex: 0 0 40%;
    min-width: 0;
    height: calc(100vh - 64px);
    padding: 1rem 1rem;
    /* Scroll only the README content vertically */
    overflow-y: auto;
    overflow-x: hidden;
    border-radius: 6px;
    box-sizing: border-box;
}

/* ===== Markdown Container ===== */

.readme-pane .markdown-body {
    /* Let content use the full pane width to avoid unused right-side space */
    max-width: none;
    width: 100%;
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    font-size: 16px;
    line-height: 1.6;
}

/* ===== Headings ===== */

.readme-pane h1,
.readme-pane h2 {
    border-bottom: 1px solid var(--app-border);
    padding-bottom: 0.3em;
}

.readme-pane h1 { font-size: 2em; margin-top: 1.2em; }
.readme-pane h2 { font-size: 1.5em; margin-top: 1.2em; }
.readme-pane h3 { font-size: 1.25em; margin-top: 1em; }
.readme-pane h4 { font-size: 1em; }
.readme-pane h5 { font-size: 0.875em; }
.readme-pane h6 { font-size: 0.85em; color: var(--app-text-secondary) !important; }

.readme-pane h1,
.readme-pane h2,
.readme-pane h3,
.readme-pane h4,
.readme-pane h5,
.readme-pane h6 {
    margin-bottom: 0.5em;
    font-weight: 600;
}

/* ===== Text ===== */

.readme-pane p {
    margin: 0.8em 0;
}

.readme-pane strong {
    font-weight: 600;
}

/* ===== Lists ===== */

.readme-pane ul,
.readme-pane ol {
    padding-left: 2em;
    margin: 0.8em 0;
}

.readme-pane li {
    margin: 0.3em 0;
}

/* ===== Links ===== */

.readme-pane a {
    color: var(--app-primary) !important;
    text-decoration: none;
}

.readme-pane a:hover {
    text-decoration: underline;
}

/* ===== Inline Code ===== */

.readme-pane code {
    background-color: var(--app-surface-alt) !important;
    padding: 0.2em 0.4em;
    border-radius: 6px;
    font-size: 85%;
    font-family: Consolas, Monaco, "Courier New", monospace;
}

/* ===== Code Blocks ===== */

.readme-pane pre {
    background-color: #0d1117 !important;
    color: #c9d1d9 !important;
    padding: 1em;
    border-radius: 6px;
    overflow-x: auto;
    margin: 1em 0;
}

.readme-pane pre code {
    background: none !important;
    padding: 0;
    color: inherit !important;
}

/* ===== Tables ===== */

.readme-pane table {
    border-collapse: collapse;
    margin: 1em 0;
    width: 100%;
}

.readme-pane th,
.readme-pane td {
    border: 1px solid var(--app-border);
    padding: 8px 12px;
}

.readme-pane th {
    background-color: var(--app-surface-alt) !important;
    font-weight: 600;
}

/* ===== Blockquotes ===== */

.readme-pane blockquote {
    border-left: 4px solid var(--app-border);
    padding: 0 1em;
    color: var(--app-text-secondary) !important;
    margin: 1em 0;
}

/* ===== Horizontal Rule ===== */

.readme-pane hr {
    border: none;
    border-top: 1px solid var(--app-border);
    margin: 2em 0;
}

/* ===== Images (FIX BIG IMAGE ISSUE) ===== */

.readme-pane img {
    max-width: 100% !important;
    height: auto !important;
    display: block;
    margin: 1rem 0;
    border-radius: 6px;
}

/* ===== Responsive ===== */

@@media (max-width: 900px) {

    .edit-prompts-main {
        flex-direction: column;
        gap: 1rem;
    }

    .prompt-editor-pane,
    .readme-pane {
        width: 100%;
        max-width: 100%;
        height: auto;
        border-right: none;
        padding: 1rem;
    }

    .dropdown-container {
        width: 100%;
    }

    .prompt-header-row {
        flex-direction: column;
        align-items: stretch;
        gap: 0.75rem;
    }

    .prompt-actions {
        justify-content: flex-end;
    }
}
</style>
@code {
    SidebarComponent? sideBarComponent;
    private bool isDarkMode;
    private bool _helpVisible;
    [CascadingParameter] protected Task<AuthenticationState> AuthenticationStateTask { get; set; }

    [Inject] ILogger<MainLayout> Logger { get; set; }
    [Inject] IConfiguration _env { get; set; }
    [Inject] NavigationManager Navigation { get; set; }
    [Inject] IAppSettingsService AppSettingsService { get; set; }
    [Inject] IHttpContextAccessor HttpContextAccessor { get; set; }

    protected string defaultCulture;

    protected string authorMobile;
    protected string userName;

    protected string currentCultureAbbreviation = "...";

    protected string generatedImageSrc = "images/MediaOrganiser_en.png";

    private ErrorBoundary? _errorBoundary;
    protected override async Task OnInitializedAsync()
    {

        try
        {
            var authState = await AuthenticationStateTask;
            userName = authState.User.Identity.Name;
            authorMobile = _env["AuthorMobile"];

            var cultureCookie = HttpContextAccessor.HttpContext?
                .Request.Cookies[CookieRequestCultureProvider.DefaultCookieName];

            if (string.IsNullOrEmpty(cultureCookie))
            {
                var settings = await AppSettingsService.GetSettingsAsync();
                defaultCulture = settings.DefaultLanguage ?? "pt";
                var uri = new Uri(Navigation.Uri)
                    .GetComponents(UriComponents.PathAndQuery, UriFormat.Unescaped);
                var query = $"?culture={Uri.EscapeDataString(defaultCulture)}&" +
                            $"redirectUri={Uri.EscapeDataString(uri)}";

                Navigation.NavigateTo($"/Culture/SetCulture{query}", forceLoad: true);
            }
            else
            {
                var currentCulture = CookieRequestCultureProvider.ParseCookieValue(cultureCookie);
                var cultureInfo = CultureInfo.GetCultureInfo(currentCulture.Cultures.FirstOrDefault().Value);
                currentCultureAbbreviation = cultureInfo.TwoLetterISOLanguageName;
                generatedImageSrc = currentCultureAbbreviation == "pt"
                    ? "images/MediaOrganiser_pt.png"
                    : "images/MediaOrganiser_en.png";
            }

        }
        catch (Exception exc)
        {
            Logger.LogCritical(exc.Message);
        }

    }

    private void ResetErrorBoundary()
    {
        _errorBoundary.Recover();
    }

    private void OpenHelp()
    {
        _helpVisible = true;
    }
}

<style>

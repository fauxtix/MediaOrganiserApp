        font-size: 24px;
        color: var(--header-text);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        padding-left: 12px;
    }

    /* Botão hambúrguer do menu em mobile: vive dentro da top-navbar (e não
       sobreposto em position:fixed), para nunca ficar atrás da barra
       (z-index 1050) nem colidir com o bloco de utilizador/idioma. */
    .top-navbar .sidebar-toggler {
        position: static;
        margin-right: 6px;
        color: var(--header-text);
        font-size: 1.35rem;
        line-height: 1;
        text-decoration: none;
    }

    .top-navbar .sidebar-toggler:hover {
        color: var(--app-accent-yellow);
    }

    @@media (max-width: 768px) {
        .brand {
            font-size: 15px;
            padding-left: 4px;
        }

        /* Nome do utilizador e idioma não cabem (nem são essenciais) em ecrãs
           pequenos; a ajuda, o tema e o logout continuam visíveis. */
        .top-identity {
            display: none !important;
        }

        /* O overlay (#overlay) está dentro de .main e não é irmão do
           .sidebar, por isso a regra .sidebar.toggled ~ .overlay da
           biblioteca css-pro-layout nunca dispara. */
        .sidebar.toggled ~ .main #overlay {
            display: block;
        }

        /* Drawer abaixo da top-navbar fixa (64px) e nunca maior que o ecrã. */
        .layout .sidebar.break-point-md {
            height: calc(100% - 64px);
            overflow-y: auto;
        }

@using Syncfusion.Blazor.Cards

    <CascadingAuthenticationState>
        <Router AppAssembly="@typeof(Program).Assembly">
            <Found Context="routeData">
                <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(Components.Layout.MainLayout)">
                    <NotAuthorized>
                        <h2>Acesso Negado</h2>
                        <p>Você precisa fazer <a href="/Identity/Account/Login">login</a> para aceder a esta página.</p>
                    </NotAuthorized>
                    <Authorizing>
                        <p>Verificando permissões...</p>
                    </Authorizing>
                </AuthorizeRouteView>
            </Found>
            <NotFound>
                <LayoutView Layout="@typeof(Components.Layout.MainLayout)">
                    <h1>404 - Página não encontrada</h1>
                    <p>A página que você procura não existe.</p>
                </LayoutView>
            </NotFound>
        </Router>
    </CascadingAuthenticationState>

@using Syncfusion.Blazor.Cards
<NavLink href="@Href" Match="NavLinkMatch.All" class="col-xs-6 col-xl-3 col-lg-3 col-md-3 col-sm-6 navStyle">
    <SfCard>
        <CardHeader Title="@sTitle" />
        <CardContent EnableSeparator="true">
            <div class="d-flex justify-content-between align-items-center bg-light bg-gradient ">
                <h3 class="circle">
                    @CardInfo_Count
                </h3>
                @*                 @if (ShowRealCount)
                {
                <span style="font-size:larger"> de </span>
                <h3 class="circle ">@CardInfo_Count_Real</h3>
                }
                *@                <div>
                    @foreach (var img in CardImages)
                    {
                        <span class="@img" />
                    }
                </div>
            </div>
        </CardContent>
    </SfCard>
</NavLink>


@code {
    [Parameter] public string Titulo { get; set; }
    [Parameter] public string Href { get; set; }
    [Parameter] public List<string> CardImages { get; set; }
    [Parameter] public string CardInfo_Count { get; set; }
    [Parameter] public string CardInfo_Count_Real { get; set; }
    [Parameter] public bool ShowRealCount { get; set; } = false;
    [Parameter] public string CurrentPage { get; set; }

    private string sTitle;

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(Href))
        {
            sTitle = Titulo;

            if (Href.ToLower().Contains("media"))
            {
                sTitle = Titulo + " (Media)";
            }
        }

    }

}


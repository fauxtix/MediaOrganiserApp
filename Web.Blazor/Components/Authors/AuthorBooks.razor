@using MediaOrganizerApp.Application.DTOs
@using MediaOrganizerApp.Application.Interfaces.Services.Api
@using Microsoft.AspNetCore.Components
@using System.Collections.Concurrent
@using System.Threading
@using System.Globalization
@using Microsoft.Extensions.Localization
@inject IGoogleBooksService GoogleBooksService
@inject ILogger<AuthorBooks> Logger
@inject Web.Blazor.Services.ApiWrappers.AiBookClientService AiBookClient
@inject Microsoft.Extensions.Options.IOptionsMonitor<MediaOrganizerApp.Application.FeatureFlags> FeatureFlagsMonitor
@inject IStringLocalizer<App> L

<div class="author-books-component">
    @if (string.IsNullOrWhiteSpace(AuthorName))
    {
        <div class="text-muted">@L["TituloNenhumAutorSelecionado"]</div>
    }
    else if (booksLoading)
    {
        <div class="text-muted">@L["LoadingMsg"]</div>
    }
    else if (googleRateLimited)
    {
        <div class="alert alert-warning">@L["TituloErroTooManyRequests"]</div>
    }
    else
    {
        var fn = FilteredBooks.ToList();
        if (fn.Any())
        {
            <div>
                <p class="font-weight-bolder mt-2" style="font-size:18px;">@L["TituloListaLivros"]</p>
                <hr />
            </div>
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div>
                    <button class="btn btn-sm btn-outline-primary me-1" @onclick="PrevPage" disabled="@(currentPage <= 1 || booksLoading || TotalPages <= 1)">@L["TituloAnterior"]</button>
                    <button class="btn btn-sm btn-outline-primary" @onclick="NextPage" disabled="@(currentPage >= TotalPages || booksLoading || TotalPages <= 1)">L["TituloSeguinte"]</button>
                </div>
                <div class="text-muted small">@L["lblPagina"] @currentPage / @TotalPages</div>
            </div>

            <div class="books-grid" style="--cols:@(Math.Max(1, Math.Min(PageSize, PagedBooks.Count()))); --min-width:140px;">
                @foreach (var b in PagedBooks)
                {
                    <div class="book-item mb-2">
                        <div class="book-card h-100">
                            <div class="img-box portrait book-thumb">
                                <img @onclick="() => ShowImageViewer(b)" src="@(string.IsNullOrWhiteSpace(b.Thumbnail) ? "images/NoPhoto.png" : b.Thumbnail)" alt="@b.Title" />
                            </div>
                            <div class="book-body p-2 d-flex flex-column">
                                <div class="d-flex align-items-start">
                                    <a class="book-title flex-grow-1" href="@($"https://books.google.com/books?id={b.Id}")" target="_blank" rel="noopener noreferrer">@b.Title</a>
                                    @{ var aiBadgeEnabled = FeatureFlagsMonitor.CurrentValue?.AiBadgeEnabled ?? true; }
                                    @if (aiBadgeEnabled && (b.Confidence is not null))
                                    {
                                        <div class="badge bg-warning text-dark ms-2 small" title=@($"Generated by AI — confidence {(b.Confidence ?? 0).ToString("P0")}") aria-label="AI generated">
                                            AI @((b.Confidence ?? 0).ToString("P0"))
                                        </div>
                                    }
                                </div>
                                <div class="book-meta text-muted small mt-2">@b.PublishedDate</div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="d-flex justify-content-end align-items-center mt-2">
                <div class="text-muted small">@L["lblPagina"] @currentPage / @TotalPages</div>
            </div>
        }
        else
        {
            <div class="text-muted">@L["TituloLivroNaoEncontrado"].</div>
        }
    }
</div>

<ImageViewer 
    ImageUrl="@SelectedBook?.Thumbnail"
    Visible="@isImageViewerVisible"
    VisibleChanged="@(v => isImageViewerVisible = v)"
    Title="@SelectedBook.Title" />


@code {
    [Parameter]
    public string? AuthorName { get; set; }

    [Parameter]
    public int PageSize { get; set; } = 4;

    private bool isImageViewerVisible;
    private GoogleBookInfo? SelectedBook = new();
    private List<GoogleBookInfo>? books;
    private bool booksLoading;
    private bool aiFallbackUsed;
    private bool googleRateLimited;
    private int currentPage = 1;

    private IEnumerable<GoogleBookInfo> FilteredBooks => (books ?? Enumerable.Empty<GoogleBookInfo>()).Where(b =>
        !string.IsNullOrWhiteSpace(b.Title) && !string.IsNullOrWhiteSpace(b.Thumbnail));

    private int TotalPages
    {
        get
        {
            var count = FilteredBooks.Count();
            if (count == 0) return 1;
            return (int)Math.Ceiling(count / (double)PageSize);
        }
    }

    private IEnumerable<GoogleBookInfo> PagedBooks => FilteredBooks.Skip((currentPage - 1) * PageSize).Take(PageSize);

    protected override async Task OnParametersSetAsync()
    {
        currentPage = 1;
        await LoadBooksAsync();
    }

    private void NextPage()
    {
        if (booksLoading) return;
        if (TotalPages <= 1) return;
        if (currentPage < TotalPages) currentPage++;
    }

    private void PrevPage()
    {
        if (booksLoading) return;
        if (TotalPages <= 1) return;
        if (currentPage > 1) currentPage--;
    }

    private static readonly ConcurrentDictionary<string, (DateTime fetchedAt, List<GoogleBookInfo> items, string source)> _booksCache = new();
    private static readonly TimeSpan GoogleCacheTtl = TimeSpan.FromMinutes(15);
    private static readonly TimeSpan AiCacheTtl = TimeSpan.FromMinutes(5);

    private async Task LoadBooksAsync()
    {
        books = null;
        if (string.IsNullOrWhiteSpace(AuthorName)) return;

        // Try cache first
        if (_booksCache.TryGetValue(AuthorName!, out var cached))
        {
            var ttl = string.Equals(cached.source, "AI", StringComparison.OrdinalIgnoreCase) ? AiCacheTtl : GoogleCacheTtl;
            if (DateTime.UtcNow - cached.fetchedAt < ttl)
            {
                books = cached.items;
                aiFallbackUsed = string.Equals(cached.source, "AI", StringComparison.OrdinalIgnoreCase);
                StateHasChanged();
                return;
            }
            else
            {
                // remove stale entry
                _booksCache.TryRemove(AuthorName!, out _);
            }
        }

        booksLoading = true;
        googleRateLimited = false;
        var uiLanguage = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

        try
        {
            List<GoogleBookInfo>? resultList = null;
            try
            {
                var result = await GoogleBooksService.GetBooksByAuthorAsync(AuthorName!);
                if (result == null || result.Count == 0)
                {
                    // If Google returned no results, try AI fallback
                    Logger.LogInformation("No Google results for {Author}; attempting AI fallback.", AuthorName);
                    try
                    {
                        var ai = await AiBookClient.GetAuthorBooksAsync(AuthorName!, uiLanguage);
                        if (ai is not null && ai.Count > 0)
                        {
                            resultList = ai.ToList();
                            aiFallbackUsed = true;
                            Logger.LogInformation("Used AI fallback to generate books for author {Author}", AuthorName);
                        }
                        else
                        {
                            resultList = new List<GoogleBookInfo>();
                        }
                    }
                    catch (Exception ex)
                    {
                        Logger.LogWarning(ex, "AI fallback failed for author {Author}", AuthorName);
                        resultList = new List<GoogleBookInfo>();
                    }
                }
                else
                {
                    resultList = result.ToList();
                }
            }
            catch (HttpRequestException httpEx) when (httpEx.StatusCode == System.Net.HttpStatusCode.TooManyRequests)
            {
                // Specific handling for Google 429 rate-limit: fall back to AI and show message
                Logger.LogWarning(httpEx, "Google Books rate-limited for {Author}; falling back to AI.", AuthorName);
                googleRateLimited = true;
                try
                {
                    var ai = await AiBookClient.GetAuthorBooksAsync(AuthorName!, uiLanguage);
                    if (ai is not null && ai.Count > 0)
                    {
                        resultList = ai.ToList();
                        aiFallbackUsed = true;
                        Logger.LogInformation("Used AI fallback to generate books for author {Author}", AuthorName);
                        // Inform user via a simple log; UI could display a banner if desired
                        // For now, set a small note on the first item's Notes (if exists) or log
                        Logger.LogInformation("Too many requests to Google service, fallback to AI for {Author}", AuthorName);
                    }
                    else
                    {
                        resultList = new List<GoogleBookInfo>();
                    }
                }
                catch (Exception ex2)
                {
                    Logger.LogWarning(ex2, "AI fallback failed for author {Author}", AuthorName);
                    resultList = new List<GoogleBookInfo>();
                }
            }
            catch (Exception ex)
            {
                // On other exceptions, log and attempt AI fallback
                Logger.LogWarning(ex, "Error fetching Google Books for author {Author}; attempting AI fallback", AuthorName);
                try
                {
                    var ai = await AiBookClient.GetAuthorBooksAsync(AuthorName!, uiLanguage);
                    if (ai is not null && ai.Count > 0)
                    {
                        resultList = ai.ToList();
                        aiFallbackUsed = true;
                        Logger.LogInformation("Used AI fallback to generate books for author {Author}", AuthorName);
                    }
                    else
                    {
                        resultList = new List<GoogleBookInfo>();
                    }
                }
                catch (Exception ex2)
                {
                    Logger.LogWarning(ex2, "AI fallback failed for author {Author}", AuthorName);
                    resultList = new List<GoogleBookInfo>();
                }
            }

            books = resultList ?? new List<GoogleBookInfo>();

            // store in cache (even empty) to avoid hammering API for a short period
            var source = aiFallbackUsed ? "AI" : "Google";
            _booksCache[AuthorName!] = (DateTime.UtcNow, books, source);
        }
        finally
        {
            booksLoading = false;
            StateHasChanged();
        }
    }

    private void ShowImageViewer(GoogleBookInfo book)
    {
        SelectedBook = book;
        isImageViewerVisible = true;
    }

    private void CloseImageViewer()
    {
        isImageViewerVisible = false;
    }
}

<style>
    .book-card {
        overflow: hidden;
        height: 100%;
        display: flex;
        flex-direction: column;
        background: #fff;
    }
    .book-body {
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
    }
    .books-grid {
        display: grid;
        gap: 0.75rem;
        grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
        align-items: stretch;
        width: 100%;
        max-width: 100%;
    }

    @@media (max-width: 992px) {
        .books-grid {
        grid-template-columns: repeat(min(3, var(--cols)), 1fr);
        }
    }

    @@media (max-width: 768px) {
        .books-grid {
        grid-template-columns: repeat(min(2, var(--cols)), 1fr);
        }
    }

    @@media (max-width: 480px) {
        .books-grid { grid-template-columns: 1fr; }
    }

    .book-item { /* optional wrapper */ }

    .img-box.portrait.book-thumb {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        aspect-ratio: 2 / 3;
        max-height: 200px; 
        border: 2px solid #ccc;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0,0,0,0.08);
        overflow: hidden;
        background-color: #f9f9f9;
    }

    .img-box.portrait.book-thumb img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        object-position: center;
        background-color: #f9f9f9;
        display: block;
    }

    .book-item {
        display: flex;
    }

    .book-card {
        display: flex;
        flex-direction: column;
        flex: 1 1 auto; 
    }

    .book-title {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        word-break: break-word;
        line-height: 1.2;
        max-height: calc(1.2em * 2);
        min-height: calc(1.2em * 2);
    }

    .book-meta {
        margin-top: auto;
    }
</style>
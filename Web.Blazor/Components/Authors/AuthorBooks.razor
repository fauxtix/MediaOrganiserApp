@using MediaOrganizerApp.Application
@using MediaOrganizerApp.Application.DTOs
@using MediaOrganizerApp.Application.Interfaces.Services.Api
@using Microsoft.AspNetCore.Components
@using System.Collections.Concurrent
@using System.Threading
@using System.Globalization
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Options
@using Web.Blazor.Components.MediaGrids
@using Web.Blazor.Services.ApiWrappers

@inject IGoogleBooksService GoogleBooksService
@inject ILogger<AuthorBooks> Logger
@inject AiBookClientService AiBookClient
@inject IWikidataClientService WikidataClient
@inject IOptionsMonitor<FeatureFlags> FeatureFlagsMonitor
@inject IStringLocalizer<App> L

@namespace Web.Blazor.Components.Authors


<div class="author-books-component">
    <SfSpinner Visible="@SpinnerVisible"
               Label="@SpinnerLabel"
               Type="@SpinnerType.Tailwind"
               CssClass="e-spin-overlay">
    </SfSpinner>

    @if (showAiProgress)
    {
        <div class="alert alert-info mt-2">
            <div class="bouncing-dots">
                <div class="progress-message">@aiProgressMessage</div>
                <span></span><span></span><span></span>
            </div>
        </div>
    }

    @if (string.IsNullOrWhiteSpace(AuthorName))
    {
        <div class="text-muted">@L["TituloNenhumAutorSelecionado"]</div>
    }
    else if (booksLoading)
    {
        <div class="text-muted">@L["LoadingMsg"]</div>
    }
    else
    {
        @* Do not short-circuit the UI when Google is rate-limited. We still want to show MessageLabel,
           Wikidata results, and the AI confirmation dialog. *@
        @if (googleRateLimited)
        {
            <div class="alert alert-warning">@L["TituloErroTooManyRequests"]</div>
        }

        @if (aiFallbackUsed && !string.IsNullOrWhiteSpace(aiProviderMessage))
        {
            <div class="alert alert-info mt-2 small">@aiProviderMessage</div>
        }

        var fn = CachedFilteredBooks.ToList();
        if (fn.Any())
        {
            <div>
                <p class="font-weight-bolder mt-2" style="font-size:18px;">@L["TituloListaLivros"]</p>
                <hr />
            </div>
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div>
                    <button class="btn btn-sm btn-outline-primary me-1" @onclick="PrevPage" disabled="@(currentPage <= 1 || booksLoading || TotalPages <= 1)">@L["TituloAnterior"]</button>
                    <button class="btn btn-sm btn-outline-primary" @onclick="NextPage" disabled="@(currentPage >= TotalPages || booksLoading || TotalPages <= 1)">@L["TituloSeguinte"]</button>
                </div>
                <div class="text-muted small">@L["lblPagina"] @currentPage / @TotalPages</div>
            </div>

            <MediaGrid TItem="GoogleBookInfo"
                       Items="PagedBooks"
                       Columns="PageSize"
                       ImageSelector="b => b.Thumbnail">

                <TitleTemplate Context="b">
                    <a class="media-title" href="@($"https://books.google.com/books?id={b.Id}")" target="_blank">
                        @b.Title
                    </a>
                </TitleTemplate>

                <MetaTemplate Context="b">
                    @b.PublishedDate
                </MetaTemplate>

            </MediaGrid>


            <div class="d-flex justify-content-end align-items-center mt-2">
                <div class="text-muted small">@L["lblPagina"] @currentPage / @TotalPages</div>
            </div>
        }
        else
        {
            @if (!string.IsNullOrEmpty(MessageLabel))
            {
                @* Option A: show a single user-facing message to avoid duplicated "rate limited" text *@
                <div class="text-muted">
                    <SfMessage Severity="MessageSeverity.Warning"
                               ShowCloseIcon="true"
                               CssClass="mt-2"
                               Visible="@MessageVisible">
                        @MessageLabel
                    </SfMessage>
                </div>
            }
        }
    }
</div>

<ImageViewer ImageUrl="@SelectedBook?.Thumbnail"
             Visible="@isImageViewerVisible"
             VisibleChanged="@(v => isImageViewerVisible = v)"
             Title="@SelectedBook.Title" />


<ConfirmAppWarning DialogTitle="@L["AuthorSearchDialogTitle"]"
                   Message=@(googleRateLimited ? @L["TituloErroTooManyRequests"] : @L["TituloNenhumResultadoGoogle"])
                   AlertMessageType="AlertMessageType.Warning" AlertMessageNote="@L["TituloPesquisaPorAI"]"
                   AlertMessage="@L["AuthorSearchDialogAlertMessage"]"
                   PositionX="center" PositionY="center"
                   Visible="@showAISearchDialog"
                   OnConfirmationYes="@OnConfirmYes"
                   OnConfirmationNo="@OnConfirmNo" />

<style>


    .book-card {
        overflow: hidden;
        height: 100%;
        display: flex;
        flex-direction: column;
        background: #fff;
    }

    .book-body {
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
    }

    .books-grid {
        display: grid;
        gap: 0.75rem;
        grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
        align-items: stretch;
        width: 100%;
        max-width: 100%;
    }


    @@media (max-width: 992px) {
        .books-grid {
            grid-template-columns: repeat(min(3, var(--cols)), 1fr);
        }
    }

    @@media (max-width: 768px) {
        .books-grid {
            grid-template-columns: repeat(min(2, var(--cols)), 1fr);
        }
    }

    @@media (max-width: 480px) {
        .books-grid {
            grid-template-columns: 1fr;
        }
    }

    .book-item { /* optional wrapper */
    }

    .img-box.portrait.book-thumb {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        aspect-ratio: 2 / 3;
        max-height: 240px;
        border: 2px solid #ccc;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0,0,0,0.08);
        overflow: hidden;
        background-color: #f9f9f9;
    }

        .img-box.portrait.book-thumb img {
            width: 100%;
            height: 100%;
            object-fit: fill;
            object-position: center;
            background-color: #f9f9f9;
            display: block;
        }

    .book-item {
        display: flex;
    }

    .book-card {
        display: flex;
        flex-direction: column;
        flex: 1 1 auto;
    }

    .book-title {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        word-break: break-word;
        line-height: 1.2;
        max-height: calc(1.2em * 2);
        min-height: calc(1.2em * 2);
    }

    .book-meta {
        margin-top: auto;
    }

    #spinner-container {
        position: relative;
        color: steelblue;
    }

    /* Bouncing dots – Copilot-style thinking indicator */
    .bouncing-dots {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        height: 24px;
    }

        .bouncing-dots span {
            display: inline-block;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: #0d6efd;
            animation: bounce-dot 1.2s ease-in-out infinite;
        }

            .bouncing-dots span:nth-child(2) {
                animation-delay: 0.2s;
            }

            .bouncing-dots span:nth-child(3) {
                animation-delay: 0.4s;
            }

    @@keyframes bounce-dot {
        0%, 80%, 100% {
            transform: translateY(0);
            opacity: 0.4;
        }

        40% {
            transform: translateY(-8px);
            opacity: 1;
        }
    }

    .progress-wrap {
        display: inline-flex;
        flex-direction: column;
        align-items: flex-start;
    }

    .progress-message {
        font-size: 0.85rem;
        color: #6c757d;
        margin-top: 0.25rem;
    }

    [data-theme="dark"] .book-card {
        background: var(--app-surface);
    }

    [data-theme="dark"] .img-box.portrait.book-thumb {
        border-color: var(--app-border);
        background-color: var(--app-surface-alt);
    }

    [data-theme="dark"] .img-box.portrait.book-thumb img {
        background-color: var(--app-surface-alt);
    }

    [data-theme="dark"] .bouncing-dots span {
        background-color: var(--app-primary);
    }

    [data-theme="dark"] .progress-message {
        color: var(--app-text-secondary);
    }

    [data-theme="dark"] #spinner-container {
        color: var(--app-primary);
    }

</style>
@using MediaOrganizerApp.Application
@using MediaOrganizerApp.Application.DTOs
@using MediaOrganizerApp.Application.Interfaces.Services.Api
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Options
@using Web.Blazor.Components.MediaGrids
@using Web.Blazor.Services.ApiWrappers

@inject IGoogleBooksService GoogleBooksService
@inject ILogger<AuthorBooks> Logger
@inject AiBookClientService AiBookClient
@inject IWikidataClientService WikidataClient
@inject IOptionsMonitor<FeatureFlags> FeatureFlagsMonitor
@inject IStringLocalizer<App> L

@namespace Web.Blazor.Components.Authors


<div class="author-books-component">
    <SfSpinner Visible="@SpinnerVisible"
               Label="@SpinnerLabel"
               Type="@SpinnerType.Tailwind"
               CssClass="e-spin-overlay">
    </SfSpinner>

    @if (showAiProgress)
    {
        <div class="alert alert-info mt-2">
            <div class="bouncing-dots">
                <div class="progress-message">@aiProgressMessage</div>
                <span></span><span></span><span></span>
            </div>
        </div>
    }

    @if (string.IsNullOrWhiteSpace(AuthorName))
    {
        <div class="text-muted">@L["TituloNenhumAutorSelecionado"]</div>
    }
    else if (booksLoading)
    {
        <div class="text-muted">@L["LoadingMsg"]</div>
    }
    else
    {
        @* Do not short-circuit the UI when Google is rate-limited. We still want to show MessageLabel,
           Wikidata results, and the AI confirmation dialog. *@
        @if (googleRateLimited)
        {
            <div class="alert alert-warning">@L["TituloErroTooManyRequests"]</div>
        }

        @if (aiFallbackUsed && !string.IsNullOrWhiteSpace(aiProviderMessage))
        {
            <div class="alert alert-info mt-2 small">@aiProviderMessage</div>
        }

        var fn = CachedFilteredBooks.ToList();
        if (fn.Any())
        {
            <div>
                @if (booksFromCache)
                {
                    <div class="text-muted small mb-1">@L["AuthorSearchCacheInfo"]</div>
                }
                else if (booksJustCached)
                {
                    <div class="text-muted small mb-1">@L["AuthorSearchFreshGoogleAndCached"]</div>
                }
                else if (booksFromWikidata)
                {
                    <div class="text-muted small mb-1">@L["AuthorSearchWikidataSource"]</div>
                }
                <p class="font-weight-bolder mt-2" style="font-size:18px;">@L["TituloListaLivros"]</p>
                <hr />
            </div>
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div>
                    <button class="btn btn-sm btn-outline-primary me-1" @onclick="PrevPage" disabled="@(currentPage <= 1 || booksLoading || TotalPages <= 1)">@L["TituloAnterior"]</button>
                    <button class="btn btn-sm btn-outline-primary" @onclick="NextPage" disabled="@(currentPage >= TotalPages || booksLoading || TotalPages <= 1)">@L["TituloSeguinte"]</button>
                </div>
                <div class="text-muted small">@L["lblPagina"] @currentPage / @TotalPages</div>
            </div>

            @if (aiFallbackUsed)
            {
                <div class="books-table-card">
                    <table class="books-table">
                        <thead>
                            <tr>
                                <th class="col-num">#</th>
                                <th>@L["AuthorBooksTitulo"]</th>
                                <th class="col-year">@L["AuthorBooksAno"]</th>
                                <th>@L["AuthorBooksEditora"]</th>
                                <th class="col-confidence">@L["AuthorBooksConfianca"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var pageItems = PagedBooks.ToList();
                                for (var idx = 0; idx < pageItems.Count; idx++)
                                {
                                    var b = pageItems[idx];
                                    var displayIndex = (currentPage - 1) * PageSize + idx + 1;
                                    <tr>
                                        <td class="col-num">@displayIndex</td>
                                        <td>
                                            <div class="table-title-cell">
                                                @if (HasUsableThumbnail(b))
                                                {
                                                    <img class="table-thumb" src="@b.Thumbnail" alt="@b.Title" loading="lazy"
                                                         @onclick="() => ShowImageViewer(b)" />
                                                }
                                                <span class="table-title">
                                                    @if (IsGoogleLinked(b.Id))
                                                    {
                                                        <a href="@($"https://books.google.com/books?id={b.Id}")" target="_blank">@b.Title</a>
                                                    }
                                                    else
                                                    {
                                                        <span>@b.Title</span>
                                                    }
                                                    @if (b.Synthesized == true)
                                                    {
                                                        <span class="ai-chip">@L["AuthorBooksSintetizado"]</span>
                                                    }
                                                </span>
                                                @if (!string.IsNullOrWhiteSpace(b.Subtitle))
                                                {
                                                    <span class="table-subtitle">@b.Subtitle</span>
                                                }
                                            </div>
                                        </td>
                                        <td class="col-year">@b.PublishedDate</td>
                                        <td class="table-publisher">@b.Publisher</td>
                                        <td class="col-confidence">
                                            @if (b.Confidence is null)
                                            {
                                                <span class="conf-missing">&ndash;</span>
                                            }
                                            else
                                            {
                                                <span class="conf-badge @ConfidenceCss(b.Confidence)">@ConfidenceText(b.Confidence)</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <MediaGrid TItem="GoogleBookInfo"
                           Items="PagedBooks"
                           Columns="PageSize"
                           ImageSelector="b => b.Thumbnail">

                    <TitleTemplate Context="b">
                        <a class="media-title" href="@($"https://books.google.com/books?id={b.Id}")" target="_blank">
                            @b.Title
                        </a>
                    </TitleTemplate>

                    <MetaTemplate Context="b">
                        @b.PublishedDate
                    </MetaTemplate>

                </MediaGrid>
            }


            <div class="d-flex justify-content-end align-items-center mt-2">
                <div class="text-muted small">@L["lblPagina"] @currentPage / @TotalPages</div>
            </div>
        }
        else
        {
            @if (!googleRateLimited &&
                (!string.IsNullOrEmpty(_googleOutcome) || !string.IsNullOrEmpty(_wikidataOutcome)))
            {
                @* Explicit per-provider outcome: what Google and Wikidata each returned *@
                <div class="mb-2 small">
                    @if (!string.IsNullOrEmpty(_googleOutcome))
                    {
                        <div class="text-warning">@_googleOutcome</div>
                    }
                    @if (!string.IsNullOrEmpty(_wikidataOutcome))
                    {
                        <div class="text-warning">@_wikidataOutcome</div>
                    }
                </div>
            }
            @if (!string.IsNullOrEmpty(MessageLabel))
            {
                @* Option A: show a single user-facing message to avoid duplicated "rate limited" text *@
                <div class="text-muted">
                    <SfMessage Severity="MessageSeverity.Warning"
                               ShowCloseIcon="true"
                               CssClass="mt-2"
                               Visible="@MessageVisible">
                        @MessageLabel
                    </SfMessage>
                </div>
            }
        }
    }
</div>

<ImageViewer ImageUrl="@SelectedBook?.Thumbnail"
             Visible="@isImageViewerVisible"
             VisibleChanged="@(v => isImageViewerVisible = v)"
             Title="@SelectedBook.Title" />


<ConfirmAppWarning DialogTitle="@L["AuthorSearchDialogTitle"]"
                   Message="@GetAISearchDialogMessage()"
                   AlertMessageType="AlertMessageType.Warning" AlertMessageNote="@L["TituloPesquisaPorAI"]"
                   AlertMessage="@L["AuthorSearchDialogAlertMessage"]"
                   PositionX="center" PositionY="center"
                   Visible="@showAISearchDialog"
                   OnConfirmationYes="@OnConfirmYes"
                   OnConfirmationNo="@OnConfirmNo" />

<ConfirmAppWarning DialogTitle="@L["AuthorSearchDialogTitle"]"
                   Message="@_cloudFailureReason"
                   AlertMessageType="AlertMessageType.Warning"
                   AlertMessageNote="@L["AuthorSearchOllamaNote"]"
                   AlertMessage="@L["AuthorSearchOllamaAlertMessage"]"
                   PositionX="center" PositionY="center"
                   Visible="@showOllamaConfirmDialog"
                   OnConfirmationYes="@OnOllamaConfirmYes"
                   OnConfirmationNo="@OnOllamaConfirmNo" />

<style>


    .book-card {
        overflow: hidden;
        height: 100%;
        display: flex;
        flex-direction: column;
        background: #fff;
    }

    /* Modern results table for AI-sourced books (no cover images) */
    .books-table-card {
        background: var(--app-surface);
        border: 1px solid var(--app-border);
        border-radius: 12px;
        box-shadow: var(--app-shadow);
        overflow-x: auto;
        margin-bottom: 0.5rem;
    }

    .books-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
        min-width: 480px;
    }

    .books-table thead th {
        background: var(--app-surface-alt);
        color: var(--app-text-secondary);
        text-transform: uppercase;
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        font-weight: 600;
        padding: 0.75rem 1rem;
        border-bottom: 1px solid var(--app-border);
        white-space: nowrap;
        text-align: left;
    }

    .books-table tbody td {
        padding: 0.65rem 1rem;
        border-bottom: 1px solid var(--app-border);
        color: var(--app-text-primary);
        vertical-align: middle;
    }

    .books-table tbody tr {
        transition: background-color 0.15s ease;
    }

    .books-table tbody tr:hover {
        background-color: var(--app-surface-hover);
    }

    .books-table tbody tr:last-child td {
        border-bottom: none;
    }

    .books-table .col-num {
        width: 44px;
        text-align: right;
        color: var(--app-text-secondary);
    }

    .books-table .col-year {
        width: 90px;
        white-space: nowrap;
        color: var(--app-text-secondary);
    }

    .books-table .col-confidence {
        width: 110px;
    }

    .books-table .table-publisher {
        color: var(--app-text-secondary);
    }

    .table-title-cell {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

    .table-title {
        display: inline-flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.35rem;
        font-weight: 600;
        color: var(--app-text-primary);
        line-height: 1.3;
    }

    .table-title a {
        color: var(--app-primary);
        text-decoration: none;
    }

    .table-title a:hover {
        color: var(--app-primary-hover);
        text-decoration: underline;
    }

    .table-subtitle {
        display: block;
        margin-top: 0.1rem;
        font-size: 0.78rem;
        color: var(--app-text-secondary);
        font-weight: 400;
    }

    .table-thumb {
        width: 30px;
        height: 44px;
        object-fit: cover;
        border-radius: 4px;
        border: 1px solid var(--app-border);
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.12);
        cursor: pointer;
        float: left;
        margin-right: 0.65rem;
        margin-bottom: 0.25rem;
        flex-shrink: 0;
    }

    .ai-chip {
        display: inline-flex;
        align-items: center;
        padding: 0.1rem 0.5rem;
        border-radius: 999px;
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.03em;
        border: 1px solid var(--app-info-border);
        background-color: var(--app-info-bg);
        color: var(--app-info-text);
        vertical-align: middle;
        white-space: nowrap;
    }

    .conf-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 48px;
        padding: 0.2rem 0.55rem;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .conf-badge.good {
        background-color: var(--app-success-bg);
        color: var(--app-success-text);
    }

    .conf-badge.mid {
        background-color: var(--app-warning-bg);
        color: var(--app-warning-text);
    }

    .conf-badge.low {
        background-color: var(--app-danger-bg);
        color: var(--app-danger-text);
    }

    .conf-missing {
        color: var(--app-text-secondary);
        font-size: 0.9rem;
    }

    .book-body {
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
    }

    .books-grid {
        display: grid;
        gap: 0.75rem;
        grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
        align-items: stretch;
        width: 100%;
        max-width: 100%;
    }


    @@media (max-width: 992px) {
        .books-grid {
            grid-template-columns: repeat(min(3, var(--cols)), 1fr);
        }
    }

    @@media (max-width: 768px) {
        .books-grid {
            grid-template-columns: repeat(min(2, var(--cols)), 1fr);
        }
    }

    @@media (max-width: 480px) {
        .books-grid {
            grid-template-columns: 1fr;
        }
    }

    .book-item { /* optional wrapper */
    }

    .img-box.portrait.book-thumb {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        aspect-ratio: 2 / 3;
        max-height: 240px;
        border: 2px solid #ccc;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0,0,0,0.08);
        overflow: hidden;
        background-color: #f9f9f9;
    }

        .img-box.portrait.book-thumb img {
            width: 100%;
            height: 100%;
            object-fit: fill;
            object-position: center;
            background-color: #f9f9f9;
            display: block;
        }

    .book-item {
        display: flex;
    }

    .book-card {
        display: flex;
        flex-direction: column;
        flex: 1 1 auto;
    }

    .book-title {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        word-break: break-word;
        line-height: 1.2;
        max-height: calc(1.2em * 2);
        min-height: calc(1.2em * 2);
    }

    .book-meta {
        margin-top: auto;
    }

    #spinner-container {
        position: relative;
        color: steelblue;
    }

    /* Bouncing dots – thinking indicator */
    .bouncing-dots {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        height: 24px;
    }

        .bouncing-dots span {
            display: inline-block;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background-color: #0d6efd;
            animation: bounce-dot 1.2s ease-in-out infinite;
        }

            .bouncing-dots span:nth-child(2) {
                animation-delay: 0.2s;
            }

            .bouncing-dots span:nth-child(3) {
                animation-delay: 0.4s;
            }

    @@keyframes bounce-dot {
        0%, 80%, 100% {
            transform: translateY(0);
            opacity: 0.4;
        }

        40% {
            transform: translateY(-8px);
            opacity: 1;
        }
    }

    .progress-wrap {
        display: inline-flex;
        flex-direction: column;
        align-items: flex-start;
    }

    .progress-message {
        font-size: 0.85rem;
        color: #6c757d;
        margin-top: 0.25rem;
    }

    [data-theme="dark"] .book-card {
        background: var(--app-surface);
    }

    [data-theme="dark"] .img-box.portrait.book-thumb {
        border-color: var(--app-border);
        background-color: var(--app-surface-alt);
    }

    [data-theme="dark"] .img-box.portrait.book-thumb img {
        background-color: var(--app-surface-alt);
    }

    [data-theme="dark"] .bouncing-dots span {
        background-color: var(--app-primary);
    }

    [data-theme="dark"] .progress-message {
        color: var(--app-text-secondary);
    }

    [data-theme="dark"] #spinner-container {
        color: var(--app-primary);
    }

</style>
        max-width: 85%;
        object-fit: cover;
        box-shadow: inset;
    }

    div > nav a {
        font-size: larger;
        font-weight: bolder;
        display: block;
    }

        div > nav a:hover {
            font-weight: normal;
            background-color: transparent;

<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet para builds dentro do Docker.
  O nuget.config da raiz aponta para o feed privado da Syncfusion com uma API key
  placeholder (<your-api-key>), que não existe no contexto do contentor.
  Os pacotes Syncfusion estão publicados em nuget.org, por isso o build usa só essa fonte.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>

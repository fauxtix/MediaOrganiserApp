# ──────────────────────────────────────────────────────────────────
# Dockerfile for Media Organizer Blazor Server (Linux)
# Build context = raiz do repo (ver docker-compose.yml).
# Corre como Kestrel diretamente (sem IIS / hostingModel inprocess).
# ──────────────────────────────────────────────────────────────────

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS base
WORKDIR /app

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet restore Web.Blazor/Web.Blazor.csproj --configfile docker/nuget.config
RUN dotnet publish Web.Blazor/Web.Blazor.csproj \
    -c Release \
    -o /app/build \
    --no-restore

FROM base AS final
WORKDIR /app
COPY --from=build /app/build /app

ENV ASPNETCORE_ENVIRONMENT=Production
ENV ASPNETCORE_URLS=http://0.0.0.0:5001

# wwwroot/Files é montado do host em runtime (assets + uploads).
# Não copiar 1,3 GB de dados para a imagem — ver .dockerignore.

EXPOSE 5001
ENTRYPOINT ["dotnet", "Web.Blazor.dll"]

# ──────────────────────────────────────────────────────────────────
# Dockerfile for Media Organizer WebApi (Linux)
# Build context = raiz do repo (ver docker-compose.yml).
# Não substitui o deploy IIS (.github/workflows/main.yml mantém-se).
# ──────────────────────────────────────────────────────────────────

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS base
WORKDIR /app

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
# O nuget.config da raiz tem o feed Syncfusion com uma API key placeholder;
# dentro do contentor restauramos só de nuget.org (pacotes Syncfusion públicos).
RUN dotnet restore MediaOrganizerApp.WebApi/MediaOrganizerApp.WebApi.csproj --configfile docker/nuget.config
RUN dotnet publish MediaOrganizerApp.WebApi/MediaOrganizerApp.WebApi.csproj \
    -c Release \
    -o /app/build \
    --no-restore

FROM base AS final
WORKDIR /app
COPY --from=build /app/build /app

# Environment/connection string são passados em runtime — ver docker-compose.yml
ENV ASPNETCORE_ENVIRONMENT=Production
ENV ASPNETCORE_URLS=http://0.0.0.0:5000

LABEL org.opencontainers.image.title="Media Organizer - WebApi" \
      org.opencontainers.image.description="REST API: publicacoes, media, autores, IA (Ollama/OpenRouter) e relatorios RDLC." \
      org.opencontainers.image.source="https://github.com/fauxtix/MediaOrganiserApp" \
      org.opencontainers.image.documentation="https://github.com/fauxtix/MediaOrganiserApp/blob/master/AGENTS.md#docker-local-opcional-linux-containers"

EXPOSE 5000
ENTRYPOINT ["dotnet", "MediaOrganizerApp.WebApi.dll"]

{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch WebApi",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-webapi",
      "program": "${workspaceFolder}/MediaOrganizerApp.WebApi/bin/Debug/net10.0/MediaOrganizerApp.WebApi.dll",
      "args": [],
      "cwd": "${workspaceFolder}/MediaOrganizerApp.WebApi",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    },
    {
      "name": "Launch Blazor",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-blazor",
      "program": "${workspaceFolder}/../BlazorOrganizer/MyOrganizer/Web.Blazor/bin/Debug/net10.0/Web.Blazor.dll",
      "args": [],
      "cwd": "${workspaceFolder}/../BlazorOrganizer/MyOrganizer/Web.Blazor",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    }
  ],
  "compounds": [
    {
      "name": "WebApi + Blazor",
      "configurations": ["Launch WebApi", "Launch Blazor"],
      "stopAll": true
    }
  ]
}

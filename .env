# Variaveis de ambiente da stack Docker local (ver docker-compose.yml).
# Importante: SQL_SA_PASSWORD NAO deve terminar em ';' — esse ';' e o
# separador da connection string e faria o login falhar.

SQL_SA_PASSWORD=YourStrong!Passw0rd

# Ficheiro .bak a restaurar por db-init (em Web.Blazor/wwwroot/Files/Backup/Database).
# SQL_BACKUP_FILE=28102026_123256.Bak

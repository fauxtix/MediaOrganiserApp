<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org"
         value="https://api.nuget.org/v3/index.json"
         protocolVersion="3" />
    <add key="Syncfusion"
         value="https://nuget.syncfusion.com/<your-api-key>/nuget" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="Syncfusion">
      <package pattern="Syncfusion.*" />
    </packageSource>

    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
